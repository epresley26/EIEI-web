---
import Layout from '../layouts/Layout.astro';
import TestimonialSection from '../components/TestimonialSection.astro';
import GallerySection from '../components/GallerySection.astro';
---

<Layout title="Supporting Inclusions & Partnerships - EIEI">
  <style is:global>
    /* PREMIUM MODERN STYLES */
    .service-hero {
      position: relative;
      width: 100%;
      min-height: 45vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 10rem 2rem 5rem;
      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
      color: white;
      text-align: center;
      overflow: hidden;
    }

    .service-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      opacity: 0.5;
      z-index: 1;
    }

    .service-hero-content {
      position: relative;
      z-index: 2;
      max-width: 800px;
      margin: 0 auto;
    }

    .service-hero h1 {
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      font-weight: 900;
      line-height: 1.1;
      margin-bottom: 1.5rem;
      letter-spacing: -1px;
    }

    .service-hero p {
      font-size: 1.25rem;
      font-weight: 400;
      opacity: 0.9;
      line-height: 1.6;
    }

    .main-content {
      background: #f8fafc;
      padding: 5rem 2rem;
      min-height: 50vh;
    }

    /* GALLERY SECTION */
    .gallery-section {
      padding: 80px 0;
      margin-top: 4rem;
    }
    
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
      margin-top: 3rem;
    }
    
    .gallery :global(.gallery-item) {
      border-radius: 20px;
      overflow: hidden;
      height: 250px;
      cursor: pointer;
      box-shadow: 0 15px 35px rgba(0,0,0,0.05);
      transition: all 0.4s ease;
    }
    
    .gallery :global(.gallery-item:hover) {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }
    
    .gallery :global(.gallery-item img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .badge {
      display: inline-block;
      padding: 0.5rem 1.2rem;
      background: #eff6ff;
      color: #2563eb;
      border-radius: 50px;
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 1rem;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .breadcrumb {
      margin-bottom: 3rem;
      font-size: 0.95rem;
      color: #64748b;
      font-weight: 500;
    }

    .breadcrumb a {
      color: #2563eb;
      text-decoration: none;
      transition: color 0.3s;
    }

    .breadcrumb a:hover {
      color: #f97316;
    }

    .section-header {
      text-align: center;
      margin-bottom: 4rem;
      margin-top: 4rem;
    }

    .section-header h2 {
      font-size: 2.5rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 1rem;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 2rem;
      margin-bottom: 5rem;
    }

    .service-box {
      background: white;
      border-radius: 16px;
      padding: 2.5rem 2rem;
      box-shadow: 0 4px 20px rgba(0,0,0,0.03);
      border: 1px solid #e2e8f0;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .service-box::before {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 4px; height: 100%;
      background: #f97316;
      transform: scaleY(0);
      transition: transform 0.3s ease;
      transform-origin: bottom;
    }

    .service-box:hover {
      box-shadow: 0 15px 30px rgba(0,0,0,0.08);
      transform: translateY(-5px);
    }

    .service-box:hover::before {
      transform: scaleY(1);
    }

    .icon-wrapper {
      width: 50px; height: 50px;
      background: #eff6ff;
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
      color: #2563eb;
    }

    .service-box h4 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 1rem;
    }

    .service-box p {
      color: #64748b;
      line-height: 1.6;
      font-size: 0.95rem;
    }
    
    .dual-pane {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
      background: white;
      border-radius: 20px;
      padding: 4rem;
      box-shadow: 0 10px 40px rgba(0,0,0,0.05);
      margin: 5rem 0;
    }

    .dual-pane h3 {
      font-size: 2rem;
      color: #0f172a;
      margin-bottom: 1.5rem;
      font-weight: 800;
    }

    .dual-pane p {
      color: #475569;
      line-height: 1.8;
      margin-bottom: 1.5rem;
      font-size: 1.1rem;
    }

    .dual-pane ul {
      list-style: none;
      padding: 0;
      margin: 2rem 0;
    }

    .dual-pane li {
      margin-bottom: 1rem;
      padding-left: 2rem;
      position: relative;
      color: #1e293b;
      font-weight: 500;
    }

    .dual-pane li::before {
      content: '✓';
      position: absolute;
      left: 0;
      color: #f97316;
      font-weight: 900;
    }

    .photo-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin: 4rem 0;
    }

    .photo-grid img {
      width: 100%;
      height: 250px;
      object-fit: cover;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      transition: transform 0.3s ease;
    }

    .photo-grid img:hover {
      transform: scale(1.05);
    }

    .cta-banner {
      background: linear-gradient(135deg, #2563eb 0%, #1e3a8a 100%);
      border-radius: 20px;
      padding: 4rem;
      text-align: center;
      color: white;
      margin-top: 5rem;
    }

    .cta-banner h2 {
      font-size: 2.5rem;
      font-weight: 800;
      margin-bottom: 1rem;
    }

    .cta-button {
      display: inline-block;
      background: #f97316;
      color: white;
      padding: 1.2rem 3rem;
      border-radius: 50px;
      font-size: 1.1rem;
      font-weight: 800;
      text-decoration: none;
      margin-top: 2rem;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .cta-button:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(249, 115, 22, 0.3);
      background: #ea580c;
    }

    @media (max-width: 900px) {
      .dual-pane { grid-template-columns: 1fr; padding: 2rem; gap: 2rem; }
      .photo-grid { grid-template-columns: 1fr; }
      .service-hero { padding-top: 8rem; min-height: 40vh; }
      .cta-banner { padding: 3rem 1.5rem; }
    }
  </style>

  <section class="service-hero">
    <div class="service-hero-content">
      <h1>Supporting Inclusions Through Affiliates</h1>
      <p>Building vast, collaborative partnership networks to aggressively advance inclusive special education and dynamically support children.</p>
    </div>
  </section>

  <main class="main-content">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a> / <a href="/services">Services</a> / Supporting Inclusions
      </div>

      <div class="dual-pane">
        <div>
          <h3>Our Partnership Philosophy</h3>
          <p>We actively join hands with non-profit and for-profit partners, strictly aligning our efforts to profoundly support their mission through essential resources, empowering administrative education, and deep collaborative systemic efforts.</p>
          <p>EIEI firmly believes in the sheer power of collaboration to orchestrate widespread systemic change across communities. Through strategic lateral partnerships with organizations that share our relentless commitment to classroom inclusion, we significantly amplify our operational impact and seamlessly reach far more families collectively than individually.</p>
        </div>
        <div style="background: #f8fafc; border-radius: 20px; padding: 3rem; border: 1px solid #e2e8f0;">
          <h4 style="color: #2563eb; font-size: 1.3rem; margin-bottom: 1.5rem; font-weight: 800;">Target Alliance Categories</h4>
          <ul style="margin: 0;">
            <li>ECE and pre-K centers</li>
            <li>Non-profit social service systems</li>
            <li>Local School districts networks</li>
            <li>Community health & wellness entities</li>
            <li>Family support & legal advocates</li>
            <li>Government child agencies</li>
          </ul>
        </div>
      </div>

      <div class="section-header">
        <h2>How We Support Our Partners</h2>
        <p style="color: #64748b; font-size: 1.1rem; max-width: 600px; margin: 0 auto;">Establishing fortified community integrations.</p>
      </div>

      <div class="services-grid">
        <div class="service-box">
          <div class="icon-wrapper">🤝</div>
          <h4>Strategic Development</h4>
          <p>We work intimately together to identify structurally shared goals, engineering meaningful programmatic inclusion initiatives that scale effortlessly.</p>
        </div>
        <div class="service-box">
          <div class="icon-wrapper">💰</div>
          <h4>Financial Resource Grants</h4>
          <p>Providing direct backdoor access to high-tier state funding opportunities and cash resources to immediately support partner program sustainability.</p>
        </div>
        <div class="service-box">
          <div class="icon-wrapper">🎓</div>
          <h4>Capacity Building Training</h4>
          <p>Executing on-site professional classroom development for your staff directly, strengthening inclusive special education practices rapidly.</p>
        </div>
        <div class="service-box">
          <div class="icon-wrapper">📊</div>
          <h4>Program Evaluation Data</h4>
          <p>Rigorous, data-driven systemic assessment charting, identifying key guidance metrics for continuous program execution and quality enhancement.</p>
        </div>
        <div class="service-box">
          <div class="icon-wrapper">🌍</div>
          <h4>Collaborative Execution</h4>
          <p>Launching massive joint-venture initiatives and projects that holistically strengthen the entire geographical early childhood ecosystem simultaneously.</p>
        </div>
        <div class="service-box">
          <div class="icon-wrapper">⚖️</div>
          <h4>State Advocacy Force</h4>
          <p>Partnering with our organizational weight to jointly demand critical legislative inclusive policies, protecting vulnerable families regionally.</p>
        </div>
      </div>

      <div class="dual-pane" style="background: #fff7ed; border: none;">
        <div>
          <h3 style="color: #ea580c;">ECE Rapid Response Program</h3>
          <p style="color: #78350f;">Our legendary Rapid Response mechanism is structured to provide incredibly swift and surgically effective intervention support to classrooms in Delaware County, PA.</p>
          <p style="color: #78350f;">Triggered instantaneously to prevent the behavioral expulsion of at-risk youths from early childhood settings, we guarantee a comprehensive action response exactly within 48 hours to secure stability parameters.</p>
          <ul>
            <li>Immediate 48-Hour Assessment Time</li>
            <li>Dedicated Behavioral Crisis Team deployment</li>
            <li>Cognitive, Language, & Physiological stabilization</li>
            <li>Comprehensive Home/School Action Contracts</li>
          </ul>
        </div>
        <div style="display: flex; gap: 1rem; flex-direction: column;">
          <img src="https://i0.wp.com/eieiservices.com/wp-content/uploads/2024/04/EIEI-X-Rapid-Response-Flyers.png?resize=1080%2C1528&ssl=1" alt="Rapid Response Intervention Flyer" style="border-radius: 12px; width: 100%; border: 1px solid #fdba74;" />
        </div>
      </div>

      <div class="cta-banner">
        <h2>Activate Affiliate Status</h2>
        <p style="font-size: 1.2rem; opacity: 0.9; max-width: 650px; margin: 0 auto;">Join the vast network of elite facilities, districts, and non-profits allied with EIEI. Let us multiply our power structure together.</p>
        <a href="/contact-us" class="cta-button">Initiate Partnership</a>
      </div>

      <GallerySection />

      <TestimonialSection program="supporting-inclusions" />
    </div>
  </main>
</Layout>
