---
import Layout from '../layouts/Layout.astro';
import TestimonialSection from '../components/TestimonialSection.astro';
import GallerySection from '../components/GallerySection.astro';
---

<Layout title="Family Empowerment - EIEI">
  <style is:global>
    /* PREMIUM MODERN STYLES */
    .service-hero {
      position: relative;
      width: 100%;
      min-height: 45vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 10rem 2rem 5rem;
      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
      color: white;
      text-align: center;
      overflow: hidden;
    }

    .service-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      opacity: 0.5;
      z-index: 1;
    }

    .service-hero-content {
      position: relative;
      z-index: 2;
      max-width: 800px;
      margin: 0 auto;
    }

    .service-hero h1 {
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      font-weight: 900;
      line-height: 1.1;
      margin-bottom: 1.5rem;
      letter-spacing: -1px;
    }

    .service-hero p {
      font-size: 1.25rem;
      font-weight: 400;
      opacity: 0.9;
      line-height: 1.6;
    }

    .main-content {
      background: #f8fafc;
      padding: 5rem 2rem;
      min-height: 50vh;
    }

    /* GALLERY SECTION */
    .gallery-section {
      padding: 80px 0;
      margin-top: 4rem;
    }
    
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
      margin-top: 3rem;
    }
    
    .gallery :global(.gallery-item) {
      border-radius: 20px;
      overflow: hidden;
      height: 250px;
      cursor: pointer;
      box-shadow: 0 15px 35px rgba(0,0,0,0.05);
      transition: all 0.4s ease;
    }
    
    .gallery :global(.gallery-item:hover) {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }
    
    .gallery :global(.gallery-item img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .badge {
      display: inline-block;
      padding: 0.5rem 1.2rem;
      background: #eff6ff;
      color: #2563eb;
      border-radius: 50px;
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 1rem;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .breadcrumb {
      margin-bottom: 3rem;
      font-size: 0.95rem;
      color: #64748b;
      font-weight: 500;
    }

    .breadcrumb a {
      color: #2563eb;
      text-decoration: none;
      transition: color 0.3s;
    }

    .breadcrumb a:hover {
      color: #f97316;
    }

    .dual-pane {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
      margin-bottom: 5rem;
    }

    .dual-pane h3 {
      font-size: 2rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 1.5rem;
      line-height: 1.2;
    }

    .dual-pane p {
      font-size: 1.1rem;
      color: #475569;
      line-height: 1.8;
      margin-bottom: 1.5rem;
    }

    .section-header {
      text-align: center;
      margin-bottom: 4rem;
      margin-top: 4rem;
    }

    .section-header h2 {
      font-size: 2.5rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 1rem;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 2rem;
      margin-bottom: 5rem;
    }

    .service-box {
      background: white;
      border-radius: 16px;
      padding: 2.5rem 2rem;
      box-shadow: 0 4px 20px rgba(0,0,0,0.03);
      border: 1px solid #e2e8f0;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .service-box::before {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 4px; height: 100%;
      background: #f97316;
      transform: scaleY(0);
      transition: transform 0.3s ease;
      transform-origin: bottom;
    }

    .service-box:hover {
      box-shadow: 0 15px 30px rgba(0,0,0,0.08);
      transform: translateY(-5px);
    }

    .service-box:hover::before {
      transform: scaleY(1);
    }

    .icon-wrapper {
      width: 50px; height: 50px;
      background: #eff6ff;
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
      color: #2563eb;
    }

    .service-box h4 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 1rem;
    }

    .service-box p {
      color: #64748b;
      line-height: 1.6;
      font-size: 0.95rem;
    }

    /* Accordion Styles */
    .resource-vault {
      max-width: 900px;
      margin: 0 auto;
      background: white;
      border-radius: 20px;
      padding: 3rem;
      box-shadow: 0 10px 40px rgba(0,0,0,0.05);
      border: 1px solid #e2e8f0;
    }

    .accordion-item {
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      margin-bottom: 1rem;
      overflow: hidden;
    }

    .accordion-item:last-child {
      margin-bottom: 0;
    }

    .accordion-header {
      width: 100%;
      text-align: left;
      background: #f8fafc;
      border: none;
      padding: 1.5rem 2rem;
      font-size: 1.1rem;
      font-weight: 700;
      color: #1e293b;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: background 0.3s ease;
    }

    .accordion-header:hover {
      background: #eff6ff;
    }

    .accordion-icon {
      color: #f97316;
      font-size: 1.5rem;
      font-weight: 400;
      transition: transform 0.3s ease;
    }

    .accordion-content {
      padding: 0 2rem;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s ease, padding 0.4s ease;
      background: white;
    }

    .accordion-content p {
      color: #475569;
      line-height: 1.8;
      margin: 1rem 0;
    }

    .accordion-content a {
      display: inline-block;
      color: #2563eb;
      font-weight: 600;
      text-decoration: none;
      margin-top: 0.5rem;
    }

    .accordion-content a:hover {
      color: #f97316;
      text-decoration: underline;
    }

    .accordion-item.active .accordion-content {
      max-height: 500px;
      padding: 1rem 2rem 2rem;
    }

    .accordion-item.active .accordion-header {
      background: #eff6ff;
      border-bottom: 1px solid #e2e8f0;
    }

    .accordion-item.active .accordion-icon {
      transform: rotate(45deg);
    }

    .cta-banner {
      background: linear-gradient(135deg, #2563eb 0%, #1e3a8a 100%);
      border-radius: 20px;
      padding: 4rem;
      text-align: center;
      color: white;
      margin-top: 5rem;
    }

    .cta-banner h2 {
      font-size: 2.5rem;
      font-weight: 800;
      margin-bottom: 1rem;
    }

    .cta-button {
      display: inline-block;
      background: #f97316;
      color: white;
      padding: 1.2rem 3rem;
      border-radius: 50px;
      font-size: 1.1rem;
      font-weight: 800;
      text-decoration: none;
      margin-top: 2rem;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .cta-button:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(249, 115, 22, 0.3);
      background: #ea580c;
    }

    @media (max-width: 900px) {
      .dual-pane { grid-template-columns: 1fr; }
      .service-hero { padding-top: 8rem; min-height: 40vh; }
      .cta-banner { padding: 3rem 1.5rem; }
      .resource-vault { padding: 1.5rem; }
    }
  </style>

  <section class="service-hero">
    <div class="service-hero-content">
      <h1>Family Empowerment</h1>
      <p>Transforming parents and caregivers into informed advocates navigating special education policies fluidly.</p>
    </div>
  </section>

  <main class="main-content">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a> / <a href="/services">Services</a> / Family Empowerment
      </div>

      <div class="dual-pane">
        <div>
          <h3>Parent Power Protocol</h3>
          <p>Families are utterly, undeniably essential partners navigating educational journeys. EIEI rigorously strengthens the entire support system enveloping the child, fostering indestructible trust and relentless cooperation amongst every single stakeholder.</p>
          <p>By heavily humanizing our approach towards special education methodology, we shape futures dynamically where neurodivergent students thrive completely. We empower parents mathematically, drastically increasing your organizational visibility, impact range, and legal voice to guarantee beneficial interventions manifest instantly within massive school districts.</p>
        </div>
        <div style="background: url('/images/early.jpg') center/cover; border-radius: 20px; min-height: 400px; box-shadow: 0 20px 40px rgba(0,0,0,0.1);"></div>
      </div>

      <div class="section-header">
        <h2>What EIEI Deploys For You</h2>
        <p style="color: #64748b; font-size: 1.1rem; max-width: 600px; margin: 0 auto;">Exclusive strategic integrations elevating parents permanently.</p>
      </div>

      <div class="services-grid">
        <div class="service-box">
          <div class="icon-wrapper">💻</div>
          <h4>Virtual Support Squadrons</h4>
          <p>Instantly connect across digital channels with allied families holding shared specific experiences within highly secure, safely moderated command environments.</p>
        </div>
        <div class="service-box">
          <div class="icon-wrapper">🎓</div>
          <h4>Parenting Masterclasses</h4>
          <p>Intense, expert-led tactical interventions covering sophisticated behavioral management, rapid de-escalation psychology, and strict legal advocacy.</p>
        </div>
        <div class="service-box">
          <div class="icon-wrapper">⚖️</div>
          <h4>Special Ed Navigation Data</h4>
          <p>Learn EXACTLY how to bulldoze through complex IEP barriers effortlessly, legally cornering required services, and locking in federal protections flawlessly.</p>
        </div>
        <div class="service-box">
          <div class="icon-wrapper">🧘</div>
          <h4>Systematic Self-Care Maintenance</h4>
          <p>Structured psychological guidance systems focused solely on parental nervous system management, actively halting debilitating stress degradation.</p>
        </div>
        <div class="service-box">
          <div class="icon-wrapper">📚</div>
          <h4>The Central Resource Library</h4>
          <p>Full VIP authentication inside our violently curated backend vaults displaying exhaustive tools, legal paperwork templates, and psychological guidelines.</p>
        </div>
        <div class="service-box">
          <div class="icon-wrapper">🦸</div>
          <h4>Direct Expert Interface</h4>
          <p>Immediate communication relays linking you directly to senior educational diagnosticians, developmental psychologists, and aggressive legal advocates.</p>
        </div>
      </div>

      <div class="section-header" style="margin-top: 8rem;">
        <h2>The Central Resource Vault</h2>
        <p style="color: #64748b; font-size: 1.1rem; max-width: 600px; margin: 0 auto;">Declassify critical statewide programs right now.</p>
      </div>

      <div class="resource-vault">
        <div class="accordion-item">
          <button class="accordion-header">
            <span>SWIFT Preschool Support System (KenCrest)</span>
            <span class="accordion-icon">+</span>
          </button>
          <div class="accordion-content">
            <p>A spectacularly innovative structural intervention halting catastrophic preschool expulsions instantly by stabilizing hyper-challenging behaviors seamlessly inside inclusive classrooms.</p>
            <a href="https://www.kencrest.org/community-support-programs/early-intervention/swift-support-services/" target="_blank">Access SWIFT Network &rarr;</a>
          </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-header">
            <span>Social Security Disability Insurance (SSDI) Diagnostics</span>
            <span class="accordion-icon">+</span>
          </button>
          <div class="accordion-content">
            <p>Guaranteed empowerment crushing through SSDI red-tape bureaucracy effortlessly. Deploy free case evaluations slicing through broken systems, securing massive family support infrastructures immediately.</p>
          </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-header">
            <span>As You Are – Virtual Autism Evaluations</span>
            <span class="accordion-icon">+</span>
          </button>
          <div class="accordion-content">
            <p>Deploy lightning-fast virtual clinical physicians delivering absolute autism diagnostic evaluations within weeks—bypassing endless hospital waitlists instantly. No referrals needed.</p>
          </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-header">
            <span>McAndrews Legal Defenders Network</span>
            <span class="accordion-icon">+</span>
          </button>
          <div class="accordion-content">
            <p>The ultimate shield in Pennsylvania providing ruthless legal representation destroying IDEA violations, securing massive IEP compliance, and deploying bulletproof estate trusts shielding special-needs heirs eternally.</p>
          </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-header">
            <span>PA Interagency Coordinating Council (SICC)</span>
            <span class="accordion-icon">+</span>
          </button>
          <div class="accordion-content">
            <p>The deepest structural intelligence advising state departments to fiercely coordinate Early Intervention pipelines accurately for toddlers universally.</p>
            <a href="https://www.eita-pa.org" target="_blank">Connect to SICC Portal &rarr;</a>
          </div>
        </div>

        <div class="accordion-item">
          <button class="accordion-header">
            <span>The PaTTAN Technical Assistance Array</span>
            <span class="accordion-icon">+</span>
          </button>
          <div class="accordion-content">
            <p>Pennsylvania's massive, sprawling technical grid supporting intense educational modifications drastically elevating success outcomes for marginalized neurodivergent youth universally.</p>
          </div>
        </div>
      </div>

      <div class="cta-banner">
        <h2>Join The Vanguard Today</h2>
        <p style="font-size: 1.2rem; opacity: 0.9; max-width: 650px; margin: 0 auto;">Stop battling educational compliance independently. Merge with our deeply integrated network and secure your family's outcomes universally.</p>
        <a href="/contact-us" class="cta-button">Engage Protocol</a>
      </div>

      <GallerySection program="family-empowerment" />

      <TestimonialSection program="family-empowerment" />

    </div>
  </main>

  <script is:inline>
    // Smooth Accordion Interactivity Script 
    document.addEventListener('DOMContentLoaded', () => {
      const accordionItems = document.querySelectorAll('.accordion-item');
      
      accordionItems.forEach(item => {
        const header = item.querySelector('.accordion-header');
        
        header.addEventListener('click', () => {
          const isActive = item.classList.contains('active');
          
          accordionItems.forEach(i => i.classList.remove('active'));
          
          if (!isActive) {
            item.classList.add('active');
          }
        });
      });
    });
  </script>
</Layout>
