---
import Layout from "../layouts/Layout.astro";
import TestimonialSection from "../components/TestimonialSection.astro";
import GallerySection from "../components/GallerySection.astro";
---

<style>
  /* PREMIUM MODERN STYLES */
  .service-hero {
    position: relative;
    width: 100%;
    min-height: 45vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 10rem 2rem 5rem;
    background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
    color: white !important;
    text-align: center;
    overflow: hidden;
  }

  .service-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    opacity: 0.5;
    z-index: 1;
  }

  .service-hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
    margin: 0 auto;
  }

  .service-hero h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -1px;
    color: white !important;
  }

  .service-hero p {
    font-size: 1.25rem;
    font-weight: 400;
    opacity: 0.9;
    line-height: 1.6;
    color: white !important;
  }

  .main-content {
    background: #f8fafc;
    padding: 5rem 2rem;
    min-height: 50vh;
  }

  /* GALLERY SECTION */
  .gallery-section {
    padding: 80px 0;
    margin-top: 4rem;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .gallery :global(.gallery-item) {
    border-radius: 20px;
    overflow: hidden;
    height: 250px;
    cursor: pointer;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
    transition: all 0.4s ease;
  }

  .gallery :global(.gallery-item:hover) {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }

  .gallery :global(.gallery-item img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    background: #eff6ff;
    color: #2563eb;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .breadcrumb {
    margin-bottom: 3rem;
    font-size: 0.95rem;
    color: #64748b;
    font-weight: 500;
  }

  .breadcrumb a {
    color: #2563eb;
    text-decoration: none;
    transition: color 0.3s;
  }

  .breadcrumb a:hover {
    color: #f97316;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
    margin-bottom: 5rem;
  }

  .intro-text h2 {
    font-size: 2.5rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  .intro-text p {
    font-size: 1.1rem;
    color: #475569;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .intro-highlights {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .highlight-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: white;
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
  }

  .highlight-item h4 {
    color: #0f172a;
    font-weight: 700;
    font-size: 1.1rem;
    margin: 0;
  }

  .highlight-item p {
    color: #64748b;
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.5;
  }

  .intro-cards {
    display: grid;
    gap: 1.5rem;
  }

  .glass-card {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 2.5rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: transform 0.3s ease;
  }

  .glass-card:hover {
    transform: translateY(-5px);
  }

  .glass-card h3 {
    font-size: 1.4rem;
    color: #0f172a;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-weight: 800;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
    margin-top: 4rem;
  }

  .section-header h2 {
    font-size: 2.5rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 1rem;
  }

  .yearbooks-container {
    background: #eff6ff;
    border: 2px dashed #bfdbfe;
    border-radius: 20px;
    padding: 3rem;
    text-align: center;
    margin: 4rem 0;
  }

  .yearbooks-container h3 {
    font-size: 2rem;
    color: #1e3a8a;
    margin-bottom: 1rem;
    font-weight: 800;
  }

  .yearbooks-container p {
    color: #475569;
    font-size: 1.1rem;
    max-width: 800px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }

  .yearbook-links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }

  .yearbook-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #2563eb;
    color: white !important;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .yearbook-btn:hover {
    background: #1e40af;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(37, 99, 235, 0.2);
  }

  /* TIER GRID STYLES (EXPANDED) */
  .tier-system {
    background: white;
    border-radius: 30px;
    padding: 5rem;
    margin: 5rem 0;
    border: 1px solid #e2e8f0;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.03);
  }

  .tier-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .tier-header h2 {
    font-size: 3rem;
    font-weight: 900;
    color: #0f172a;
    margin-bottom: 1rem;
    letter-spacing: -1px;
  }

  .tier-header p {
    font-size: 1.2rem;
    color: #64748b;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .tier-block {
    background: #f8fafc;
    border-radius: 20px;
    padding: 3rem;
    margin-bottom: 2rem;
    border-left: 6px solid #2563eb;
  }

  .tier-block.t2 {
    border-color: #f97316;
  }
  .tier-block.t3 {
    border-color: #dc2626;
  }

  .tier-block h3 {
    font-size: 2rem;
    color: #0f172a;
    margin-bottom: 1rem;
    font-weight: 800;
  }

  .tier-block p {
    color: #475569;
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .tier-items {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .program-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
  }

  .program-card h4 {
    color: #1e293b;
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .program-card p {
    font-size: 1rem;
    color: #64748b;
    margin: 0;
    line-height: 1.6;
  }

  .tier-bullet-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .tier-bullet-list li {
    position: relative;
    padding-left: 2rem;
    color: #475569;
    font-weight: 500;
  }

  .tier-bullet-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #dc2626;
    font-weight: 900;
  }

  .delegate-banner {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border-radius: 20px;
    padding: 3rem;
    color: white !important;
    text-align: center;
    margin: 4rem 0;
  }

  .delegate-banner h3 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
    color: #f97316;
    font-weight: 800;
  }

  .delegate-banner p {
    font-size: 1.1rem;
    opacity: 0.9;
    margin-bottom: 1.5rem;
    color: white !important;
  }

  .delegate-phone {
    display: inline-block;
    font-size: 2.5rem;
    font-weight: 900;
    color: white !important;
    background: rgba(255, 255, 255, 0.1);
    padding: 1rem 3rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .policy-block {
    background: white;
    border-radius: 12px;
    padding: 2rem;
    border: 1px solid #e2e8f0;
    font-size: 0.9rem;
    color: #64748b;
    line-height: 1.6;
    margin-bottom: 5rem;
  }

  .policy-block h4 {
    color: #0f172a;
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .cta-banner {
    background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
    border-radius: 20px;
    padding: 4rem;
    text-align: center;
    color: white !important;
    margin-top: 5rem;
  }

  .cta-banner h2 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: white !important;
  }

  .cta-button {
    display: inline-block;
    background: white;
    color: #ea580c !important;
    padding: 1.2rem 3rem;
    border-radius: 50px;
    font-size: 1.1rem;
    font-weight: 800;
    text-decoration: none;
    margin-top: 2rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .cta-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 900px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
    .intro-highlights {
      grid-template-columns: 1fr;
    }
    .service-hero {
      padding-top: 8rem;
      min-height: 40vh;
    }
    .tier-system {
      padding: 2rem;
    }
    .tier-block {
      padding: 2rem;
    }
    .cta-banner {
      padding: 3rem 1.5rem;
    }
    .delegate-phone {
      font-size: 1.8rem;
      padding: 1rem 1.5rem;
    }
    .yearbook-links {
      flex-direction: column;
    }
  }

  /* TOUR MODAL CSS */
  #tourRequestModal {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(10px);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .tour-modal-content {
    background: white;
    border-radius: 24px;
    width: 100%;
    max-width: 900px;
    max-height: 90vh;
    overflow-y: auto;
    padding: 3rem;
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .tour-modal-close {
    position: absolute;
    top: 1.5rem;
    right: 2rem;
    font-size: 2.5rem;
    background: none;
    border: none;
    color: #64748b;
    cursor: pointer;
    line-height: 1;
    padding: 0;
  }

  .tour-modal-close:hover {
    color: #ef4444;
  }

  .tour-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .tour-form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tour-form-group.full {
    grid-column: 1 / -1;
  }

  .tour-form-group label {
    font-weight: 600;
    color: #1e293b;
    font-size: 0.95rem;
  }

  .tour-form-group input[type="text"],
  .tour-form-group input[type="email"],
  .tour-form-group input[type="tel"],
  .tour-form-group input[type="date"],
  .tour-form-group input[type="number"],
  .tour-form-group select {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-family: inherit;
    color: #0f172a;
    transition: all 0.3s;
  }

  .tour-form-group input:focus,
  .tour-form-group select:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  .radio-group,
  .checkbox-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .radio-group label,
  .checkbox-group label {
    font-weight: 400;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .tour-form-grid {
      grid-template-columns: 1fr;
    }
    .tour-modal-content {
      padding: 2rem 1.5rem;
    }
  }
</style>

<Layout title="Early Intervention & Behavioral Health - EIEI">
  <section class="service-hero">
    <div class="service-hero-content">
      <h1>Early Intervention & Behavioral Health</h1>
      <p>
        Comprehensive, specialized support empowering children ages 3–5 to
        thrive and reach their unique potential.
      </p>
    </div>
  </section>

  <main class="main-content">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a> / <a href="/services">Services</a> / Early Intervention
      </div>

      <div class="intro-grid">
        <div class="intro-text">
          <h2>Welcome to ECSE: A Place Where Every Child Shines</h2>
          <p>
            Discover a world where your child’s potential takes center stage.
            Early Childhood Special Education (ECSE) at EIEI is dedicated to
            nurturing unique abilities, fostering growth, and celebrating every
            milestone.
          </p>
          <p>
            Our team of experienced professionals works closely with families to
            create individualized plans that address each child's unique needs.
            We believe in the power of early intervention to make a significant
            impact on a child's future success and well-being.
          </p>

          <div class="intro-highlights">
            <div class="highlight-item">
              <h4>Why Choose ECSE at EIEI?</h4>
              <p>
                Personalized Support tailored to your child’s needs. Inclusive
                Environment where every child is welcomed, valued, and
                supported. Expert Guidance led by experienced educators and
                specialists.
              </p>
            </div>
            <div class="highlight-item">
              <h4>Family-Focused Care</h4>
              <p>
                You are at the heart of your child’s success. Our
                family-centered approach ensures you’re supported every step of
                the way. Together, we build a brighter future.
              </p>
            </div>
            <div class="highlight-item">
              <h4>Smooth Transitions, Lifelong Skills</h4>
              <p>
                Change can be challenging, but we make it seamless. From
                preschool to kindergarten, our transition planning equips
                children with the tools they need to thrive.
              </p>
            </div>
            <div class="highlight-item">
              <h4>Programs Designed for Growth</h4>
              <p>
                Experience programs built on kindness, inclusivity, and
                excellence. Every activity and service is designed to help your
                child thrive, learn, and grow confidently.
              </p>
            </div>
          </div>
        </div>

        <div class="intro-cards">
          <div class="glass-card">
            <h3>📍 Key Service Locations</h3>
            <p style="color: #475569; margin-bottom: 0.5rem;">
              4704 Leiper St., Philadelphia, PA
            </p>
            <p style="color: #475569;">5024 Penn St., Philadelphia, PA</p>
            <a
              href="#"
              onclick="openTourRequestModal(); return false;"
              class="cta-button"
              style="margin-top: 1rem; display: inline-block; padding: 0.8rem 1.5rem; font-size: 0.95rem; background: #2563eb; color: white !important;"
              >🗓️ Schedule a Tour</a
            >
          </div>
          <div
            class="glass-card"
            style="background: #eff6ff; border-color: #bfdbfe;"
          >
            <h3>🛡️ Comprehensive Services</h3>
            <p style="color: #1e3a8a;">
              From speech therapy to behavioral support, our team provides
              holistic care that empowers children to succeed in every aspect of
              life.
            </p>
          </div>
        </div>
      </div>

      <div class="yearbooks-container">
        <h3>Celebrating a Year of Growth! 🎓</h3>
        <p>
          As we wrap up another successful school year, we want to extend our
          heartfelt thanks to all the families, students, and staff. We've seen
          tremendous growth, celebrated countless achievements, and created
          wonderful memories. To commemorate this incredible year, we are
          excited to share our yearbooks!
        </p>
        <div class="yearbook-links">
          <a
            href="https://drive.google.com/file/d/1TgOgmtelAV1Llsmv-FQAycP71tgh5lf8/view?usp=sharing"
            target="_blank"
            class="yearbook-btn">📖 View Yearbook 2024 (English)</a
          >
          <a
            href="https://drive.google.com/file/d/1l6LzfiTz0IQ0RrTe57DG1bt80VuKuH7k/view?usp=sharing"
            target="_blank"
            class="yearbook-btn"
            style="background: #f97316;">📖 Ver Anuario 2024 (Español)</a
          >
          <a
            href="https://drive.google.com/file/d/1t5vnTdpQj1iVUN2eYqEnIAQr7FjUTZLN/view?usp=sharing"
            target="_blank"
            class="yearbook-btn">📖 View Yearbook 2025 (English)</a
          >
        </div>
      </div>

      <div class="tier-system">
        <div class="tier-header">
          <h2>Our Kids Are Off to a Fantastic Year!</h2>
          <p>
            Behavioral Health parameters and frameworks providing structured
            supports and services to help all students succeed across the entire
            school year.
          </p>
        </div>

        <div class="tier-block">
          <h3>Universal Supports (Tier 1)</h3>
          <p>
            Every school has support for all students. All students are taught
            basic expected behaviors (or ways to act), like how to show respect
            and kindness. The school staff praises children for their excellent
            behavior. Sometimes small rewards like tokens or prizes are used to
            reward good and positive school behavior.
          </p>

          <div class="tier-items">
            <div class="program-card">
              <h4>Positive Behavior Interventions and Supports (PBIS)</h4>
              <p>
                PBIS promotes positive school safety and good behavior among all
                students by school staff teaching students about emotions,
                mindfulness, and their ability to do well in their school, home,
                and community. PBIS is not a program or a curriculum; it’s a
                team of school employees focused on creating a safe and fun
                school environment.
              </p>
            </div>
            <div class="program-card">
              <h4>Restorative Justice</h4>
              <p>
                A process that teaches students how to resolve conflicts on
                their own and in small groups. Through safe and supportive
                spaces in the schools, students can meet to talk, ask questions,
                and air their grievances in ways that all parties feel
                acknowledged.
              </p>
            </div>
            <div class="program-card">
              <h4>Social and Emotional Learning (SEL)</h4>
              <p>
                Teaches students how to manage their emotions, make good
                decisions, and work with other children on a team. They learn
                critical thinking, emotion management, conflict resolution,
                decision-making, and teamwork so children can value themselves
                and others.
              </p>
            </div>
          </div>
        </div>

        <div class="tier-block t2">
          <h3>Individualized Support (Tier 2)</h3>
          <p>
            At this level, your child will receive all the support above, and
            they may start to receive small group or individualized support to
            help them experience success. For example, if your child is
            struggling with social interactions, they might get help in a small
            group of peers. The parent engages with the school team to determine
            appropriate supports, such as daily reports, behavior contracts, or
            counseling.
          </p>

          <div class="tier-items">
            <div class="program-card">
              <h4>Student Assistance Program (SAP)</h4>
              <p>
                A team of experts at the school that starts the intervention
                process. The group decides which resources are a good match for
                your child so they can stay in school and keep learning. Staff
                talk with students to determine if they need additional support
                services and refer them accordingly.
              </p>
            </div>
            <div class="program-card">
              <h4>Support Team for Education Project (STEP)</h4>
              <p>
                A full-time school team that talks with students to figure out
                if they need behavioral health/counseling/therapy services. They
                guide students to social services such as housing, insurance, or
                food assistance. STEP staff can provide counseling services for
                a short time while they wait to start referred services.
              </p>
            </div>
            <div class="program-card">
              <h4>STEP "Like" Schools</h4>
              <p>
                Schools that offer some of the STEP services and supports but
                not everything in the original program. A STEP "like" may look
                different at each location.
              </p>
            </div>
          </div>
        </div>

        <div class="tier-block t3">
          <h3>Intensive Behavioral Health Services (Tier 3)</h3>
          <p>
            For students with the most distress/needs, who need more support
            than an hour of counseling a week, and who are at risk of being
            unable to stay at home and school because they need treatment. These
            high-level services aim to help students stay at home and school
            instead of being placed in a hospital setting.
          </p>
          <p>
            These individualized services are provided by a licensed behavioral
            health agency assigned to your child’s school. Services may include
            multiple weekly sessions focusing on specific skills.
          </p>

          <ul class="tier-bullet-list">
            <li>Individual Sessions</li>
            <li>Student Group Sessions</li>
            <li>Family Sessions</li>
            <li>Case Management</li>
            <li>Behavior Management Planning</li>
            <li>Crisis Intervention</li>
            <li>Outpatient Satellite in Schools</li>
          </ul>
        </div>
      </div>

      <GallerySection />

      <!-- TESTIMONIALS SECTION -->
      <TestimonialSection program="early-intervention" />

      <div class="delegate-banner">
        <h3>Additional Mental Health Resources</h3>
        <p>
          If emergency mental health resources are needed, the following
          constant support line may be utilized at any hour:
        </p>
        <div class="delegate-phone">
          24-Hour Mental Health Delegate Line <br /> 215-685-6440
        </div>
      </div>

      <div class="cta-banner">
        <h2>Join Our ECSE Waitlist Today</h2>
        <p
          style="font-size: 1.2rem; opacity: 0.9; max-width: 600px; margin: 0 auto; color: white !important;"
        >
          Secure a spot in our world-class specialized classrooms. We are deeply
          committed to nurturing your child's brilliance.
        </p>
        <a
          href="https://docs.google.com/forms/d/e/1FAIpQLScr1u66TzSngd0mO3bT1yZq1N89Tig3Nl87z1p1b1X_U8-i2w/viewform"
          target="_blank"
          class="cta-button">Apply to Waitlist</a
        >
      </div>
    </div>
  </main>

  <!-- Tour Request Modal -->
  <div id="tourRequestModal">
    <div class="tour-modal-content">
      <button class="tour-modal-close" onclick="closeTourRequestModal()"
        >&times;</button
      >
      <h2
        style="font-size: 2rem; font-weight: 800; color: #0f172a; margin-bottom: 0.5rem;"
      >
        ECSE Classroom Tour Request
      </h2>
      <p style="color: #64748b; margin-bottom: 2rem; font-size: 1.05rem;">
        We are delighted by your interest in visiting our Early Intervention
        Classrooms. Please fill out the criteria below so we can schedule
        optimally.
      </p>

      <form id="tourRequestForm" onsubmit="submitTourRequest(event)">
        <div class="tour-form-grid">
          <div class="tour-form-group">
            <label for="tourParentName"
              >Parent/Guardian Full Name <span style="color: #ef4444;">*</span>
            </label>
            <input
              type="text"
              id="tourParentName"
              required
              placeholder="John Doe"
            />
          </div>

          <div class="tour-form-group">
            <label for="tourChildName"
              >Child's Full Name <span style="color: #ef4444;">*</span>
            </label>
            <input
              type="text"
              id="tourChildName"
              required
              placeholder="Jane Doe"
            />
          </div>

          <div class="tour-form-group">
            <label for="tourChildDOB"
              >Child's Date of Birth <span style="color: #ef4444;">*</span>
            </label>
            <input type="date" id="tourChildDOB" required />
          </div>

          <div class="tour-form-group">
            <label for="tourChildAge"
              >Child's Current Age <span style="color: #ef4444;">*</span>
            </label>
            <input
              type="number"
              id="tourChildAge"
              required
              placeholder="e.g. 4"
            />
          </div>

          <div class="tour-form-group full">
            <label for="tourLEA"
              >Sending LEA (School District / County) <span
                style="color: #ef4444;">*</span
              >
            </label>
            <input
              type="text"
              id="tourLEA"
              required
              placeholder="e.g. Philadelphia School District"
            />
          </div>

          <div class="tour-form-group">
            <label for="tourPhone"
              >Parent Phone Number <span style="color: #ef4444;">*</span>
            </label>
            <input
              type="tel"
              id="tourPhone"
              required
              placeholder="(123) 456-7890"
            />
          </div>

          <div class="tour-form-group">
            <label for="tourEmail"
              >Parent Email Address <span style="color: #ef4444;">*</span>
            </label>
            <input
              type="email"
              id="tourEmail"
              required
              placeholder="johndoe@email.com"
            />
          </div>

          <div class="tour-form-group full">
            <label for="tourAddress"
              >Home Address <span style="color: #ef4444;">*</span>
            </label>
            <input
              type="text"
              id="tourAddress"
              required
              placeholder="123 Main St, City, State ZIP"
            />
          </div>

          <div class="tour-form-group">
            <label
              >Child's Current IEP Services <span style="color: #ef4444;"
                >*</span
              >
            </label>
            <div class="checkbox-group">
              <label
                ><input
                  type="checkbox"
                  name="tourServices"
                  value="Speech/Language"
                /> Speech/Language</label
              >
              <label
                ><input
                  type="checkbox"
                  name="tourServices"
                  value="Occupational Therapy"
                /> Occupational Therapy (OT)</label
              >
              <label
                ><input
                  type="checkbox"
                  name="tourServices"
                  value="Physical Therapy"
                /> Physical Therapy (PT)</label
              >
              <label
                ><input
                  type="checkbox"
                  name="tourServices"
                  value="Special Instruction"
                /> Special Instruction (SI)</label
              >
              <label
                ><input
                  type="checkbox"
                  name="tourServices"
                  value="Behavior Support"
                /> Behavior Support</label
              >
              <label
                ><input type="checkbox" name="tourServices" value="None" /> None
                Currently</label
              >
            </div>
          </div>

          <div class="tour-form-group">
            <label>Primary Language Spoken at Home</label>
            <input
              type="text"
              id="tourLanguage"
              placeholder="e.g. English, Spanish"
            />
          </div>

          <div class="tour-form-group">
            <label>Does your child currently attend preschool or daycare?</label
            >
            <div class="radio-group">
              <label
                ><input
                  type="radio"
                  name="tourPreschool"
                  value="Yes"
                  required
                /> Yes</label
              >
              <label
                ><input type="radio" name="tourPreschool" value="No" /> No</label
              >
            </div>
          </div>

          <div class="tour-form-group">
            <label>If accepted, will transportation be needed?</label>
            <div class="radio-group">
              <label
                ><input
                  type="radio"
                  name="tourTransportation"
                  value="Yes"
                  required
                /> Yes</label
              >
              <label
                ><input type="radio" name="tourTransportation" value="No" /> No</label
              >
            </div>
          </div>

          <div class="tour-form-group full">
            <label
              >Preferred Time of Day for Tour <span style="color: #ef4444;"
                >*</span
              >
            </label>
            <div class="radio-group">
              <label
                ><input
                  type="radio"
                  name="tourTime"
                  value="Morning (9AM - 11AM)"
                  required
                /> Morning (9AM - 11AM)</label
              >
              <label
                ><input
                  type="radio"
                  name="tourTime"
                  value="Afternoon (1PM - 3PM)"
                /> Afternoon (1PM - 3PM)</label
              >
            </div>
          </div>

          <div class="tour-form-group full" style="margin-top: 1rem;">
            <button
              type="submit"
              class="cta-button"
              style="width: 100%; text-align: center; border: none; cursor: pointer; padding: 1.2rem;"
              >Submit Tour Request</button
            >
          </div>
        </div>
      </form>
    </div>
  </div>
</Layout>
