---
import Layout from '../layouts/Layout.astro';
import TestimonialSection from '../components/TestimonialSection.astro';
import GallerySection from '../components/GallerySection.astro';
---

<Layout title="Career Development & Apprenticeship - EIEI">
  <style is:global>
    /* PREMIUM MODERN STYLES */
    .service-hero {
      position: relative;
      width: 100%;
      min-height: 45vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 10rem 2rem 5rem;
      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
      color: white;
      text-align: center;
      overflow: hidden;
    }

    .service-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      opacity: 0.5;
      z-index: 1;
    }

    .service-hero-content {
      position: relative;
      z-index: 2;
      max-width: 800px;
      margin: 0 auto;
    }

    .service-hero h1 {
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      font-weight: 900;
      line-height: 1.1;
      margin-bottom: 1.5rem;
      letter-spacing: -1px;
    }

    .service-hero p {
      font-size: 1.25rem;
      font-weight: 400;
      opacity: 0.9;
      line-height: 1.6;
    }

    .main-content {
      background: #f8fafc;
      padding: 5rem 2rem;
      min-height: 50vh;
    }

    .career-container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .breadcrumb {
      margin-bottom: 3rem;
      font-size: 0.95rem;
      color: #64748b;
      font-weight: 500;
      margin-top: 2.5rem;
    }

    .breadcrumb a {
      color: #2563eb;
      text-decoration: none;
      transition: color 0.3s;
    }

    .breadcrumb a:hover {
      color: #f97316;
    }

    .section-header {
      text-align: center;
      margin-bottom: 4rem;
    }

    .badge {
      display: inline-block;
      padding: 0.5rem 1.2rem;
      background: #eff6ff;
      color: #2563eb;
      border-radius: 50px;
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 1rem;
    }

    .app-steps {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      max-width: 800px;
      margin: 0 auto 5rem;
    }

    .app-step {
      display: flex;
      gap: 2rem;
      background: white;
      padding: 2.5rem;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.03);
      border: 1px solid #e2e8f0;
      align-items: center;
    }

    .app-num {
      font-size: 2.5rem;
      font-weight: 900;
      color: #2563eb;
      opacity: 0.3;
      flex-shrink: 0;
    }

    .app-content h4 {
      font-size: 1.4rem;
      color: #0f172a;
      margin-bottom: 0.5rem;
      font-weight: 800;
    }

    .app-content p {
      color: #475569;
      line-height: 1.6;
      margin: 0;
    }

    .gallery-section {
      padding: 80px 0;
    }

    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
      margin-top: 3rem;
    }

    .gallery :global(.gallery-item) {
      border-radius: 16px;
      overflow: hidden;
      height: 250px;
      cursor: pointer;
      box-shadow: 0 10px 20px rgba(0,0,0,0.05);
      transition: transform 0.3s;
    }

    .gallery :global(.gallery-item img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .faq-wrapper {
      max-width: 900px;
      margin: 0 auto 5rem;
    }

    .faq-item {
      margin-bottom: 1rem;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      background: white;
      overflow: hidden;
    }

    .faq-trigger {
      width: 100%;
      text-align: left;
      padding: 1.5rem 2rem;
      background: #f8fafc;
      border: none;
      font-size: 1.1rem;
      font-weight: 700;
      color: #1e293b;
      cursor: pointer;
      transition: background 0.3s;
    }

    .faq-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s ease;
    }

    .faq-inner {
      padding: 2rem;
      color: #475569;
      line-height: 1.8;
      border-top: 1px solid #e2e8f0;
    }

    .faq-item.active .faq-content {
      max-height: 500px;
    }

    .cta-banner {
      background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);
      padding: 5rem 3rem;
      border-radius: 40px;
      color: white;
      text-align: center;
      margin: 5rem 0;
    }

    .cta-banner h2 {
      font-size: 2.5rem;
      font-weight: 800;
      margin-bottom: 1.5rem;
    }

    .cta-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      margin-bottom: 2rem;
    }

    .primary-btn {
      background: #2563eb;
      color: white;
      padding: 1rem 2rem;
      border-radius: 50px;
      font-weight: 700;
      text-decoration: none;
      display: inline-block;
      transition: transform 0.3s;
    }

    .primary-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 20px rgba(37, 99, 235, 0.3);
    }

    .secondary-pill {
      background: white;
      color: #0f172a;
      padding: 1rem 2rem;
      border-radius: 50px;
      font-weight: 700;
      text-decoration: none;
      display: inline-block;
      transition: transform 0.3s;
    }

    .secondary-pill:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 20px rgba(255, 255, 255, 0.2);
    }

    .contact-footer {
      font-size: 0.9rem;
      opacity: 0.8;
    }

    @media (max-width: 768px) {
      .app-step { flex-direction: column; text-align: center; }
      .app-num { font-size: 2rem; }
      .cta-actions { flex-direction: column; }
    }
  </style>

  <section class="service-hero">
    <div class="service-hero-content">
      <div class="badge">Apprenticeship Program</div>
      <h1>Career Development</h1>
      <p>Building the next generation of Early Childhood Special Education Specialists through hands-on mastery.</p>
    </div>
  </section>

  <main class="main-content">
    <div class="career-container">
      <div class="breadcrumb">
        <a href="/">Home</a> / <a href="/services">Services</a> / Career Development
      </div>

      <div class="section-header">
        <h2>The Roadmap to Your Future</h2>
        <p>A structured multi-step process for candidates entering our specialized cohort.</p>
      </div>

      <div class="app-steps">
        <div class="app-step">
          <div class="app-num">01</div>
          <div class="app-content">
            <h4>Initial Inquiry</h4>
            <p>Reach out to our coordinator to discuss eligibility, upcoming cohort dates, and placement requirements for the specialized apprenticeship track.</p>
          </div>
        </div>
        <div class="app-step">
          <div class="app-num">02</div>
          <div class="app-content">
            <h4>Draft Your Essay</h4>
            <p>
              Write a paragraph stating why you are interested in special
              education. Include your career goals and how the apprenticeship
              will help you achieve them. (Accuracy, grammar, and detail
              matter!)
            </p>
          </div>
        </div>
        <div class="app-step">
          <div class="app-num">03</div>
          <div class="app-content">
            <h4>Submit Form & Support Docs</h4>
            <p>
              Complete the online application and email your supporting
              documents to **akariuki@eiforei.org** or
              **careerdevelopment@eiforei.org**.
            </p>
          </div>
        </div>
        <div class="app-step">
          <div class="app-num">04</div>
          <div class="app-content">
            <h4>Hiring & Start</h4>
            <p>
              Accepted apprentices go through a hiring process with
              participating employers and should begin full-time employment by
              the program start date.
            </p>
          </div>
        </div>
      </div>

      <GallerySection program="career-development" />

      <TestimonialSection program="career-development" />

      <!-- FAQS -->
      <div class="section-header" style="margin-top: 4rem;">
        <div class="badge">Questions?</div>
        <h2>Frequently Asked Questions</h2>
      </div>

      <div class="faq-wrapper">
        <div class="faq-item">
          <button class="faq-trigger">What if I have already taken some of these courses?</button>
          <div class="faq-content">
            <div class="faq-inner">
              We will collect all prior learning certificates during the
              application process and give you credit for what you have
              already taken. Depending on your courses, you may even be
              eligible to decrease the program length.
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-trigger">Do I have to work during the program?</button>
          <div class="faq-content">
            <div class="faq-inner">
              Yes. Working full-time (minimum 3,000 hours over 18 months) in
              an approved program is a requirement. If you aren't currently
              with a participating employer, we will help match you with one.
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-trigger">I work in family childcare. Am I eligible?</button>
          <div class="faq-content">
            <div class="faq-inner">
              Owner/operators of family childcare cannot participate as
              apprentices themselves, but they can serve as employer/mentors
              for their full-time employees who are in the program.
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-trigger">What support do I get for further education?</button>
          <div class="faq-content">
            <div class="faq-inner">
              After completion, EIEI supports you in applying for the **CCCPDF
              grant**, which can cover **100% of tuition, books, and fees**
              for degree programs. You may also articulate your apprenticeship
              into college credits!
            </div>
          </div>
        </div>
      </div>

      <!-- CTA SECTION -->
      <div class="cta-banner">
        <h2>Empower Your Future in Education</h2>
        <p>
          Applications for our 2025 cohort are officially open. Join a
          community dedicated to inclusivity and professional excellence.
        </p>
        <div class="cta-actions">
          <a href="mailto:akariuki@eiforei.org" class="primary-btn">Email coordinator</a>
          <a href="tel:4845019101" class="secondary-pill">Call Dr. Essence: 484-501-9101</a>
        </div>

        <div class="contact-footer">
          <p>
            Apprenticeship Coordinator: <strong>Abby Kariuki</strong> | 215-514-2560
          </p>
          <p>Program Director: <strong>Dr. Essence Allen-Presley</strong></p>
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    document.querySelectorAll(".faq-trigger").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const item = trigger.parentElement;
        const isActive = item.classList.contains("active");
        document
          .querySelectorAll(".faq-item")
          .forEach((it) => it.classList.remove("active"));
        if (!isActive) item.classList.add("active");
      });
    });
  </script>
</Layout>
