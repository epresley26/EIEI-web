                    } catch (error) {
                      console.error("Error uploading file:", error);
                      alert(
                        "Error uploading file: " +
                          file.name +
                          " - " +
                          error.message
                      );
                      uploaded++;
                      if (uploaded === files.length) {
                        uploadBtn.disabled = false;
                        progressDiv.style.display = "none";
                      }
                    }
                  })();
                });
              }

