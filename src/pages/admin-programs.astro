              // ===== NOTIFICATION BADGE HANDLER =====
              let notificationListenerActive = false;
              let conversationMessageListeners = {};

              function countUnreadMessages() {
                return new Promise((resolve) => {
                  const db = window.firebaseDB;
                  if (!db) {
                    resolve(0);
                    return;
                  }

                  let totalUnread = 0;
                  let processedConversations = 0;

                  db.collection("chats")
                    .get()
                    .then((chatsSnapshot) => {
                      if (chatsSnapshot.empty) {
                        resolve(0);
                        return;
                      }

                      chatsSnapshot.docs.forEach((chatDoc) => {
                        const chatId = chatDoc.id;

                        db.collection("chats")
                          .doc(chatId)
                          .collection("messages")
                          .where("sender", "==", "user")
                          .where("read", "==", false)
                          .get()
                          .then((messagesSnapshot) => {
                            totalUnread += messagesSnapshot.size;
                            processedConversations++;

                            if (
                              processedConversations ===
                              chatsSnapshot.docs.length
                            ) {
                              resolve(totalUnread);
                            }
                          });
                      });
                    });
                });
              }

              async function updateNotificationBadge() {
                const badgeElement =
                  document.getElementById("notificationBadge");
                if (!badgeElement) return;

                const count = await countUnreadMessages();
                if (count > 0) {
                  badgeElement.textContent = count;
                  badgeElement.style.display = "flex";
                  console.log("Badge updated to:", count);
                } else {
                  badgeElement.style.display = "none";
                  console.log("Badge hidden");
                }
              }

              function setupMessageListener(conversationId) {
                if (conversationMessageListeners[conversationId]) return;

                const db = window.firebaseDB;
                if (!db) return;

                conversationMessageListeners[conversationId] = true;

                // Listen to messages in this conversation and update badge when any message changes
                db.collection("chats")
                  .doc(conversationId)
                  .collection("messages")
                  .onSnapshot(() => {
                    updateNotificationBadge();
                  });
              }

              function initializeNotificationListener() {
                if (notificationListenerActive) return;

                const db = window.firebaseDB;
                if (!db) {
                  console.log("Firebase not ready, retrying in 1s...");
                  setTimeout(initializeNotificationListener, 1000);
                  return;
                }

                notificationListenerActive = true;
                console.log("Setting up notification listener...");

                // Listen to conversations and set up message listeners
                db.collection("chats").onSnapshot((chatsSnapshot) => {
                  chatsSnapshot.docs.forEach((chatDoc) => {
                    setupMessageListener(chatDoc.id);
                  });
                  // Initial count
                  updateNotificationBadge();
                });
              }

              // Start notification listener
              window.addEventListener("load", initializeNotificationListener);
              if (
                document.readyState === "complete" ||
                document.readyState === "interactive"
              ) {
                initializeNotificationListener();
              }

