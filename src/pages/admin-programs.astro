              async function deleteJob(id) {
                if (
                  confirm("Are you sure you want to delete this job opening?")
                ) {
                  try {
                    await window.firebaseDB.collection("jobs").doc(id).delete();
                    document.getElementById("jobSuccessMessage").textContent =
                      "✓ Job opening deleted!";
                    document.getElementById("jobSuccessMessage").style.display =
                      "block";
                    loadJobOpenings();
                    setTimeout(() => {
                      document.getElementById(
                        "jobSuccessMessage"
                      ).style.display = "none";
                    }, 3000);
                  } catch (error) {
                    document.getElementById("jobErrorMessage").textContent =
                      "✗ Error: " + error.message;
                    document.getElementById("jobErrorMessage").style.display =
                      "block";
                  }
                }
              }

              // ====== APPLICATION FUNCTIONS ======

              async function loadApplicationsTab() {
                try {
                  // Populate job filter dropdown
                  const jobsSnapshot = await window.firebaseDB
                    .collection("jobs")
                    .orderBy("postedAt", "desc")
                    .get();
                  const filterSelect =
                    document.getElementById("filterJobSelect");

                  jobsSnapshot.forEach((doc) => {
                    const job = doc.data();
                    const option = document.createElement("option");
                    option.value = doc.id;
                    option.textContent = job.title;
                    filterSelect.appendChild(option);
                  });

                  // Load all applications
                  await loadApplicationsForJob();
                } catch (error) {
                  console.error("Error loading applications tab:", error);
                }
              }

              async function loadApplicationsForJob() {
                try {
                  const selectedJobId =
                    document.getElementById("filterJobSelect").value;
                  const applicationsContainer = document.getElementById(
                    "applicationsContainer"
                  );

                  // Load all applications (no composite index needed)
                  const applicationsSnapshot = await window.firebaseDB
                    .collection("job_applications")
                    .get();

                  // Filter client-side
                  let filteredApps = applicationsSnapshot.docs.map((doc) => ({
                    id: doc.id,
                    ...doc.data(),
                  }));

                  if (selectedJobId) {
                    filteredApps = filteredApps.filter(
                      (app) => app.jobId === selectedJobId
                    );
                  }

                  // Sort by appliedAt descending
                  filteredApps.sort((a, b) => {
                    const dateA = a.appliedAt.toDate
                      ? a.appliedAt.toDate()
                      : new Date(a.appliedAt);
                    const dateB = b.appliedAt.toDate
                      ? b.appliedAt.toDate()
                      : new Date(b.appliedAt);
                    return dateB - dateA;
                  });

                  if (filteredApps.length === 0) {
                    applicationsContainer.innerHTML =
                      '<p style="text-align: center; color: var(--text-muted); padding: 2rem;">No applications found.</p>';
                    return;
                  }

                  applicationsContainer.innerHTML = "";

                  // Group applications by job
                  const jobsMap = {};

                  filteredApps.forEach((app) => {
                    const jobId = app.jobId;

                    if (!jobsMap[jobId]) {
                      jobsMap[jobId] = {
                        jobTitle: "",
                        applications: [],
                      };
                    }

                    jobsMap[jobId].applications.push(app);
                  });

                  // Fetch job titles
                  for (const jobId of Object.keys(jobsMap)) {
                    try {
                      const jobDoc = await window.firebaseDB
                        .collection("jobs")
                        .doc(jobId)
                        .get();
                      if (jobDoc.exists) {
                        jobsMap[jobId].jobTitle = jobDoc.data().title;
                      }
                    } catch (error) {
                      console.error("Error fetching job:", error);
                    }
                  }

                  // Render tables for each job
                  for (const [jobId, data] of Object.entries(jobsMap)) {
                    const tableContainer = document.createElement("div");
                    tableContainer.style.marginBottom = "3rem";

                    let tableHTML = `
            <h3 style="color: var(--brand-blue); margin-bottom: 1rem;">${data.jobTitle} (${data.applications.length} applications)</h3>
            <div style="overflow-x: auto;">
              <table style="width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <thead>
                  <tr style="background: var(--brand-blue); color: white;">
                    <th style="padding: 1rem; text-align: left;">Name</th>
                    <th style="padding: 1rem; text-align: left;">Email</th>
                    <th style="padding: 1rem; text-align: left;">Phone</th>
                    <th style="padding: 1rem; text-align: left;">Experience</th>
                    <th style="padding: 1rem; text-align: left;">Resume</th>
                    <th style="padding: 1rem; text-align: left;">Applied At</th>
                    <th style="padding: 1rem; text-align: center;">Status</th>
                    <th style="padding: 1rem; text-align: center;">Actions</th>
                  </tr>
                </thead>
                <tbody>
          `;

                    data.applications.forEach((app, index) => {
                      const appliedDate = new Date(
                        app.appliedAt.toDate()
                      ).toLocaleDateString();
                      const rowBg = index % 2 === 0 ? "#f9f9f9" : "white";
                      const statusColor =
                        app.status === "pending"
                          ? "#ff9800"
                          : app.status === "reviewed"
                          ? "#4caf50"
                          : "#f44336";
                      const resumeBtn =
                        app.resumeData || app.resumeUrl
                          ? `<button onclick="downloadJobResume('${app.id}', '${
                              app.resumeFileName || "resume.pdf"
                            }')" style="background: #28a745; color: white; border: none; padding: 0.4rem 0.8rem; border-radius: 4px; cursor: pointer;">📥 Download</button>`
                          : "N/A";

                      tableHTML += `
              <tr style="background: ${rowBg}; border-bottom: 1px solid #eee;">
                <td style="padding: 1rem;">${app.name}</td>
                <td style="padding: 1rem;"><a href="mailto:${
                  app.email
                }" style="color: var(--brand-blue); text-decoration: none;">${
                        app.email
                      }</a></td>
                <td style="padding: 1rem;"><a href="tel:${
                  app.phone
                }" style="color: var(--brand-blue); text-decoration: none;">${
                        app.phone
                      }</a></td>
                <td style="padding: 1rem;">${app.experience} years</td>
                <td style="padding: 1rem;">${resumeBtn}</td>
                <td style="padding: 1rem;">${appliedDate}</td>
                <td style="padding: 1rem; text-align: center;">
                  <select onchange="updateApplicationStatus('${
                    app.id
                  }', this.value)" style="padding: 0.5rem; border-radius: 4px; border: 1px solid #ddd; background: ${statusColor}; color: white; cursor: pointer;">
                    <option value="pending" ${
                      app.status === "pending" ? "selected" : ""
                    }>Pending</option>
                    <option value="reviewed" ${
                      app.status === "reviewed" ? "selected" : ""
                    }>Reviewed</option>
                    <option value="rejected" ${
                      app.status === "rejected" ? "selected" : ""
                    }>Rejected</option>
                  </select>
                </td>
                <td style="padding: 1rem; text-align: center;">
                  <button onclick="deleteApplication('${
                    app.id
                  }')" style="background: #f44336; color: white; border: none; padding: 0.4rem 0.8rem; border-radius: 4px; cursor: pointer;">Delete</button>
                </td>
              </tr>
            `;
                    });

                    tableHTML += `
                </tbody>
              </table>
            </div>
          `;

                    tableContainer.innerHTML = tableHTML;
                    applicationsContainer.appendChild(tableContainer);
                  }
                } catch (error) {
                  console.error("Error loading applications:", error);
                  document.getElementById("applicationsContainer").innerHTML =
                    '<p style="color: red;">Error loading applications.</p>';
                }
              }

              async function updateApplicationStatus(appId, newStatus) {
                try {
                  await window.firebaseDB
                    .collection("job_applications")
                    .doc(appId)
                    .update({
                      status: newStatus,
                    });
                } catch (error) {
                  console.error("Error updating application status:", error);
                  alert("Error updating status: " + error.message);
                }
