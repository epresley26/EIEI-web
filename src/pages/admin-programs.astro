              function exportEnquiriesCSV() {
                const header = [
                  "name",
                  "email",
                  "phone",
                  "address",
                  "childAge",
                  "message",
                  "createdAt",
                ];
                const lines = [header.join(",")].concat(
                  enquiries.map((q) => {
                    const v = (x) => String(x ?? "").replace(/\"/g, '""');
                    return `\"${v(q.name)}\",\"${v(q.email)}\",\"${v(
                      q.phone
                    )}\",\"${v(q.address)}\",\"${v(q.childAge)}\",\"${v(
                      q.message
                    )}\",\"${toISOStringSafe(q.createdAt)}\"`;
                  })
                );
                const blob = new Blob([lines.join("\n")], {
                  type: "text/csv;charset=utf-8;",
                });
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                a.download = `enquiries_${new Date()
                  .toISOString()
                  .slice(0, 10)}.csv`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
              }

              function exportEnquiriesXLSX() {
                if (typeof XLSX === "undefined") return exportEnquiriesCSV();
                const data = enquiries.map((q) => ({
                  Name: q.name || "",
                  Email: q.email || "",
                  Phone: q.phone || "",
                  Address: q.address || "",
                  ChildAge: q.childAge ?? "",
                  Message: q.message || "",
                  Submitted: toReadableDate(q.createdAt),
                }));
                const ws = XLSX.utils.json_to_sheet(data);
                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, "Enquiries");
                XLSX.writeFile(
                  wb,
                  `enquiries_${new Date().toISOString().slice(0, 10)}.xlsx`
                );
              }

