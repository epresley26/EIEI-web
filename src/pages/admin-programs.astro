              async function uploadToImgBB(file) {
                const formData = new FormData();

                // Only compress if file size exceeds 30MB
                const maxCompressionThreshold = 30 * 1024 * 1024;
                let uploadFile = file;

                if (file.size > maxCompressionThreshold) {
                  console.log(
                    "File size (" +
                      Math.round(file.size / 1024 / 1024) +
                      "MB) exceeds 30MB, compressing..."
                  );
                  uploadFile = await compressImage(file);
                }

                formData.append("image", uploadFile);
                formData.append("key", IMGBB_API_KEY);

                const response = await fetch("https://api.imgbb.com/1/upload", {
                  method: "POST",
                  body: formData,
                });

                if (!response.ok) {
                  throw new Error(
                    "ImgBB upload failed: " + response.statusText
                  );
                }

                const data = await response.json();
                if (!data.success) {
                  throw new Error(
                    "ImgBB error: " + (data.error?.message || "Unknown error")
                  );
                }

                return data.data.url;
              }

              async function compressImage(file) {
                return new Promise((resolve, reject) => {
                  const reader = new FileReader();
                  reader.onload = (e) => {
                    const img = new Image();
                    img.onload = () => {
                      const canvas = document.createElement("canvas");
                      let width = img.width;
                      let height = img.height;

                      // Scale down if either dimension exceeds 1200px
                      if (width > 1200 || height > 1200) {
                        const ratio = Math.min(1200 / width, 1200 / height);
                        width = Math.round(width * ratio);
                        height = Math.round(height * ratio);
                      }

                      canvas.width = width;
                      canvas.height = height;
                      const ctx = canvas.getContext("2d");
                      ctx.drawImage(img, 0, 0, width, height);

                      // Convert to blob with progressive quality reduction
                      let quality = 0.8;
                      const attemptCompress = () => {
                        canvas.toBlob(
                          (blob) => {
                            if (
                              blob &&
                              blob.size > maxCompressionThreshold &&
                              quality > 0.1
                            ) {
                              quality -= 0.1;
                              attemptCompress();
                            } else if (blob) {
                              console.log(
                                "Compressed from " +
                                  Math.round(file.size / 1024 / 1024) +
                                  "MB to " +
                                  Math.round(blob.size / 1024 / 1024) +
                                  "MB"
                              );
                              resolve(
                                new File([blob], file.name, {
                                  type: "image/jpeg",
                                })
                              );
                            } else {
                              reject(new Error("Failed to compress image"));
                            }
                          },
                          "image/jpeg",
                          quality
                        );
                      };
                      attemptCompress();
                    };
                    img.onerror = () =>
                      reject(new Error("Failed to load image"));
                    img.src = e.target.result;
                  };
                  reader.onerror = () =>
                    reject(new Error("Failed to read file"));
                  reader.readAsDataURL(file);
                });
              }

              function uploadFiles() {
                const files = Array.from(imageInput.files);
                const programId = document.getElementById(
                  "galleryProgramSelect"
                ).value;
                if (files.length === 0) return;


                console.log(
                  "Starting upload of",
                  files.length,
                  "image files to ImgBB"
                );

                uploadBtn.disabled = true;
                const progressDiv = document.getElementById("uploadProgress");
                progressDiv.style.display = "block";

                let uploaded = 0;
                files.forEach((file) => {
                  // Validate file is an image
                  if (!file.type.startsWith("image/")) {
                    alert("Please select only image files");
                    uploadBtn.disabled = false;
                    progressDiv.style.display = "none";
                    return;
                  }

                  // Validate original file size (max 32MB for ImgBB)
                  const maxSize = 32 * 1024 * 1024;
                  if (file.size > maxSize) {
                    alert(
                      "Image file is too large. Maximum size is 32MB. File: " +
                        file.name
                    );
                    uploadBtn.disabled = false;
                    progressDiv.style.display = "none";
                    return;
                  }

                  console.log(
                    "Processing file:",
                    file.name,
                    "Size:",
                    file.size
                  );

                  (async () => {
                    try {
                      // Upload to ImgBB
                      const imageUrl = await uploadToImgBB(file);
                      console.log(
                        "Image uploaded to ImgBB:",
                        file.name,
                        "URL:",
                        imageUrl
                      );

                      // Save to Firestore gallery collection with ImgBB URL
                      await window.firebaseDB.collection("gallery").add({
                        imageUrl: imageUrl,
                        fileName: file.name,
                        programId: programId,
                        uploadedAt:
                          firebase.firestore.FieldValue.serverTimestamp(),
                      });

                      console.log("Image saved to Firestore:", file.name);

                      uploaded++;
                      const progress = Math.round(
                        (uploaded / files.length) * 100
                      );
                      const progressTextEl =
                        document.getElementById("progressText");
                      if (progressTextEl) progressTextEl.textContent = progress;

                      if (uploaded === files.length) {
                        imageInput.value = "";
                        uploadBtn.disabled = false;
                        progressDiv.style.display = "none";
                        showGallerySuccessMessage();
                        setTimeout(() => loadGalleryImages(), 1500);
