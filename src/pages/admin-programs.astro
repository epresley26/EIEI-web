            <script is:inline>
              // Google Drive / Enable Editing removed: related UI and OAuth flows deleted.
              // programs removal
              let editingProgramId = null;
              let quillEditor = null;

              // Initialize Quill immediately since this script is at the end of the body
              if(document.getElementById('postContentEditor')){
                  quillEditor = new Quill('#postContentEditor', {
                      theme: 'snow',
                      placeholder: 'Full post content',
                      modules: {
                          toolbar: [
                              [{ 'header': [1, 2, 3, false] }],
                              ['bold', 'italic', 'underline', 'strike'],
                              ['blockquote', 'code-block'],
                              [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                              [{ 'align': [] }],
                              ['link', 'image'],
                              ['clean']
                          ]
                      }
                  });
              }

              let currentUserEmail = null;
              let galleryLoadedOnce = false;

              function showAdminPanel() {
                document.getElementById("loginPrompt").style.display = "none";
                const adminPanel = document.getElementById("adminPanel");
                adminPanel.style.display = "flex"; // Changed from block to flex for scrolling
                document.getElementById("adminSidebar").style.display = "flex";

                if (currentUserEmail) {
                  // Render instantly from cache, then refresh from Firebase in background
                  renderCachedProfileInstantly();
                  loadProfileOnLogin();
                }

                // removed
              }

              function renderCachedProfileInstantly() {
                const cachedEmail = (
                  currentUserEmail ||
                  localStorage.getItem("adminUserEmail") ||
                  ""
                )
                  .trim()
                  .toLowerCase();
                const cachedName = (
                  localStorage.getItem("adminUserName") || ""
                ).trim();
                const cachedRole = (
                  localStorage.getItem("adminUserRole") || "Admin Level"
                ).trim();
                const cachedPicture = (
                  localStorage.getItem("adminUserPicture") || ""
                ).trim();

                const fullName = cachedName || cachedEmail;
                const firstName = fullName.includes(" ")
                  ? fullName.split(" ")[0]
                  : fullName.includes("@")
                  ? fullName.split("@")[0]
                  : fullName || "Admin";
                const initial = firstName.charAt(0).toUpperCase();

                const userEmailEl = document.getElementById("userEmail");
                const userRoleEl = document.getElementById("userRole");
                const profileInitialEl =
                  document.getElementById("profileInitial");
                const profileNameEl = document.getElementById("profileName");
                const profileEmailEl = document.getElementById("profileEmail");
                const profileAvatarEl = document.getElementById(
                  "profileAvatarInitial"
                );

                if (userEmailEl) userEmailEl.textContent = firstName || "Admin";
                if (userRoleEl)
                  userRoleEl.textContent = cachedRole || "Admin Level";
                if (profileInitialEl) profileInitialEl.textContent = initial;
                if (profileNameEl)
                  profileNameEl.textContent = fullName || "Admin";
                if (profileEmailEl)
                  profileEmailEl.textContent =
                    cachedEmail || "admin@example.com";
                if (profileAvatarEl) profileAvatarEl.textContent = initial;
                updateProfileAvatarUI(cachedPicture, initial);

                // Header Labels
                const hdrName = document.getElementById("userNameHeader");
                const hdrEmail = document.getElementById("userEmailHeader");
                if (hdrName) hdrName.textContent = fullName || "Administrator";
                if (hdrEmail)
                  hdrEmail.textContent =
                    cachedEmail || "admin@eieiservices.com";
              }

              async function loadProfileOnLogin() {
                try {
                  const doc = await window.firebaseDB
                    .collection("roles")
                    .doc(currentUserEmail)
                    .get();
                  let fullName = currentUserEmail;
                  let displayName = currentUserEmail;
                  let displayEmail = currentUserEmail;
                  let role = "Admin Level";
                  let profilePicture =
                    localStorage.getItem("adminUserPicture") || "";

                  if (doc.exists) {
                    const data = doc.data();
                    if (data.name && data.name.trim()) {
                      fullName = data.name.trim();
                    }
                    if (data.email && data.email.trim()) {
                      displayEmail = data.email.trim();
                    }
                    const accessRole = String(data.role || "").trim();
                    role =
                      String(data.jobRole || "").trim() ||
                      (accessRole.toLowerCase() === "superadmin"
                        ? "Admin Level"
                        : accessRole || "Admin Level");
                    profilePicture =
                      String(data.profilePicture || "").trim() ||
                      profilePicture;
                  }

                  // Prefer role/picture from team collection when available
                  const teamProfile = await getTeamProfileData(
                    currentUserEmail,
                    fullName
                  );
                  if (teamProfile.role) role = teamProfile.role;
                  if (teamProfile.picture) profilePicture = teamProfile.picture;

                  // Display first name from stored full name (or email prefix as fallback)
                  if (fullName.includes(" ")) {
                    displayName = fullName.split(" ")[0];
                  } else if (fullName.includes("@")) {
                    displayName = fullName.split("@")[0];
                  } else {
                    displayName = fullName;
                  }

                  // Update header with first name or email, and role
                  const userEmailEl = document.getElementById("userEmail");
                  const userRoleEl = document.getElementById("userRole");
                  const profileInitialEl =
                    document.getElementById("profileInitial");
                  const profileAvatarEl = document.getElementById(
                    "profileAvatarInitial"
                  );

                  if (userEmailEl) userEmailEl.textContent = displayName;
                  if (userRoleEl) userRoleEl.textContent = role;
                  if (profileInitialEl)
                    profileInitialEl.textContent = displayName
                      .charAt(0)
                      .toUpperCase();
                  if (profileAvatarEl)
                    profileAvatarEl.textContent = displayName
                      .charAt(0)
                      .toUpperCase();
                  updateProfileAvatarUI(
                    profilePicture,
                    displayName.charAt(0).toUpperCase()
                  );

                  // Header Labels
                  const hdrName = document.getElementById("userNameHeader");
                  const hdrEmail = document.getElementById("userEmailHeader");
                  if (hdrName)
                    hdrName.textContent = fullName || "Administrator";
                  if (hdrEmail)
                    hdrEmail.textContent =
                      currentUserEmail ||
                      displayEmail ||
                      "admin@eieiservices.com";

                  // Profile Dropdown Labels
                  const profileNameEl = document.getElementById("profileName");
                  const profileEmailEl =
                    document.getElementById("profileEmail");
                  if (profileNameEl)
                    profileNameEl.textContent = fullName || "Administrator";
                  if (profileEmailEl)
                    profileEmailEl.textContent =
                      currentUserEmail ||
                      displayEmail ||
                      "admin@eieiservices.com";

                  // Update localStorage
                  localStorage.setItem("adminUserEmail", displayEmail);
                  localStorage.setItem("adminUserName", fullName);
                  localStorage.setItem("adminUserRole", role);
                  localStorage.setItem("adminUserPicture", profilePicture);
                } catch (error) {
                  console.warn("Failed to load profile on login:", error);
                  // Fallback to email display
                  const userEmailEl = document.getElementById("userEmail");
                  const userRoleEl = document.getElementById("userRole");
                  const profileInitialEl =
                    document.getElementById("profileInitial");
                  const profileNameEl = document.getElementById("profileName");
                  const profileEmailEl =
                    document.getElementById("profileEmail");
                  const profileAvatarEl = document.getElementById(
                    "profileAvatarInitial"
                  );
                  if (userEmailEl) userEmailEl.textContent = currentUserEmail;
                  if (userRoleEl)
                    userRoleEl.textContent =
                      localStorage.getItem("adminUserRole") || "Admin Level";
                  if (profileInitialEl)
                    profileInitialEl.textContent = currentUserEmail
                      .charAt(0)
                      .toUpperCase();
                  if (profileNameEl)
                    profileNameEl.textContent =
                      localStorage.getItem("adminUserName") || currentUserEmail;
                  if (profileEmailEl)
                    profileEmailEl.textContent = currentUserEmail;
                  if (profileAvatarEl)
                    profileAvatarEl.textContent = currentUserEmail
                      .charAt(0)
                      .toUpperCase();
                  updateProfileAvatarUI(
                    localStorage.getItem("adminUserPicture") || "",
                    currentUserEmail.charAt(0).toUpperCase()
                  );
                }
              }

              async function getTeamProfileData(email, fullName = "") {
                try {
                  const teamRef = window.firebaseDB.collection("team");
                  const readPayload = (data = {}) => ({
                    role: String(data.role || "").trim(),
                    picture: String(
                      data.profilePicture || data.imageUrl || ""
                    ).trim(),
                  });

                  // 1) If team doc id is email (fast path)
                  if (email) {
                    const byId = await teamRef.doc(email).get();
                    if (byId.exists) {
                      const payload = readPayload(byId.data() || {});
                      if (payload.role || payload.picture) return payload;
                    }
                  }

                  // 2) Match team.email
                  if (email) {
                    const byEmail = await teamRef
                      .where("email", "==", email)
                      .limit(1)
                      .get();
                    if (!byEmail.empty) {
                      const payload = readPayload(byEmail.docs[0].data() || {});
                      if (payload.role || payload.picture) return payload;
                    }
                  }

                  // 3) Match full name if present
                  if (fullName) {
                    const byName = await teamRef
                      .where("name", "==", fullName)
                      .limit(1)
                      .get();
                    if (!byName.empty) {
                      const payload = readPayload(byName.docs[0].data() || {});
                      if (payload.role || payload.picture) return payload;
                    }
                  }
                } catch (teamErr) {
                  console.warn("Failed reading team profile data:", teamErr);
                }

                return { role: "", picture: "" };
              }

              async function getTeamJobRole(email, fullName = "") {
                const data = await getTeamProfileData(email, fullName);
                return data.role || "";
              }

              async function getTeamProfilePicture(email, fullName = "") {
                const data = await getTeamProfileData(email, fullName);
                return data.picture || "";
              }

              function logout() {
                localStorage.removeItem("adminUserEmail");
                firebase
                  .auth()
                  .signOut()
                  .finally(() => {
                    window.location.href = "/";
                  });
              }

              function parseJwt(token) {
                if (!token) return null;
                const parts = token.split(".");
                if (parts.length !== 3) return null;
                const json = atob(
                  parts[1].replace(/-/g, "+").replace(/_/g, "/")
                );
                try {
                  return JSON.parse(json);
                } catch (_) {
                  return null;
                }
              }

              // TAB SWITCHING
              function switchTab(tabName) {
                document
                  .querySelectorAll(".admin-tab")
                  .forEach((tab) => tab.classList.remove("active"));
                document
                  .querySelectorAll(".tab-content")
                  .forEach((content) => content.classList.remove("active"));
                document
                  .querySelectorAll(".sidebar-item")
                  .forEach((item) => item.classList.remove("active"));

                if (event && event.target) {
                  event.target.classList.add("active");
                }
                document.getElementById(tabName).classList.add("active");

                // Add active state to sidebar item
                const sidebarItems = document.querySelectorAll(".sidebar-item");
                sidebarItems.forEach((item) => {
                  if (
                    item.getAttribute("onclick") === `switchTab('${tabName}')`
                  ) {
                    item.classList.add("active");
                  }
                });

                // Load specific tab content
                if (tabName === "home") {
                  loadDashboard();
                } else if (tabName === "applications") {
                  loadApplicationsTab();
                } else if (tabName === "gallery") {
                  loadGalleryImages();
                }
              }

              // DASHBOARD
              async function loadDashboard() {
                try {
                  // Helper function to safely set element text
                  const setText = (id, value) => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = value;
                  };

                  // Run all independent queries in PARALLEL for speed
                  const [
                    programsData,
                    blogSnap,
                    toursSnap,
                    appSnap,
                    pendingTours,
                    chatsSnap,
                    newsletterSnap,
                    contactsSnap,
                    testimonialsSnap,
                    chatActiveSnap,
                    gallerySnap,
                    teamSnap,
                    jobsSnap,
                    marketplaceSnap,
                    newsletterDocsSnap,
                  ] = await Promise.all([
                    window.firebaseDB.collection("programs").get(),
                    window.firebaseDB.collection("blog").get(),
                    window.firebaseDB.collection("tourRequests").get(),
                    window.firebaseDB.collection("applications").get(),
                    window.firebaseDB
                      .collection("tourRequests")
                      .where("status", "==", "Pending")
                      .get(),
                    window.firebaseDB.collection("chats").get(),
                    window.firebaseDB.collection("newsletter").get(),
                    window.firebaseDB.collection("contacts").get(),
                    window.firebaseDB.collection("testimonials").get(),
                    window.firebaseDB
                      .collection("chats")
                      .where("status", "==", "active")
                      .get(),
                    window.firebaseDB.collection("gallery").get(),
                    window.firebaseDB.collection("team").get(),
                    window.firebaseDB.collection("jobs").get(),
                    window.firebaseDB.collection("marketplace").get(),
                    window.firebaseDB.collection("newsletter").get(),
                  ]);

                  // Update Performance Metrics
                  setText("dashboardProgramsCount", programsData.size);
                  setText("dashboardBlogCount", blogSnap.size);
                  setText("dashboardToursCount", toursSnap.size);
                  setText("dashboardApplicationsCount", appSnap.size);
                  setText("dashboardPendingTours", pendingTours.size);

                  // Count unread conversations in PARALLEL
                  const unreadConversations = chatsSnap.docs.map((chatDoc) =>
                    chatDoc.ref
                      .collection("messages")
                      .where("sender", "==", "user")
                      .where("read", "==", false)
                      .get()
                  );

                  const unreadResults = await Promise.all(unreadConversations);
                  const unreadConvCount = unreadResults.filter(
                    (snap) => snap.size > 0
                  ).length;
                  setText("dashboardUnreadMessages", unreadConvCount);

                  // Update remaining metrics (already fetched in parallel above)
                  setText("dashboardMarketplaceItems", marketplaceSnap.size);
                  setText(
                    "dashboardNewsletterSubscribers",
                    newsletterSnap.size
                  );
                  setText("dashboardTotalContacts", contactsSnap.size);
                  setText("dashboardTestimonials", testimonialsSnap.size);
                  setText("dashboardActiveChats", chatsSnap.size);
                  setText("dashboardGalleryImages", gallerySnap.size);
                  setText("dashboardTeamMembers", teamSnap.size);
                  setText("dashboardOpenJobs", jobsSnap.size);

                  // Tour Request Breakdown by Status - count from already-fetched data
                  const pendingCount = pendingTours.size;
                  const contactedCount = toursSnap.docs.filter(
                    (doc) => doc.data().status === "Contacted"
                  ).length;
                  const completedCount = toursSnap.docs.filter(
                    (doc) => doc.data().status === "Completed"
                  ).length;

                  const tourBreakdownContainer = document.getElementById(
                    "dashboardTourBreakdown"
                  );
                  if (tourBreakdownContainer) {
                    const total = toursSnap.size || 1;
                    const pendingPct = ((pendingCount / total) * 100).toFixed(
                      0
                    );
                    const contactedPct = (
                      (contactedCount / total) *
                      100
                    ).toFixed(0);
                    const completedPct = (
                      (completedCount / total) *
                      100
                    ).toFixed(0);

                    tourBreakdownContainer.innerHTML = `
            <div style="margin-bottom: 1rem;">
              <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.9rem;">
                <span>Pending</span>
                <span style="font-weight: 600;">${pendingCount} (${pendingPct}%)</span>
              </div>
              <div style="background: #f0f0f0; height: 8px; border-radius: 4px; overflow: hidden;">
                <div style="background: #ff9800; height: 100%; width: ${pendingPct}%;"></div>
              </div>
            </div>
            <div style="margin-bottom: 1rem;">
              <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.9rem;">
                <span>Contacted</span>
                <span style="font-weight: 600;">${contactedCount} (${contactedPct}%)</span>
              </div>
              <div style="background: #f0f0f0; height: 8px; border-radius: 4px; overflow: hidden;">
                <div style="background: #2196F3; height: 100%; width: ${contactedPct}%;"></div>
              </div>
            </div>
            <div>
              <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.9rem;">
                <span>Completed</span>
