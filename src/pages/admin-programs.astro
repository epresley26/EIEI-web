---
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EIEI Admin - Programs Management</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Firebase SDKs (Compat) -->
    <script
      is:inline
      src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"
    ></script>
    <script
      is:inline
      src="https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js"
    ></script>
    <script
      is:inline
      src="https://www.gstatic.com/firebasejs/9.22.0/firebase-storage-compat.js"
    ></script>
    <script
      is:inline
      src="https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js"
    ></script>
    <script is:inline src="/components/firebase-init.js"></script>
    <script is:inline src="/components/admin-chat.js"></script>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"
    ></script>
    <!-- Google Sign-In removed -->
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"
    ></script>
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet" />
    <script is:inline src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0 !important;
        height: 100%;
        overflow: hidden;
        background: #ffffff !important;
      }

      .nav {
        display: none !important;
      }

      .admin-container {
        min-height: 100vh;
        background: #faf8fc;
        padding-top: 0;
        /* absolute positioning for children instead of flex to prevent gaps */
        position: relative;
        height: 100vh;
        width: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
      }

      .admin-content {
        max-width: none;
        margin: 0;
        padding: 0;
        display: flex;
        gap: 0;
        width: 100%;
        flex: 1;
        height: 100%;
      }

      .admin-sidebar {
        width: 285px;
        background: linear-gradient(180deg, #1a1024 0%, #24163a 100%);
        padding: 1.5rem 1rem;
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        box-shadow: 10px 0 30px rgba(0, 0, 0, 0.1);
        z-index: 1000;
        color: rgba(255, 255, 255, 0.92);
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
      }

      .admin-sidebar::-webkit-scrollbar {
        width: 4px;
      }

      .admin-sidebar::-webkit-scrollbar-track {
        background: transparent;
      }

      .admin-sidebar::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 10px;
      }

      .admin-sidebar::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.2);
      }

      .sidebar-logo {
        padding: 0 1rem 2rem;
        font-size: 1.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -1px;
      }

      .sidebar-section-title {
        font-size: 0.7rem;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.4);
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin: 2rem 1rem 0.75rem;
      }

      .sidebar-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0.85rem 1.25rem;
        margin: 0.2rem 0.5rem;
        border-radius: 12px;
        color: rgba(255, 255, 255, 0.7);
        text-decoration: none;
        transition: all 0.3s ease;
        cursor: pointer;
        font-weight: 500;
        font-size: 0.92rem;
      }

      .sidebar-item:hover {
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
      }

      .sidebar-item.active {
        background: linear-gradient(90deg, #7c3aed, #6d28d9);
        color: #fff;
        box-shadow: 0 4px 15px rgba(124, 58, 237, 0.3);
      }

      .sidebar-item svg {
        width: 20px;
        height: 20px;
        opacity: 0.7;
        transition: opacity 0.3s;
      }

      .sidebar-item.active svg {
        opacity: 1;
      }

      .admin-main {
        position: fixed;
        top: 72px;
        left: 285px; /* Alignment with sidebar width */
        right: 0;
        bottom: 0;
        height: calc(100vh - 72px);
        background: #fdfcff;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        z-index: 10;
        margin: 0 !important;
        margin-left: 0 !important;
        padding: 0 !important;
        width: calc(100% - 285px) !important;
      }

      .admin-header {
        height: 80px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid #f0f0f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 2.5rem;
        position: sticky;
        top: 0;
        z-index: 500;
        flex-shrink: 0;
      }

      .admin-content-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem; /* Reduced padding to minimize gaps */
        background: #fdfcff;
        width: 100%;
        box-sizing: border-box;
      }

      .calendar-day {
        width: 100%;
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        font-size: 0.75rem;
        color: #8b7ba8;
        cursor: pointer;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        background: #f0ece8;
      }

      .calendar-day:hover {
        background: rgba(124, 58, 237, 0.2);
      }

      .calendar-day.active {
        background: #7c3aed;
        color: #ffffff;
        font-weight: 600;
      }

      .sidebar-section {
        margin-bottom: 1.25rem;
        padding: 0 0.5rem;
      }

      .sidebar-section-title {
        color: #85729a;
        font-size: 0.72rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        opacity: 0.9;
      }

      .sidebar-section-list {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .sidebar-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.6rem;
        padding-left: 0.6rem;
        background: transparent;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        color: rgba(255, 255, 255, 0.92);
        transition: background 0.12s ease, color 0.12s ease;
        font-size: 0.95rem;
        position: relative;
      }

      .sidebar-item:hover {
        background: rgba(255, 255, 255, 0.03);
        color: #ffffff;
      }

      .sidebar-item.active {
        background: rgba(124, 58, 237, 0.06);
        color: #ffffff;
        font-weight: 700;
      }

      .sidebar-item.active::before {
        content: "";
        position: absolute;
        left: 8px;
        top: 10px;
        bottom: 10px;
        width: 4px;
        border-radius: 4px;
        background: linear-gradient(180deg, #7c3aed, #a855f7);
      }

      .sidebar-item-color {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        flex-shrink: 0;
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.2) inset;
      }

      /* Make inline svgs readable on dark sidebar */
      .admin-sidebar svg path,
      .admin-sidebar svg circle,
      .admin-sidebar svg rect {
        fill: rgba(255, 255, 255, 0.92) !important;
        stroke: rgba(255, 255, 255, 0.06) !important;
      }

      /* Refined profile button styling handled by inline styles to avoid selector conflicts */

      #profileInitial {
        display: inline-block;
        font-weight: 700;
        color: #fff;
      }

      #profileAvatarImage,
      #profileDropdownAvatarImage {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        display: none;
      }

      #profileButton.has-image {
        background: transparent !important;
        overflow: visible;
      }

      .pd-avatar.has-image {
        background: transparent;
        overflow: hidden;
      }

      .sidebar-nav {
        display: flex;
        flex-direction: column;
      }

      /* Header / main layout */
      /* Header / main layout */
      .admin-header {
        position: fixed;
        top: 0;
        left: 285px; /* Sidebar width match */
        right: 0;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1.5rem; /* Match content padding */
        box-sizing: border-box;
        z-index: 1200;
        background: rgba(255, 255, 255, 0.95);
        border-bottom: 1px solid rgba(0, 0, 0, 0.04);
        backdrop-filter: blur(10px);
        margin: 0 !important;
        margin-left: 0 !important;
        width: calc(100% - 285px) !important;
      }

      #profileSection {
        position: relative;
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .admin-header h1 {
        margin: 0;
        padding: 0;
      }

      /* Profile dropdown */
      .profile-dropdown {
        position: absolute;
        right: 0;
        top: calc(100% + 12px);
        background: #ffffff;
        color: #222;
        min-width: 280px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        padding: 0;
        z-index: 1300;
        overflow: hidden;
        display: none !important;
        border: 1px solid rgba(0, 0, 0, 0.05);
      }

      .profile-dropdown.show {
        display: block !important;
      }

      .pd-header {
        padding: 16px;
        display: flex;
        gap: 12px;
        align-items: flex-start;
        border-bottom: 1px solid #e5e7eb;
      }

      .pd-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 1.2rem;
        flex-shrink: 0;
        position: relative;
      }

      .pd-avatar::after {
        content: "";
        position: absolute;
        bottom: 0;
        right: 0;
        width: 14px;
        height: 14px;
        background: #10b981;
        border: 3px solid white;
        border-radius: 50%;
      }

      .pd-info h4 {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
        color: #222;
      }

      .pd-info p {
        margin: 0;
        font-size: 0.85rem;
        color: #9ca3af;
      }

      .pd-menu {
        padding: 8px 0;
      }

      .pd-item {
        width: 100%;
        background: transparent;
        border: none;
        padding: 12px 16px;
        text-align: left;
        cursor: pointer;
        font-size: 0.95rem;
        color: #222;
        transition: background 0.15s ease;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
      }

      .pd-item:hover {
        background: #f3f0ff;
      }

      .pd-item-label {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 1;
      }

      .pd-icon {
        width: 20px;
        text-align: center;
        font-size: 1rem;
      }

      .pd-shortcut {
        font-size: 0.8rem;
        color: #b3b8c4;
        white-space: nowrap;
      }

      .pd-divider {
        height: 1px;
        background: #e5e7eb;
        margin: 8px 0;
      }

      /* second definition of admin-main removed as it is now consolidated above */

      /* Ensure inner tab panels fill the available main area (prevent centered gap) */
      .admin-main .tab-content > div {
        width: 100% !important;
        box-sizing: border-box;
      }

      /* duplicate sidebar block removed */

      /* GALLERY SUB-TABS */
      .gallery-tabs-nav {
        display: flex;
        gap: 0.5rem;
        background: #f3f0ff;
        padding: 0.5rem;
        border-radius: 16px;
        margin-bottom: 2rem;
        overflow-x: auto;
        scrollbar-width: none;
      }

      .gallery-tab-btn {
        padding: 0.75rem 1.25rem;
        border-radius: 12px;
        border: none;
        background: transparent;
        color: #6d28d9;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.3s ease;
      }

      .gallery-tab-btn.active {
        background: white;
        color: #7c3aed;
        box-shadow: 0 4px 12px rgba(124, 58, 237, 0.1);
      }

      .upload-section {
        background: white;
        padding: 2.5rem;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.03);
        border: 1px solid #f0f0f5;
      }

      .upload-section h2 {
        color: #2c1f4c;
        margin-top: 0;
        font-size: 1.5rem;
        font-weight: 600;
      }

      .upload-section h3 {
        color: #2c1f4c;
        font-size: 1.1rem;
        font-weight: 600;
        margin-top: 2rem;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
      }

      .form-group label {
        font-weight: 600;
        color: #2c1f4c;
        font-size: 0.95rem;
      }

      .form-group input,
      .form-group textarea,
      .form-group select {
        padding: 0.8rem;
        border: 1px solid #ddd4e8;
        border-radius: 8px;
        background: #faf8fc;
        color: #111;
        font-family: inherit;
        font-size: 1rem;
        transition: all 0.3s ease;
      }

      .form-group input:focus,
      .form-group textarea:focus,
      .form-group select:focus {
        border-color: #7c3aed;
        outline: none;
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.1);
      }

      .form-group textarea {
        resize: vertical;
        min-height: 120px;
      }

      .programs-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
      }

      .programs-list > div {
        background: white;
        border: 1px solid #e8dff5;
        border-radius: 12px;
        padding: 1.5rem;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 250px;
      }

      .programs-list > div:hover {
        border-color: #7c3aed;
        box-shadow: 0 4px 16px rgba(124, 58, 237, 0.12);
        transform: translateY(-2px);
      }

      .flex-between {
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        gap: 1.5rem;
      }

      .admin-btn {
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        border: none;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 0.95rem;
      }

      .btn-primary {
        background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
        color: white;
        box-shadow: 0 4px 12px rgba(124, 58, 237, 0.2);
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(124, 58, 237, 0.3);
        background: linear-gradient(135deg, #6d28d9 0%, #9333ea 100%);
      }

      .data-table {
        color: #2c1f4c;
        width: 100%;
        border-collapse: collapse;
      }

      .data-table thead {
        background: #f0e6ff;
      }

      .data-table th {
        color: #2c1f4c;
        padding: 1rem;
        text-align: left;
        font-weight: 600;
        border-bottom: 2px solid #e8dff5;
      }

      .data-table td {
        color: #555;
        border-color: #e8dff5;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #e8dff5;
      }

      .data-table tr:hover {
        background: #f9f7ff;
      }

      .program-card {
        background: white;
        border: 1px solid #e8dff5;
        border-radius: 12px;
        padding: 1.5rem;
        position: relative;
        transition: all 0.3s ease;
      }

      .program-card:hover {
        border-color: #7c3aed;
        box-shadow: 0 4px 16px rgba(124, 58, 237, 0.12);
      }

      .program-card h3 {
        color: #7c3aed;
        margin-bottom: 0.5rem;
        font-size: 1.1rem;
      }

      .program-card p {
        color: #7d6b8f;
        font-size: 0.9rem;
        margin-bottom: 1rem;
      }

      .program-actions {
        display: flex;
        gap: 0.5rem;
      }

      .program-actions button {
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.3s ease;
      }

      .edit-btn {
        background: #7b68ee;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .edit-btn:hover {
        background: #9a7fd0;
        transform: translateY(-2px);
      }

      .primary-btn {
        background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
        font-size: 0.95rem;
      }

      .primary-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(124, 58, 237, 0.3);
      }

      .primary-btn:active {
        transform: translateY(0);
      }

      .edit-btn {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.9rem;
      }

      .edit-btn:hover {
        background: #2563eb;
        transform: translateY(-2px);
      }

      .delete-btn {
        background: #ef4444;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.9rem;
      }

      .delete-btn:hover {
        background: #dc2626;
        transform: translateY(-2px);
      }

      .gallery-preview {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
      }

      .preview-item {
        position: relative;
        width: 200px;
        height: 200px;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        background: #f5f3ff;
        border: 1px solid #e8dff5;
        transition: all 0.3s ease;
      }

      .preview-item:hover {
        box-shadow: 0 4px 16px rgba(124, 58, 237, 0.2);
        transform: translateY(-4px);
        border-color: #7c3aed;
      }

      .preview-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .preview-item .delete-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 32px;
        height: 32px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 1.2rem;
        opacity: 0;
        transition: all 0.3s ease;
      }

      .preview-item:hover .delete-btn {
        opacity: 1;
      }

      .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 285px;
        width: calc(100% - 285px);
        height: 100%;
        background: rgba(0, 0, 0, 0.4);
        z-index: 2000;
        align-items: center;
        justify-content: center;
      }

      @media (max-width: 1024px) {
        .modal {
          left: 0;
          width: 100%;
        }
      }

      .modal-content {
        background: #faf8fc;
        border: 1px solid #ddd4e8;
        border-radius: 12px;
        max-width: 500px;
        width: 90%;
        box-shadow: 0 10px 40px rgba(124, 58, 237, 0.15);
      }

      .wide-modal-content {
        max-width: 1000px;
      }

      .blog-form-grid {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 2rem;
        padding: 2rem;
      }

      @media (max-width: 768px) {
        .blog-form-grid {
          grid-template-columns: 1fr;
        }
      }

      .modal-header {
        border-bottom: 1px solid #e8dff5;
        padding: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .modal-header h2 {
        color: #2c1f4c;
        margin: 0;
        font-size: 1.3rem;
        font-weight: 600;
      }

      .close-btn {
        background: none;
        border: none;
        color: #7d6b8f;
        font-size: 1.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .close-btn:hover {
        color: #2c1f4c;
      }

      .modal.active {
        display: flex;
      }

      .success-message {
        background: #d1fae5;
        border-left: 4px solid #10b981;
        color: #047857;
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 1rem;
        display: none;
        font-weight: 500;
      }

      .success-message.show {
        display: block;
        animation: slideDown 0.3s ease;
      }

      .error-message {
        background: #fee2e2;
        border-left: 4px solid #ef4444;
        color: #991b1b;
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 1rem;
