              function downloadCareerResume(appId, filename) {
                window.firebaseDB
                  .collection("careerApplications")
                  .doc(appId)
                  .get()
                  .then((doc) => {
                    const data = doc.data();
                    if (!data || !data.resumeData) {
                      alert("Resume not found");
                      return;
                    }

                    try {
                      // Check if it's a base64 data URL
                      if (data.resumeData.startsWith("data:")) {
                        const link = document.createElement("a");
                        link.href = data.resumeData;
                        link.download = filename || "resume.pdf";
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                      } else {
                        // Fallback for direct URLs
                        window.open(data.resumeData, "_blank");
                      }
                    } catch (err) {
                      console.error("Error processing resume:", err);
                      alert("Error downloading resume");
                    }
                  })
                  .catch((error) => {
                    console.error("Error downloading resume:", error);
                    alert("Error downloading resume: " + error.message);
                  });
              }

              function downloadJobResume(appId, filename) {
                window.firebaseDB
                  .collection("job_applications")
                  .doc(appId)
                  .get()
                  .then((doc) => {
                    const data = doc.data();
                    if (!data) {
                      alert("Application not found");
                      return;
                    }

                    // Try base64 data first, then fall back to URL
                    const resumeData = data.resumeData || data.resumeUrl;
                    if (!resumeData) {
                      alert("Resume not found for this application");
                      return;
                    }

                    try {
                      // Check if it's a base64 data URL
                      if (resumeData.startsWith("data:")) {
                        const link = document.createElement("a");
                        link.href = resumeData;
                        link.download = filename || "resume.pdf";
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                      } else {
                        // Fallback for direct URLs
                        window.open(resumeData, "_blank");
                      }
                    } catch (err) {
                      console.error("Error processing resume:", err);
                      alert("Error downloading resume");
                    }
                  })
                  .catch((error) => {
                    console.error("Error downloading resume:", error);
                    alert("Error downloading resume: " + error.message);
                  });
              }

