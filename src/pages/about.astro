---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About Us - EIEI">
  <style is:global>
    /* --- Premium Modern Styling for About --- */

    /* HERO SLIDESHOW */
    .about-hero {
      position: relative;
      width: 100%;
      min-height: 80vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      overflow: hidden;
      padding: 9rem 2rem 6rem;
    }

    .about-hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      z-index: -2;
      animation: aboutHeroSlide 21s infinite blur;
      filter: blur(2px) contrast(1.1);
      transform: scale(1.05); /* hide blur edges */
    }

    .about-hero::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(
        135deg,
        rgba(15, 23, 42, 0.9) 0%,
        rgba(37, 99, 235, 0.6) 50%,
        rgba(15, 23, 42, 0.95) 100%
      );
    }

    @keyframes aboutHeroSlide {
      0%,
      33.333% {
        background-image: url("/images/slide1.jpg");
      }
      33.334%,
      66.666% {
        background-image: url("/images/slide2.jpg");
      }
      66.667%,
      100% {
        background-image: url("/images/slide3.jpg");
      }
    }

    .hero-content {
      position: relative;
      z-index: 1;
      max-width: 1200px;
      text-align: center;
      animation: fadeInUp 1s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .hero-content h1 {
      font-size: clamp(3rem, 5vw, 4.5rem);
      font-weight: 900;
      letter-spacing: -1px;
      margin-bottom: 1.5rem;
      background: linear-gradient(to right, #ffffff, #93c5fd);
      -webkit-background-clip: text;
      -webkit-text-fill-color: white;
    }

    .hero-content p {
      font-size: 1.25rem;
      line-height: 1.8;
      color: #e2e8f0;
      max-width: 800px;
      margin: 0 auto 2.5rem;
    }

    .hero-badges {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 3rem;
    }

    .badge {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 0.6rem 1.2rem;
      border-radius: 50px;
      font-weight: 600;
      letter-spacing: 0.5px;
      font-size: 0.9rem;
    }

    /* TYPOGRAPHY & LAYOUT */
    .section-wrap {
      padding: 7rem 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 3rem;
      font-weight: 900;
      color: #0f172a;
      text-align: center;
      margin-bottom: 1rem;
      letter-spacing: -1px;
    }

    .section-subtitle {
      text-align: center;
      font-size: 1.2rem;
      color: #475569;
      max-width: 700px;
      margin: 0 auto 4rem;
      line-height: 1.6;
    }

    /* MISSION SECTION */
    .mission-box {
      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
      border-radius: 24px;
      padding: 4rem;
      color: white;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
      position: relative;
      overflow: hidden;
    }

    .mission-box::before {
      content: '"';
      position: absolute;
      top: -20px;
      left: 30px;
      font-size: 12rem;
      color: rgba(255, 255, 255, 0.05);
      font-family: serif;
      line-height: 1;
    }

    .mission-box p {
      font-size: 1.3rem;
      line-height: 1.8;
      color: #cbd5e1;
      margin-bottom: 1.5rem;
      position: relative;
      z-index: 1;
    }

    /* VALUES GRID */
    .values-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
    }

    .value-box {
      background: #ffffff;
      border-radius: 20px;
      padding: 2.5rem;
      border: 1px solid #e2e8f0;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
      transition: all 0.4s ease;
      position: relative;
      overflow: hidden;
    }

    .value-box:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 40px rgba(37, 99, 235, 0.1);
      border-color: #bfdbfe;
    }

    .value-box::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: var(--brand-orange);
      transform: scaleY(0);
      transition: transform 0.4s ease;
      transform-origin: bottom;
    }

    .value-box:hover::before {
      transform: scaleY(1);
    }

    .value-box h3 {
      font-size: 1.4rem;
      color: #2563eb;
      margin-bottom: 1rem;
      font-weight: 800;
    }

    .value-box p {
      color: #475569;
      line-height: 1.6;
    }

    /* WHY EIEI SECTION */
    .why-bg {
      background: #f8fafc;
      padding: 0rem 0;
    }

    .why-grid {
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      gap: 4rem;
      align-items: start;
    }

    @media (max-width: 900px) {
      .why-grid {
        grid-template-columns: 1fr;
      }
    }

    .why-sidebar {
      position: sticky;
      top: 100px;
    }

    .why-sidebar h3 {
      font-size: 2.2rem;
      color: #0f172a;
      line-height: 1.2;
      margin-bottom: 1.5rem;
    }

    .impact-card {
      background: #ffffff;
      border-left: 5px solid var(--brand-orange);
      padding: 2rem;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
      margin-bottom: 2rem;
    }

    .impact-card h4 {
      font-size: 1.2rem;
      color: #2563eb;
      margin-bottom: 1rem;
      font-weight: 700;
    }

    .impact-card ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .impact-card li {
      position: relative;
      padding-left: 1.8rem;
      margin-bottom: 0.8rem;
      color: #334155;
      line-height: 1.6;
    }

    .impact-card li::before {
      content: "→";
      position: absolute;
      left: 0;
      color: var(--brand-orange);
      font-weight: bold;
    }

    /* PROMISE SECTION */
    .promise-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 2rem;
    }

    .promise-card {
      text-align: center;
      padding: 3rem 2rem;
      background: #ffffff;
      border-radius: 24px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
      border: 1px solid #e2e8f0;
      transition: all 0.3s ease;
    }

    .promise-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 40px rgba(37, 99, 235, 0.08);
      border-color: #bfdbfe;
    }

    .promise-icon {
      font-size: 3rem;
      margin-bottom: 1.5rem;
      display: inline-block;
      padding: 1rem;
      background: #eff6ff;
      border-radius: 20px;
    }

    .promise-card h3 {
      font-size: 1.5rem;
      color: #0f172a;
      margin-bottom: 1rem;
      font-weight: 800;
    }

    .promise-card p {
      color: #475569;
      line-height: 1.6;
    }

    /* TEAM SECTION SPECIFIC STYLES */
    .team-grid {
      display: flex;
      flex-direction: column;
      gap: 4rem;
    }

    .team-section {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .team-section-title {
      font-size: 2rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 4px solid var(--brand-orange);
      display: inline-block;
    }

    .team-section-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2.5rem;
    }

    .team-card {
      position: relative;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      height: 400px;
      background: #f1f5f9;
    }

    .team-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 20px 40px rgba(37, 99, 235, 0.2);
    }

    .team-card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to top,
        rgba(15, 23, 42, 0.95) 0%,
        rgba(15, 23, 42, 0.5) 40%,
        transparent 100%
      );
      z-index: 2;
    }

    .team-image {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: center;
      z-index: 1;
      transition: transform 0.5s ease;
    }

    .team-card:hover .team-image {
      transform: scale(1.05);
    }

    .team-info {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      padding: 2rem;
      z-index: 3;
      text-align: left;
    }

    .team-name {
      color: #ffffff;
      font-size: 1.4rem;
      font-weight: 800;
      margin-bottom: 0.3rem;
    }

    .team-role {
      color: #fbbf24;
      font-size: 1rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .team-loading {
      text-align: center;
      padding: 4rem;
      color: #64748b;
      font-size: 1.2rem;
      font-weight: 500;
    }

    /* TEAM MODAL STYLES */
    .team-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(8px);
      z-index: 9999;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      animation: fadeIn 0.3s ease;
    }

    .team-modal.active {
      display: flex;
    }

    .team-modal-content {
      background: white;
      border-radius: 24px;
      overflow: hidden;
      max-width: 1000px;
      width: 100%;
      max-height: 85vh;
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.25);
      position: relative;
      animation: slideUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @media (max-width: 768px) {
      .team-modal-content {
        grid-template-columns: 1fr;
        overflow-y: auto;
      }
    }

    .team-modal-left {
      background: #f1f5f9;
    }

    .team-modal-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      min-height: 350px;
    }

    .team-modal-right {
      padding: 3rem;
      overflow-y: auto;
    }

    .team-modal-close {
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      background: rgba(15, 23, 42, 0.1);
      border: none;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      font-size: 1.5rem;
      color: #0f172a;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }

    .team-modal-close:hover {
      background: #0f172a;
      color: #ffffff;
    }

    .team-modal-name {
      font-size: 2.5rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 0.5rem;
      line-height: 1.1;
    }

    .team-modal-role {
      color: var(--brand-orange);
      font-size: 1.1rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 2rem;
    }

    .team-modal-bio {
      color: #475569;
      line-height: 1.8;
      font-size: 1.05rem;
      white-space: pre-wrap;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <!-- HERO SECTION -->
  <section class="about-hero">
    <div class="hero-content">
      <h1>The Education Institute for Early Intervention</h1>
      <p>
        We partner with childcare programs, families, and communities to build
        inclusive environments where every child with diverse abilities can
        learn, play, and thrive from the very beginning.
      </p>

      <div class="hero-badges">
        <span class="badge">Inclusive Early Intervention</span>
        <span class="badge">Family &amp; Educator Support</span>
        <span class="badge">Research‑informed Practice</span>
      </div>

      <div
        style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;"
      >
        <a href="/services" class="primary-btn">Explore Our Services</a>
        <a
          href="/contact-us"
          class="primary-btn"
          style="background: white; color: #0f172a;">Talk with Our Team</a
        >
      </div>
    </div>
  </section>

  <!-- OUR MISSION -->
  <section class="section-wrap">
    <div class="mission-box">
      <h2 style="font-size: 2.5rem; margin-bottom: 1.5rem; font-weight: 800;">
        Our Mission
      </h2>
      <p>
        At The Education Institute for Early Intervention (EIEI), we address a
        critical issue in childcare—suspensions and expulsions of young
        children, often due to behavioral challenges linked to inadequate
        support for children with Individual Family Service Plans (IFSPs) or
        Individual Education Plans (IEPs).
      </p>
      <p>
        EIEI educates and empowers childcare professionals to create inclusive
        environments that foster children's development and well-being. We
        collaborate with families, educators, and community partners to drive
        meaningful change, ensuring all children receive the support they need
        to thrive.
      </p>
    </div>
  </section>

  <!-- CORE VALUES -->
  <section class="why-bg">
    <div class="section-wrap" style="padding: 0 2rem;">
      <h2 class="section-title">EIEI Core Values</h2>
      <p class="section-subtitle">
        These values guide every classroom observation, coaching session,
        training, and family conversation.
      </p>

      <div class="values-grid">
        <div class="value-box">
          <h3>Empathy</h3>
          <p>
            We understand and share the feelings of children and families,
            providing compassionate and respectful support.
          </p>
        </div>
        <div class="value-box">
          <h3>Equity</h3>
          <p>
            We ensure every child, regardless of background or ability, receives
            equal opportunities to succeed and thrive.
          </p>
        </div>
        <div class="value-box">
          <h3>Integrity</h3>
          <p>
            We maintain the highest ethical standards, ensuring trust and
            transparency in all our interactions and relationships.
          </p>
        </div>
        <div class="value-box">
          <h3>Inclusivity</h3>
          <p>
            We create an environment where every child, regardless of ability or
            background, feels welcomed and supported.
          </p>
        </div>
        <div class="value-box">
          <h3>Empowerment</h3>
          <p>
            We encourage children and families to become confident, independent
            advocates for their needs and rights.
          </p>
        </div>
        <div class="value-box">
          <h3>Engagement</h3>
          <p>
            We actively involve children, families, and educators in the
            learning process, fostering strong, meaningful connections.
          </p>
        </div>
        <div class="value-box">
          <h3>Involvement</h3>
          <p>
            We actively engage with families, educators, and the community to
            build strong partnerships and lasting change.
          </p>
        </div>
        <div class="value-box">
          <h3>Impact</h3>
          <p>
            We dedicate ourselves to making a positive and lasting difference in
            the lives of children and their families.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY EIEI -->
  <section class="section-wrap">
    <div class="why-grid">
      <div class="why-sidebar">
        <h3>Why EIEI?</h3>
        <p
          style="font-size: 1.2rem; color: #475569; line-height: 1.7; margin-bottom: 2rem;"
        >
          Addressing systemic gaps in early childhood education and support to
          stop the cycle of expulsions and suspensions.
        </p>
        <a href="/contact-us" class="primary-btn" style="width: auto;"
          >Partner With Us</a
        >
      </div>

      <div class="impact-content">
        <div class="impact-card">
          <h4>The Current Reality</h4>
          <ul>
            <li>
              Young children ages 1-5 are suspended and expelled from programs
              due to behavioral challenges.
            </li>
            <li>
              Many childcare professionals lack training to support children
              with IFSPs and IEPs.
            </li>
            <li>
              Children are never able to return to programs after expulsion.
            </li>
          </ul>
        </div>
        <div class="impact-card">
          <h4>Impact on Expelled Children</h4>
          <ul>
            <li>Miss opportunities to grow, develop, and practice skills.</li>
            <li>
              Continue developing behavior problems affecting kindergarten
              adjustments.
            </li>
            <li>
              Develop negative views towards school, teachers, and the world.
            </li>
          </ul>
        </div>
        <div class="impact-card">
          <h4>Impact on Families</h4>
          <ul>
            <li>
              Frustration with programs lacking Special Education Services
              training.
            </li>
            <li>
              Difficulty parenting, creating increased stress and financial
              challenges.
            </li>
            <li>Employment instability due to seeking alternative care.</li>
          </ul>
        </div>
        <div class="impact-card">
          <h4>Impact on Childcare Staff</h4>
          <ul>
            <li>
              Required to manage challenging behaviors without proper skills.
            </li>
            <li>
              Implicit bias leading to stress, burn-out, and low retention.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- THE PROMISE -->
  <section class="why-bg" style="background: transparent;">
    <div class="section-wrap" style="padding-top: 0;">
      <h2 class="section-title">The EIEI Promise</h2>
      <p class="section-subtitle">Our four pillars of change and support</p>

      <div class="promise-grid">
        <div class="promise-card">
          <div class="promise-icon">📚</div>
          <h3>Educate</h3>
          <p>
            Educate the workforce to provide appropriate teaching and learning
            environments to children entitled to IDEA services.
          </p>
        </div>
        <div class="promise-card">
          <div class="promise-icon">💼</div>
          <h3>Invest</h3>
          <p>
            Invest in the workforce with a commitment to impartiality and
            integrity for children.
          </p>
        </div>
        <div class="promise-card">
          <div class="promise-icon">🤝</div>
          <h3>Embrace</h3>
          <p>
            Embrace the individuality of children and celebrate their unique
            strengths and abilities.
          </p>
        </div>
        <div class="promise-card">
          <div class="promise-icon">🚀</div>
          <h3>Initiate</h3>
          <p>
            Initiate change, growth, and innovation with parents, business
            owners, stakeholders, and community partners.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- MEET THE TEAM SECTION (DYNAMIC) -->
  <section class="why-bg">
    <div class="section-wrap">
      <h2 class="section-title">Meet the Team</h2>
      <p class="section-subtitle">
        Dedicated professionals committed to transforming childcare curriculum
        and creating inclusive spaces.
      </p>

      <div id="team-grid" class="team-grid">
        <div class="team-loading">Loading team members...</div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-wrap" style="text-align: center; padding-top: 4rem;">
    <h2 class="section-title">Ready to Join Us?</h2>
    <p class="section-subtitle" style="margin-bottom: 2rem;">
      Whether you're an educator, family, or organization partner, we're here to
      support you on the journey to inclusive excellence.
    </p>
    <a href="/services" class="primary-btn">Explore Our Services</a>
  </section>

  <!-- TEAM MODAL -->
  <div class="team-modal" id="teamModal">
    <div class="team-modal-content">
      <button class="team-modal-close" id="closeTeamModal">&times;</button>
      <div class="team-modal-left">
        <img
          class="team-modal-image"
          id="modalImage"
          src=""
          alt="Team Member"
        />
      </div>
      <div class="team-modal-right">
        <h2 class="team-modal-name" id="modalName"></h2>
        <div class="team-modal-role" id="modalRole"></div>
        <div class="team-modal-bio" id="modalBio"></div>
      </div>
    </div>
  </div>

  <script is:inline>
    // Load team members dynamically from Firestore
    async function loadTeamMembers() {
      try {
        console.log("Attempting to load team members from Firestore...");
        const snapshot = await window.firebaseDB.collection("team").get();
        console.log(
          "Firestore query completed, found " + snapshot.size + " documents"
        );
        const teamMembers = snapshot.docs.map((doc) => {
          return { id: doc.id, ...doc.data() };
        });

        renderTeamGrid(teamMembers);
      } catch (error) {
        console.error("Error loading team members:", error);
        const teamGrid = document.getElementById("team-grid");
        if (teamGrid) {
          teamGrid.innerHTML =
            '<div class="team-loading">Error loading team members: ' +
            error.message +
            "</div>";
        }
      }
    }

    function renderTeamGrid(members) {
      const container = document.getElementById("team-grid");
      if (!container) return;

      if (members.length === 0) {
        container.innerHTML =
          '<div class="team-loading">No team members added yet</div>';
        return;
      }

      const groupedMembers = {
        founder: [],
        executive: [],
        staff: [],
      };

      members.forEach((member) => {
        const section = (member.section || "staff").toLowerCase();
        if (groupedMembers.hasOwnProperty(section)) {
          groupedMembers[section].push(member);
        } else {
          groupedMembers.staff.push(member);
        }
      });

      container.innerHTML = "";
      const sectionOrder = ["founder", "executive", "staff"];
      const sectionLabels = {
        founder: "Founder",
        executive: "Executive Team",
        staff: "Staff",
      };

      let cardIndex = 0;

      sectionOrder.forEach((sectionKey) => {
        const sectionMembers = groupedMembers[sectionKey];
        if (sectionMembers.length === 0) return;

        const sectionDiv = document.createElement("div");
        sectionDiv.className = "team-section";

        const sectionTitle = document.createElement("h3");
        sectionTitle.className = "team-section-title";
        sectionTitle.textContent = sectionLabels[sectionKey];
        sectionDiv.appendChild(sectionTitle);

        const gridDiv = document.createElement("div");
        gridDiv.className = "team-section-grid";

        sectionMembers.forEach((member) => {
          const currentCardIndex = cardIndex;
          cardIndex++;

          setTimeout(() => {
            const card = document.createElement("div");
            card.className = "team-card";

            let imageUrl = member.imageUrl || "images/team/default.jpg";
            if (imageUrl.includes("imgbb.com")) {
              imageUrl = imageUrl.replace(/\/c\/\d+x\d+/, "/c/400x500"); // Higher res version for bigger cards
            }

            card.innerHTML = `
              <img src="${imageUrl}" alt="${member.name}" class="team-image" loading="lazy" onerror="this.src='/images/team/default.jpg'">
              <div class="team-info">
                <div class="team-name">${member.name}</div>
                <div class="team-role">${member.role}</div>
              </div>
            `;
            card.addEventListener("click", () => openTeamModal(member));
            gridDiv.appendChild(card);
          }, currentCardIndex * 40);
        });

        sectionDiv.appendChild(gridDiv);
        container.appendChild(sectionDiv);
      });
    }

    function openTeamModal(member) {
      const modal = document.getElementById("teamModal");
      if (!modal) return;

      let imageUrl = member.imageUrl || "images/team/default.jpg";
      document.getElementById("modalImage").src = imageUrl;
      document.getElementById("modalImage").alt = member.name;
      document.getElementById("modalName").textContent = member.name;
      document.getElementById("modalRole").textContent = member.role;
      document.getElementById("modalBio").textContent =
        member.bio || "No bio available.";

      modal.classList.add("active");
    }

    function closeTeamModal() {
      const modal = document.getElementById("teamModal");
      if (modal) {
        modal.classList.remove("active");
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      const modal = document.getElementById("teamModal");
      if (modal) {
        const closeBtn = modal.querySelector(".team-modal-close");
        if (closeBtn) {
          closeBtn.addEventListener("click", closeTeamModal);
        }

        modal.addEventListener("click", (e) => {
          if (e.target === modal) {
            closeTeamModal();
          }
        });
      }

      setTimeout(initTeamLoading, 500);
    });

    let attemptCount = 0;
    const maxAttempts = 15;

    function initTeamLoading() {
      if (typeof window.firebaseDB !== "undefined" && window.firebaseDB) {
        console.log("Firebase DB ready, loading team members");
        loadTeamMembers();
      } else {
        attemptCount++;
        if (attemptCount < maxAttempts) {
          setTimeout(initTeamLoading, 1000);
        } else {
          console.error("Firebase DB initialization timeout");
        }
      }
    }
  </script>
</Layout>
