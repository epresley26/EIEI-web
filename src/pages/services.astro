---
import Layout from "../layouts/Layout.astro";

const programsData = [
  {
    id: "career-development",
    name: "Career Development Program",
    description:
      "Advance your career through our PA Department of Labor Registered Apprenticeship. Earn while you learn with paid on-the-job training.",
    link: "/career-development",
    icon: "🎓",
    image: "/images/car.jpg",
    benefits: [
      "Registered Apprenticeship",
      "Paid on-the-job training",
      "Nationally recognized credentials",
      "Career growth pathways",
    ],
  },
  {
    id: "training-development",
    name: "Training & Professional Development",
    description:
      "Empowering educators to expand their knowledge of special education and inclusive practices.",
    link: "/training-development",
    icon: "🎓",
    image: "/images/training.jpg",
    benefits: [
      "Expert training",
      "Custom workshops",
      "Ongoing coaching",
      "Certification",
    ],
  },
  {
    id: "community-programs",
    name: "Community Programs & Partnerships",
    description:
      "Supporting 20+ Early Childhood Education programs through our Pre-K Counts partnership.",
    link: "/community-programs",
    icon: "🤝",
    image: "/images/gen_community.png",
    benefits: [
      "20+ partner programs",
      "Training support",
      "Quality improvement",
      "Grant funded",
    ],
  },
  {
    id: "family-empowerment",
    name: "Family Empowerment",
    description:
      "Join our vibrant online community where families and educators come together for support.",
    link: "/family-empowerment",
    icon: "❤️",
    image: "/images/gen_family.png",
    benefits: [
      "Support groups",
      "Workshops",
      "Valuable resources",
      "Community connection",
    ],
  },
  {
    id: "early-intervention",
    name: "Early Intervention & Behavioral Health",
    description:
      "Free to low-cost services for children ages 3-5 with comprehensive classroom and in-home support.",
    link: "/early-intervention",
    icon: "🧩",
    image: "/images/early.jpg",
    benefits: [
      "Ages 3-5 inclusive",
      "Certified staff",
      "In-home & school",
      "Therapy support",
    ],
  },
  {
    id: "supporting-inclusions",
    name: "Supporting Inclusions Through Affiliates",
    description:
      "Strategic partnerships with organizations committed to inclusive education and community support.",
    link: "/supporting-inclusions",
    icon: "🌟",
    image: "/images/gen_supporting.png",
    benefits: [
      "Strategic partnerships",
      "Resource sharing",
      "Capacity building",
      "Collaboration framework",
    ],
  },
  {
    id: "cacfp-initiative",
    name: "The CACFP Initiative",
    description:
      "Transforming lives one meal at a time by helping family and group childcare providers deliver nutritious meals.",
    link: "/CACFP",
    icon: "🥗",
    image: "/images/gen_cacfp.png",
    benefits: [
      "Administrative sponsorship",
      "Nutrition education",
      "Food health security",
      "Support for marginalized",
    ],
  },
];
---

<style>
    /* Premium Modern Styling for Services */

    /* HERO SECTION */
    .services-hero {
      position: relative;
      width: 100%;
      min-height: 45vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 10rem 2rem 5rem;
      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
      color: white;
      text-align: center;
      overflow: hidden;
    }

    .services-hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      opacity: 0.5;
      z-index: 1;
    }

    .services-hero-content {
      position: relative;
      z-index: 2;
      max-width: 800px;
      margin: 0 auto;
    }

    .services-hero h1 {
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 900;
      line-height: 1.1;
      margin-bottom: 1.5rem;
      letter-spacing: -1px;
    }

    .services-hero p {
      font-size: 1.25rem;
      font-weight: 400;
      opacity: 0.9;
      line-height: 1.6;
    }

    /* SERVICES LAYOUT BASE */
    .services-layout {
      padding: 6rem 2rem;
      background: #f8fafc;
      min-height: 50vh;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
      gap: 2.5rem;
      max-width: 1400px;
      margin: 0 auto;
    }

    /* PROGRAM CARDS */
    .program-card {
      background: white;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
      border: 1px solid #e2e8f0;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
      position: relative;
    }

    .program-card::after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 6px;
      background: linear-gradient(90deg, #f97316, #dc2626);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
      z-index: 5;
    }

    .program-image-wrap {
      width: 100%;
      height: 220px;
      position: relative;
      overflow: hidden;
      flex-shrink: 0;
    }

    .program-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s ease;
    }

    .program-card:hover .program-image {
      transform: scale(1.05);
    }

    .program-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 40px rgba(37, 99, 235, 0.1);
      border-color: #cbd5e1;
    }

    .program-card:hover::after {
      transform: scaleX(1);
    }

    .program-header {
      padding: 3rem 2.5rem 1.5rem;
      border-bottom: 1px dashed #e2e8f0;
      position: relative;
    }

    .program-icon {
      position: absolute;
      top: -30px;
      left: 2.5rem;
      width: 60px;
      height: 60px;
      background: white;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
      z-index: 10;
    }

    .program-header h3 {
      font-size: 1.5rem;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.3;
      margin-bottom: 0.8rem;
    }

    .program-desc {
      color: #475569;
      font-size: 1.05rem;
      line-height: 1.6;
    }

    .program-body {
      padding: 2rem 2.5rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      background: #f8fafc;
    }

    .benefits-title {
      font-size: 0.9rem;
      text-transform: uppercase;
      font-weight: 700;
      color: #64748b;
      margin-bottom: 1rem;
      letter-spacing: 0.5px;
    }

    .benefits-list {
      list-style: none;
      padding: 0;
      margin: 0 0 2rem 0;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      flex-grow: 1;
    }

    .benefits-list li {
      position: relative;
      padding-left: 1.8rem;
      color: #334155;
      font-size: 0.95rem;
      line-height: 1.4;
    }

    .benefits-list li::before {
      content: "✓";
      position: absolute;
      left: 0;
      top: 0;
      color: #f97316;
      font-weight: 900;
    }

    .learn-more-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      background: white;
      color: #0f172a;
      padding: 1rem;
      border-radius: 12px;
      text-decoration: none;
      font-weight: 700;
      font-size: 1rem;
      border: 2px solid #e2e8f0;
      transition: all 0.3s ease;
      margin-top: auto;
    }

    .learn-more-btn:hover {
      background: #0f172a;
      color: white;
      border-color: #0f172a;
    }

    @media (max-width: 768px) {
      .services-grid {
        grid-template-columns: 1fr;
      }
      .services-hero {
        padding-top: 8rem;
        min-height: 40vh;
      }
      .program-header {
        padding: 2rem 1.5rem 1rem;
      }
      .program-body {
        padding: 1.5rem;
      }
    }
  </style>

<Layout title="Services & Programs - EIEI">


  <!-- HERO SECTION -->
  <section class="services-hero">
    <div class="services-hero-content">
      <h1>Our Services & Programs</h1>
      <p>
        Comprehensive early intervention and special education services designed
        to empower children, families, and communities.
      </p>
    </div>
  </section>

  <!-- SERVICES GRID -->
  <div class="services-layout">
    <div class="services-grid">
      {
        programsData.map((program) => (
          <div class="program-card">
            <div class="program-image-wrap">
              <img
                src={program.image}
                alt={program.name}
                class="program-image"
                loading="lazy"
              />
            </div>
            <div class="program-header">
              <div class="program-icon">{program.icon}</div>
              <h3>{program.name}</h3>
              <div class="program-desc">{program.description}</div>
            </div>
            <div class="program-body">
              <div class="benefits-title">Key Advantages</div>
              <ul class="benefits-list">
                {program.benefits.map((benefit) => (
                  <li>{benefit}</li>
                ))}
              </ul>
              <a href={program.link} class="learn-more-btn">
                Explore Program &rarr;
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
