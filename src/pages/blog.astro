---
import Layout from '../layouts/Layout.astro';
---

<Layout title="EIEI Blog & News">
  <style is:global>
    /* --- Premium Modern Styling for Blog --- */
    
    .blog-hero {
      position: relative;
      width: 100%;
      min-height: 40vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 10rem 2rem 5rem;
      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
      color: white;
      text-align: center;
      overflow: hidden;
    }

    .blog-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      opacity: 0.5;
      z-index: 1;
    }

    .blog-hero-content {
      position: relative;
      z-index: 2;
      max-width: 800px;
      margin: 0 auto;
    }

    .blog-hero h1 {
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 900;
      line-height: 1.1;
      margin-bottom: 1.5rem;
      letter-spacing: -1px;
    }

    .blog-hero p {
      font-size: 1.25rem;
      font-weight: 400;
      opacity: 0.9;
      line-height: 1.6;
    }

    /* FILTERS */
    .filter-container {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
      padding: 3rem 2rem;
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
    }

    .type-filter-btn {
      padding: 0.75rem 2rem;
      border: 2px solid transparent;
      border-radius: 50px;
      background: white;
      color: #475569;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .type-filter-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(37, 99, 235, 0.15);
      color: #2563eb;
    }

    .type-filter-btn.active {
      background: #2563eb;
      color: white;
      border-color: #2563eb;
      box-shadow: 0 8px 25px rgba(37, 99, 235, 0.3);
    }

    /* BLOG GRID */
    .blog-layout {
      padding: 5rem 2rem;
      background: #f8fafc;
      min-height: 50vh;
    }

    .blog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .blog-card {
      background: white;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.04);
      border: 1px solid #e2e8f0;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .blog-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 40px rgba(37, 99, 235, 0.15);
    }

    .blog-image-wrap {
      width: 100%;
      height: 200px;
      position: relative;
      overflow: hidden;
    }

    .blog-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s ease;
    }

    .blog-card:hover .blog-image {
      transform: scale(1.05);
    }

    .blog-tag {
      position: absolute;
      top: 1rem;
      left: 1rem;
      background: rgba(255,255,255,0.95);
      color: #2563eb;
      padding: 0.3rem 0.8rem;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      backdrop-filter: blur(4px);
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .blog-content {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .blog-date {
      font-size: 0.85rem;
      color: #64748b;
      margin-bottom: 0.8rem;
      font-weight: 500;
    }

    .blog-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.4;
      margin-bottom: 1rem;
    }

    .blog-excerpt {
      color: #475569;
      line-height: 1.6;
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
      flex-grow: 1;
    }

    .read-more-btn {
      align-self: flex-start;
      background: transparent;
      color: #2563eb;
      font-weight: 700;
      font-size: 1rem;
      border: none;
      padding: 0;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transition: gap 0.3s ease;
    }

    .read-more-btn::after {
      content: '→';
      transition: transform 0.3s ease;
    }

    .read-more-btn:hover {
      gap: 0.8rem;
    }

    .loading-text {
      grid-column: 1 / -1;
      text-align: center;
      padding: 4rem;
      font-size: 1.2rem;
      color: #64748b;
      font-weight: 600;
    }

    /* FULL POST MODAL */
    .post-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transition: all 0.4s ease;
      padding: 2rem;
    }

    .post-modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .post-modal-container {
      background: white;
      width: 100%;
      max-width: 1100px;
      height: 80vh;
      border-radius: 24px;
      overflow: hidden;
      display: grid;
      grid-template-columns: 4fr 6fr;
      transform: translateY(20px) scale(0.98);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 30px 60px rgba(0,0,0,0.3);
    }

    .post-modal-overlay.active .post-modal-container {
      transform: translateY(0) scale(1);
    }

    .post-modal-header {
      position: relative;
      width: 100%;
      height: 100%;
      background: #f1f5f9;
      border-right: 1px solid #e2e8f0;
    }

    .post-modal-hero-image {
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: #f8fafc;
    }

    .post-modal-close {
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      background: #f1f5f9;
      color: #0f172a;
      border: none;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      font-size: 1.5rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
      z-index: 10;
    }

    .post-modal-close:hover {
      background: #e2e8f0;
      transform: scale(1.05);
    }

    .post-modal-body {
      padding: 3rem 4rem;
      overflow-y: auto;
      background: white;
      height: 100%;
      position: relative;
    }

    .post-modal-title {
      font-size: 2.5rem;
      font-weight: 900;
      color: #0f172a;
      line-height: 1.2;
      margin-bottom: 1rem;
    }

    .post-modal-meta {
      display: flex;
      gap: 1.5rem;
      align-items: center;
      margin-bottom: 2.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid #e2e8f0;
      font-size: 1rem;
    }

    .post-modal-type {
      color: #2563eb;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .post-modal-date {
      color: #64748b;
    }

    .post-modal-content {
      font-size: 1.15rem;
      line-height: 1.8;
      color: #334155;
      white-space: pre-wrap;
      word-break: break-word;
    }
    
    @media (max-width: 768px) {
      .post-modal-overlay { padding: 1rem; }
      .post-modal-container { 
        display: flex; 
        flex-direction: column; 
        height: 90vh;
      }
      .post-modal-header { height: 250px; border-right: none; border-bottom: 1px solid #e2e8f0; }
      .post-modal-body { padding: 2rem; }
      .post-modal-title { font-size: 1.8rem; }
    }
  </style>

  <!-- HERO SECTION -->
  <section class="blog-hero">
    <div class="blog-hero-content">
      <h1>Helpful Articles & Stories</h1>
      <p>Discover educational resources, inspiring stories, and guidance to support you on your early intervention journey. Stay updated with our latest insights.</p>
    </div>
  </section>

  <!-- FILTER BAR -->
  <div class="filter-container">
    <button class="type-filter-btn active" onclick="filterByType('All')" data-type="All">All Posts</button>
    <button class="type-filter-btn" onclick="filterByType('Blog')" data-type="Blog">Blog</button>
    <button class="type-filter-btn" onclick="filterByType('News')" data-type="News">News</button>
    <button class="type-filter-btn" onclick="filterByType('Event')" data-type="Event">Events</button>
  </div>

  <!-- BLOG GRID -->
  <div class="blog-layout">
    <div class="blog-grid" id="blogCards">
      <div class="loading-text">Loading the latest updates...</div>
    </div>
  </div>

  <!-- POST MODAL TEMPLATE (Rendered via JS logic) -->
  <div class="post-modal-overlay" id="postModalOverlay">
    <div class="post-modal-container">
      <div class="post-modal-header">
        <img id="postModalImage" src="" alt="Post Header" class="post-modal-hero-image">
      </div>
      <div class="post-modal-body">
        <button class="post-modal-close" onclick="closePostModal()">✕</button>
        <h2 id="postModalTitle" class="post-modal-title"></h2>
        <div class="post-modal-meta">
          <span id="postModalTypeLabel" class="post-modal-type"></span>
          <span id="postModalDateLabel" class="postModalDate"></span>
        </div>
        <div id="postModalText" class="post-modal-content"></div>
      </div>
    </div>
  </div>

  <!-- JAVASCRIPT LOGIC -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      waitForFirebase();
    });

    let allPosts = [];

    async function loadPosts() {
      const container = document.getElementById('blogCards');
      if (!window.firebaseDB || typeof window.firebaseDB.collection !== 'function') {
        container.innerHTML = '<div class="loading-text">Firebase is not initialized. Check your connection.</div>';
        return;
      }

      container.innerHTML = '<div class="loading-text">Loading posts...</div>';

      try {
        let snap;
        try {
          snap = await window.firebaseDB.collection('posts').orderBy('createdAt', 'desc').get();
        } catch (orderErr) {
          snap = await window.firebaseDB.collection('posts').get();
        }

        let posts = snap.docs.map(d => ({ id: d.id, ...d.data() }));
        posts = posts.sort((a, b) => toMillis(b.createdAt) - toMillis(a.createdAt));
        allPosts = posts;
        renderPosts(posts);
      } catch (e) {
        container.innerHTML = '<div class="loading-text">Unable to load posts. Please try again later.</div>';
      }
    }

    function renderPosts(posts) {
      const container = document.getElementById('blogCards');
      container.innerHTML = '';

      if (!posts.length) {
        container.innerHTML = '<div class="loading-text">No posts available for this category yet. Check back soon!</div>';
        return;
      }

      posts.forEach((post, index) => {
        setTimeout(() => {
          const type = post.type || post.postType || 'Blog';

          let date = 'No date';
          if (post.createdAt) {
            try {
              let dateObj = (typeof post.createdAt.toDate === 'function') ? post.createdAt.toDate() : new Date(post.createdAt);
              date = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
            } catch { date = ''; }
          }

          let imageUrl = post.imageUrl || '/images/slide1.jpg'; // Fallback to aesthetic image
          if (imageUrl.includes('imgbb.com')) {
            imageUrl = imageUrl.replace(/\/c\/\d+x\d+/, '/c/600x400');
          }

          const excerpt = post.excerpt || (post.content ? post.content.slice(0, 130) + '...' : 'Read more about this post...');

          const card = document.createElement('div');
          card.className = 'blog-card';
          card.setAttribute('data-type', type);
          card.innerHTML = `
            <div class="blog-image-wrap">
              <span class="blog-tag">${type}</span>
              <img src="${imageUrl}" class="blog-image" loading="lazy" onerror="this.src='/images/slide1.jpg'">
            </div>
            <div class="blog-content">
              <div class="blog-date">${date}</div>
              <h3 class="blog-title">${post.title || 'Untitled Post'}</h3>
              <p class="blog-excerpt">${escapeHtml(excerpt)}</p>
              <button class="read-more-btn" onclick="openBlogPostModal('${post.id}')">Read Article</button>
            </div>
          `;
          container.appendChild(card);
        }, index * 40);
      });
    }

    function filterByType(type) {
      const buttons = document.querySelectorAll('.type-filter-btn');
      buttons.forEach(btn => {
        if (btn.getAttribute('data-type') === type) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      if (type === 'All') {
        renderPosts(allPosts);
      } else {
        renderPosts(allPosts.filter(post => (post.type || post.postType || 'Blog') === type));
      }
    }

    async function openBlogPostModal(id) {
      if (!window.firebaseDB) return;
      try {
        const docSnap = await window.firebaseDB.collection('posts').doc(id).get();
        if (!docSnap || (typeof docSnap.exists === 'function' && !docSnap.exists())) return;
        
        const post = typeof docSnap.data === 'function' ? docSnap.data() : docSnap.data;
        if (!post) return;

        document.getElementById('postModalTitle').textContent = post.title || 'Post';
        document.getElementById('postModalText').textContent = post.content || '';
        document.getElementById('postModalTypeLabel').textContent = post.type || post.postType || 'Blog';
        
        const imgEl = document.getElementById('postModalImage');
        if (post.imageUrl) {
          imgEl.src = post.imageUrl;
          imgEl.style.display = 'block';
        } else {
          imgEl.style.display = 'none';
        }

        let date = 'No date';
        if (post.createdAt) {
          try {
            let dateObj = (typeof post.createdAt.toDate === 'function') ? post.createdAt.toDate() : new Date(post.createdAt);
            date = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
          } catch {}
        }
        document.getElementById('postModalDateLabel').textContent = date;

        const overlay = document.getElementById('postModalOverlay');
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';

      } catch (e) {
        console.error('Modal error:', e);
      }
    }

    function closePostModal() {
      document.getElementById('postModalOverlay').classList.remove('active');
      document.body.style.overflow = 'auto';
    }

    // Tools
    function toMillis(value) {
      if (!value) return 0;
      try {
        if (typeof value.toMillis === 'function') return value.toMillis();
        if (typeof value.toDate === 'function') return value.toDate().getTime();
        if (value instanceof Date) return value.getTime();
        return new Date(value).getTime() || 0;
      } catch { return 0; }
    }
    function escapeHtml(str) {
      return String(str).replace(/[&<>"]/g, s => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[s]));
    }
    function waitForFirebase() {
      if (window.firebaseDB && typeof window.firebaseDB.collection === 'function') {
        loadPosts();
      } else { setTimeout(waitForFirebase, 100); }
    }

    // Modal background click close
    document.getElementById('postModalOverlay').addEventListener('click', function(e) {
      if (e.target === this) closePostModal();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closePostModal();
    });
  </script>
</Layout>
