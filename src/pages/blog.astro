---
import Layout from '../layouts/Layout.astro';
---

<Layout title="EIEI Blog & News">
  <style is:global>
    @import url('https://cdn.quilljs.com/1.3.7/quill.snow.css');

    :root {
      --blog-navy: #0f172a;
      --blog-blue: #2563eb;
      --blog-orange: #ea580c;
      --blog-muted: #64748b;
      --blog-border: #e2e8f0;
      --blog-bg: #f8fafc;
    }

    /* ── HERO ─────────────────────────── */
    .blog-hero {
      position: relative;
      min-height: 38vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 9rem 2rem 4rem;
      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
      color: #fff;
      text-align: center;
      overflow: hidden;
    }
    .blog-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .blog-hero-content { position: relative; z-index: 2; max-width: 700px; }
    .blog-hero h1 {
      font-size: clamp(2.2rem, 5vw, 3.6rem);
      font-weight: 900;
      letter-spacing: -1.5px;
      margin-bottom: 1rem;
      line-height: 1.1;
    }
    .blog-hero p { font-size: 1.1rem; opacity: .85; line-height: 1.6; }
    .blog-hero-rule {
      width: 48px; height: 4px;
      background: var(--blog-orange);
      border-radius: 2px;
      margin: 1.5rem auto 1.2rem;
    }

    /* ── FILTERS ──────────────────────── */
    .filter-bar {
      display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap;
      padding: 2rem 2rem 0;
      background: var(--blog-bg);
    }
    .filter-btn {
      padding: .55rem 1.4rem;
      border-radius: 50px;
      border: 2px solid var(--blog-border);
      background: #fff;
      color: var(--blog-muted);
      font-weight: 700; font-size: .88rem;
      cursor: pointer; transition: all .25s ease;
    }
    .filter-btn:hover { border-color: var(--blog-blue); color: var(--blog-blue); }
    .filter-btn.active {
      background: var(--blog-blue); color: #fff;
      border-color: var(--blog-blue);
      box-shadow: 0 6px 20px rgba(37,99,235,.25);
    }

    /* ── LAYOUT ───────────────────────── */
    .blog-layout {
      padding: 3rem 2rem 5rem;
      background: var(--blog-bg);
      min-height: 50vh;
    }
    .blog-inner { max-width: 1140px; margin: 0 auto; }

    /* Empty / loading */
    .blog-empty {
      text-align: center; padding: 5rem 2rem;
      color: var(--blog-muted); font-size: 1.1rem; font-weight: 600;
    }

    /* ── FEATURED POST ────────────────── */
    .featured-post {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      border-radius: 20px;
      overflow: hidden;
      background: #fff;
      box-shadow: 0 8px 40px rgba(15,23,42,.08);
      border: 1px solid var(--blog-border);
      margin-bottom: 3rem;
      cursor: pointer;
      transition: transform .3s ease, box-shadow .3s ease;
    }
    .featured-post:hover { transform: translateY(-4px); box-shadow: 0 20px 60px rgba(15,23,42,.13); }

    .featured-img-wrap {
      position: relative; overflow: hidden;
      min-height: 360px; background: #e2e8f0;
    }
    .featured-img-wrap img {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform .6s ease;
    }
    .featured-post:hover .featured-img-wrap img { transform: scale(1.04); }
    .featured-placeholder {
      width: 100%; height: 100%; min-height: 360px;
      background: linear-gradient(135deg, #1e3a8a, #2563eb);
      display: flex; align-items: center; justify-content: center;
      font-size: 4rem;
    }

    .featured-body {
      padding: 3rem;
      display: flex; flex-direction: column; justify-content: center;
    }
    .post-type-badge {
      display: inline-block;
      padding: .3rem .85rem;
      border-radius: 50px;
      font-size: .72rem; font-weight: 800;
      text-transform: uppercase; letter-spacing: 1px;
      margin-bottom: 1.2rem;
    }
    .badge-blog { background: #dbeafe; color: #1d4ed8; }
    .badge-news { background: #dcfce7; color: #166534; }
    .badge-event { background: #fef3c7; color: #92400e; }

    .featured-body h2 {
      font-size: clamp(1.5rem, 2.5vw, 2rem);
      font-weight: 800; color: var(--blog-navy);
      line-height: 1.25; margin-bottom: 1rem; letter-spacing: -.02em;
    }
    .featured-body p {
      color: var(--blog-muted); line-height: 1.7; font-size: .97rem;
      margin-bottom: 1.5rem; flex-grow: 1;
    }
    .post-meta-row {
      display: flex; align-items: center; gap: 1rem;
      font-size: .82rem; color: var(--blog-muted);
      border-top: 1px solid var(--blog-border);
      padding-top: 1rem; margin-top: auto;
      flex-wrap: wrap;
    }
    .post-meta-row .author { font-weight: 700; color: var(--blog-navy); }
    .read-link {
      margin-left: auto;
      color: var(--blog-blue); font-weight: 700; font-size: .88rem;
      display: flex; align-items: center; gap: .3rem;
      white-space: nowrap;
    }

    /* ── POST GRID ────────────────────── */
    .post-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.75rem;
    }
    .post-card {
      background: #fff;
      border-radius: 16px;
      border: 1px solid var(--blog-border);
      overflow: hidden;
      cursor: pointer;
      transition: transform .3s ease, box-shadow .3s ease;
      display: flex; flex-direction: column;
    }
    .post-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 16px 48px rgba(15,23,42,.1);
    }
    .card-img-wrap {
      height: 200px; overflow: hidden;
      background: #e2e8f0; position: relative;
    }
    .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
    .post-card:hover .card-img-wrap img { transform: scale(1.05); }
    .card-placeholder {
      width: 100%; height: 100%;
      background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
      display: flex; align-items: center; justify-content: center;
      font-size: 2.5rem;
    }
    .card-body { padding: 1.4rem; display: flex; flex-direction: column; flex-grow: 1; }
    .card-body h3 {
      font-size: 1.1rem; font-weight: 700; color: var(--blog-navy);
      line-height: 1.3; margin-bottom: .6rem; letter-spacing: -.01em;
    }
    .card-body p {
      color: var(--blog-muted); font-size: .88rem; line-height: 1.6;
      flex-grow: 1; margin-bottom: 1rem;
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    }
    .card-footer {
      border-top: 1px solid var(--blog-border);
      padding-top: .85rem; margin-top: auto;
      display: flex; align-items: center; gap: .6rem;
      font-size: .78rem; color: var(--blog-muted); flex-wrap: wrap;
    }
    .card-footer .author { font-weight: 700; color: var(--blog-navy); }

    /* ── MODAL ────────────────────────── */
    .post-modal-overlay {
      position: fixed; inset: 0;
      background: rgba(15,23,42,.82);
      backdrop-filter: blur(10px);
      z-index: 9999;
      display: flex; align-items: center; justify-content: center;
      padding: 1.5rem;
      opacity: 0; visibility: hidden;
      transition: all .35s ease;
    }
    .post-modal-overlay.active { opacity: 1; visibility: visible; }

    .post-modal {
      background: #fff;
      width: 100%; max-width: 1080px;
      max-height: 90vh;
      border-radius: 20px;
      overflow: hidden;
      display: flex; flex-direction: row;
      position: relative; /* for close button */
      transform: translateY(24px) scale(.97);
      transition: all .35s cubic-bezier(.4,0,.2,1);
      box-shadow: 0 40px 80px rgba(0,0,0,.3);
    }
    .post-modal-overlay.active .post-modal { transform: translateY(0) scale(1); }

    /* LEFT — image panel */
    .modal-image-panel {
      flex: 0 0 38%;
      position: relative;
      background: linear-gradient(135deg, #0f172a, #1e3a8a);
      overflow: hidden;
    }
    .modal-image-panel img {
      width: 100%; height: 100%;
      object-fit: cover; display: block;
      opacity: .9;
    }
    .modal-image-panel-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to bottom, rgba(15,23,42,.25) 0%, rgba(15,23,42,.6) 100%);
    }
    .modal-image-placeholder {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      font-size: 5rem; min-height: 300px;
    }
    /* Close button — sits in content panel header row */
    .modal-close-btn {
      background: #f1f5f9;
      border: 1px solid #e2e8f0;
      color: #0f172a;
      width: 34px; height: 34px; border-radius: 50%;
      font-size: .95rem; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: background .2s, transform .15s;
      flex-shrink: 0;
    }
    .modal-close-btn:hover { background: #e2e8f0; transform: scale(1.1); }

    .modal-top-row {
      display: flex;
      justify-content: flex-end;
      margin-bottom: .75rem;
    }

    /* RIGHT — content panel */
    .modal-body {
      flex: 1;
      padding: 2.5rem 2.5rem;
      overflow-y: auto;
      display: flex; flex-direction: column;
    }

    .modal-badge-row { display: flex; gap: .75rem; align-items: center; margin-bottom: .9rem; flex-wrap: wrap; }
    .modal-title {
      font-size: clamp(1.4rem, 2.5vw, 2rem);
      font-weight: 900; color: var(--blog-navy);
      line-height: 1.2; letter-spacing: -.03em;
      margin-bottom: .9rem;
    }
    .modal-meta {
      display: flex; gap: 1rem; align-items: center;
      padding-bottom: 1.1rem; margin-bottom: 1.5rem;
      border-bottom: 2px solid var(--blog-border);
      font-size: .85rem; color: var(--blog-muted); flex-wrap: wrap;
    }
    .modal-meta .author { font-weight: 700; color: var(--blog-navy); }
    .modal-share-btn {
      margin-left: auto; background: var(--blog-bg);
      border: 1px solid var(--blog-border);
      padding: .4rem .9rem; border-radius: 8px;
      font-size: .8rem; font-weight: 700; cursor: pointer;
      display: flex; align-items: center; gap: .4rem;
      color: var(--blog-navy); transition: background .2s;
    }
    .modal-share-btn:hover { background: #e2e8f0; }

    /* Quill content rendering — match editor formatting exactly */
    .ql-editor-display {
      /* Reset ql-editor chrome styles */
      padding: 0 !important;
      border: none !important;
      outline: none !important;
      box-shadow: none !important;
      font-size: .97rem;
      line-height: 1.85;
      color: #334155;
      word-break: break-word;
      flex: 1;
      /* Quill uses these, so let them inherit */
      font-family: inherit;
    }
    /* Quill alignment helpers */
    .ql-editor-display .ql-align-center { text-align: center; }
    .ql-editor-display .ql-align-right  { text-align: right; }
    .ql-editor-display .ql-align-justify{ text-align: justify; }
    /* Quill size helpers */
    .ql-editor-display .ql-size-small { font-size: .75em; }
    .ql-editor-display .ql-size-large { font-size: 1.5em; }
    .ql-editor-display .ql-size-huge  { font-size: 2em; }
    /* Indent levels */
    .ql-editor-display .ql-indent-1 { padding-left: 3em; }
    .ql-editor-display .ql-indent-2 { padding-left: 6em; }
    .ql-editor-display .ql-indent-3 { padding-left: 9em; }
    /* Code block */
    .ql-editor-display pre.ql-syntax {
      background: #1e293b; color: #e2e8f0;
      border-radius: 8px; padding: 1rem 1.25rem;
      font-family: 'Fira Mono', monospace;
      font-size: .88rem; overflow-x: auto;
      margin: 1rem 0;
    }
    /* Blockquote */
    .ql-editor-display blockquote {
      border-left: 4px solid var(--blog-blue);
      padding-left: 1.2em; margin: 1.5em 0;
      color: var(--blog-muted); font-style: italic;
    }
    /* Lists */
    .ql-editor-display ol, .ql-editor-display ul {
      padding-left: 1.5em; margin-bottom: 1.2em;
    }
    .ql-editor-display li { margin-bottom: .3em; }
    /* Links */
    .ql-editor-display a { color: var(--blog-blue); text-decoration: underline; }
    /* Headings */
    .ql-editor-display h1, .ql-editor-display h2 {
      color: var(--blog-navy); font-weight: 800;
      margin: 1.6em 0 .7em; letter-spacing: -.02em;
    }
    .ql-editor-display h3 {
      color: var(--blog-navy); font-weight: 700;
      margin: 1.4em 0 .6em;
    }
    /* Paragraphs */
    .ql-editor-display p { margin-bottom: 1.2em; }
    /* Images */
    .ql-editor-display img { max-width: 100%; border-radius: 10px; margin: 1rem 0; }
    /* Video embeds from WP migration */
    .ql-editor-display .video-embed {
      position: relative; padding-bottom: 56.25%;
      height: 0; overflow: hidden; border-radius: 10px; margin: 1.5rem 0;
    }
    .ql-editor-display .video-embed iframe {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;
    }

    /* ── PAGINATION ─────────────────── */
    .pagination {
      display: flex; align-items: center; justify-content: center;
      gap: .5rem; flex-wrap: wrap; padding: 2.5rem 1rem 1rem;
    }
    .page-btn {
      min-width: 40px; height: 40px; padding: 0 .6rem;
      border-radius: 10px; border: 2px solid var(--blog-border);
      background: #fff; color: var(--blog-navy);
      font-weight: 700; font-size: .88rem; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: all .2s ease;
    }
    .page-btn:hover:not(:disabled) { border-color: var(--blog-blue); color: var(--blog-blue); transform: translateY(-1px); }
    .page-btn.active { background: var(--blog-blue); color: #fff; border-color: var(--blog-blue); box-shadow: 0 4px 14px rgba(37,99,235,.3); }
    .page-btn:disabled { opacity: .35; cursor: not-allowed; }
    .page-ellipsis { color: var(--blog-muted); font-weight: 700; padding: 0 .3rem; font-size: .88rem; }
    .page-info { text-align: center; font-size: .82rem; color: var(--blog-muted); padding-bottom: 1rem; }

    /* ── RESPONSIVE ───────────────────── */
    @media (max-width: 768px) {
      .featured-post { grid-template-columns: 1fr; }
      .featured-img-wrap { min-height: 220px; }
      .featured-body { padding: 1.75rem; }
      /* Stack modal on mobile */
      .post-modal { flex-direction: column; max-height: 92vh; }
      .modal-image-panel { flex: 0 0 200px; min-height: 200px; }
      .modal-body { padding: 1.5rem; }
    }
  </style>

  <!-- HERO -->
  <section class="blog-hero">
    <div class="blog-hero-content">
      <h1>Stories, News & Events</h1>
      <div class="blog-hero-rule"></div>
      <p>Insights from EIEI — early intervention updates, community events, and expert guidance for families and educators.</p>
    </div>
  </section>

  <!-- FILTERS -->
  <div class="filter-bar" id="filterBar">
    <button class="filter-btn active" onclick="filterPosts('All')" data-type="All">All Posts</button>
    <button class="filter-btn" onclick="filterPosts('Blog')" data-type="Blog">Blog</button>
    <button class="filter-btn" onclick="filterPosts('News')" data-type="News">News</button>
    <button class="filter-btn" onclick="filterPosts('Event')" data-type="Event">Events</button>
  </div>

  <!-- BLOG LAYOUT -->
  <div class="blog-layout">
    <div class="blog-inner">
      <div id="featuredWrap"></div>
      <div class="post-grid" id="postGrid">
        <div class="blog-empty">Loading the latest updates…</div>
      </div>
      <div class="pagination" id="pagination"></div>
      <p class="page-info" id="pageInfo"></p>
    </div>
  </div>

  <!-- MODAL -->
  <div class="post-modal-overlay" id="postModalOverlay">
    <div class="post-modal" id="postModal">

      <!-- LEFT: image panel -->
      <div class="modal-image-panel" id="modalImagePanel">
        <img id="modalImg" src="" alt="" style="display:none">
        <div class="modal-image-panel-overlay"></div>
        <div class="modal-image-placeholder" id="modalImgPlaceholder">✏️</div>
      </div>

      <!-- RIGHT: content panel -->
      <div class="modal-body">
        <!-- Close button always visible at top of content panel -->
        <div class="modal-top-row">
          <button class="modal-close-btn" onclick="closeModal()" aria-label="Close">✕</button>
        </div>
        <div class="modal-badge-row">
          <span id="modalBadge" class="post-type-badge"></span>
        </div>
        <h2 id="modalTitle" class="modal-title"></h2>
        <div class="modal-meta">
          <span class="author" id="modalAuthor"></span>
          <span id="modalDate"></span>
          <span style="display: flex; align-items: center; gap: 0.35rem;"><svg class="view-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--blog-blue); display: inline-block; vertical-align: middle;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg> <span id="modalViewsCount">0</span> views</span>
          <button class="modal-share-btn" id="shareBtn" onclick="sharePost()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
            Share
          </button>
        </div>
        <div class="modal-content-body ql-editor ql-editor-display" id="modalContent"></div>
      </div>

    </div>
  </div>

  <script is:inline>
    const PER_PAGE = 21;
    let allPosts = [];
    let filteredPosts = [];
    let currentPage = 1;

    function generateSlug(title) {
      return (title || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9\s-]/g, "")
        .trim()
        .replace(/\s+/g, "-")
        .replace(/-+/g, "-");
    }

    // ── helpers ──
    function badgeClass(type) {
      return type === 'News' ? 'badge-news' : type === 'Event' ? 'badge-event' : 'badge-blog';
    }
    function formatDate(val) {
      if (!val) return '';
      try {
        const d = val.toDate ? val.toDate() : new Date(val);
        return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
      } catch { return ''; }
    }
    function getDate(post) {
      return post.publishDate || post.createdAt || null;
    }
    function toMillis(val) {
      if (!val) return 0;
      try {
        if (typeof val.toMillis === 'function') return val.toMillis();
        if (typeof val.toDate === 'function') return val.toDate().getTime();
        return new Date(val).getTime() || 0;
      } catch { return 0; }
    }
    function escHtml(s) {
      return String(s||'').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
    }
    function placeholderEmoji(type) {
      return type === 'Event' ? '🎉' : type === 'News' ? '📰' : '✏️';
    }

    // ── render ──
    function renderPage(page) {
      currentPage = page;
      const featWrap = document.getElementById('featuredWrap');
      const grid = document.getElementById('postGrid');
      featWrap.innerHTML = '';
      grid.innerHTML = '';

      if (!filteredPosts.length) {
        grid.innerHTML = '<div class="blog-empty">No posts found for this category.</div>';
        updatePagination();
        return;
      }

      const startIndex = (page - 1) * PER_PAGE;
      const pagePosts = filteredPosts.slice(startIndex, startIndex + PER_PAGE);

      // On first page, we show a featured post
      if (page === 1) {
        const [featured, ...rest] = pagePosts;
        
        // Render Featured
        const ft = featured;
        const ftType = ft.type || 'Blog';
        const ftDate = formatDate(getDate(ft));
        const ftExcerpt = escHtml((ft.excerpt || '').substring(0, 220));
        const ftSlug = ft.slug || generateSlug(ft.title) || ft.id;
        featWrap.innerHTML = `
          <div class="featured-post" onclick="openModal('${ftSlug}')">
            <div class="featured-img-wrap">
              ${ft.imageUrl
                ? `<img src="${escHtml(ft.imageUrl)}" alt="${escHtml(ft.title)}" onerror="this.parentElement.innerHTML='<div class=\\'featured-placeholder\\'>${placeholderEmoji(ftType)}</div>'">`
                : `<div class="featured-placeholder">${placeholderEmoji(ftType)}</div>`}
            </div>
            <div class="featured-body">
              <span class="post-type-badge ${badgeClass(ftType)}">${escHtml(ftType)}</span>
              <h2>${escHtml(ft.title || 'Untitled')}</h2>
              <p>${ftExcerpt}${(ft.excerpt||'').length > 220 ? '…' : ''}</p>
              <div class="post-meta-row">
                <span class="author">${escHtml(ft.author || 'EIEI Staff')}</span>
                <span>${ftDate}</span>
                <span id="feat-views-${ft.id}" style="display: flex; align-items: center; gap: 0.35rem;">
                  <svg class="view-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--blog-blue); display: inline-block; vertical-align: middle;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  <span>${ft.views || 0}</span> views
                </span>
                <span class="read-link">Read full article →</span>
              </div>
            </div>
          </div>`;

        // Render remaining as grid
        rest.forEach(post => renderCard(post, grid));
      } else {
        // Subsequent pages: all are grid cards
        pagePosts.forEach(post => renderCard(post, grid));
      }

      updatePagination();
      
      // Scroll back up to filters when page changes
      if (page > 1 || startIndex > 0) {
        document.getElementById('filterBar').scrollIntoView({ behavior: 'smooth' });
      }
    }

    function renderCard(post, container) {
      const type = post.type || 'Blog';
      const date = formatDate(getDate(post));
      const excerpt = (post.excerpt || '').substring(0, 160);
      const card = document.createElement('div');
      card.className = 'post-card';
      const postSlug = post.slug || generateSlug(post.title) || post.id;
      card.onclick = () => openModal(postSlug);
      card.innerHTML = `
        <div class="card-img-wrap">
          ${post.imageUrl
            ? `<img src="${escHtml(post.imageUrl)}" alt="${escHtml(post.title)}" loading="lazy" onerror="this.parentElement.innerHTML='<div class=\\'card-placeholder\\'>${placeholderEmoji(type)}</div>'">`
            : `<div class="card-placeholder">${placeholderEmoji(type)}</div>`}
        </div>
        <div class="card-body">
          <span class="post-type-badge ${badgeClass(type)}" style="margin-bottom:.6rem;">${escHtml(type)}</span>
          <h3>${escHtml(post.title || 'Untitled')}</h3>
          <p>${escHtml(excerpt)}${excerpt.length < (post.excerpt||'').length ? '…' : ''}</p>
          <div class="card-footer">
            <span class="author">${escHtml(post.author || 'EIEI Staff')}</span>
            <span>${date}</span>
            <span id="card-views-${post.id}" style="margin-left: auto; display: flex; align-items: center; gap: 0.35rem;">
              <svg class="view-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--blog-blue); display: inline-block; vertical-align: middle;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <span>${post.views || 0}</span>
            </span>
          </div>
        </div>`;
      container.appendChild(card);
    }

    function updatePagination() {
      const pagination = document.getElementById('pagination');
      const pageInfo = document.getElementById('pageInfo');
      const totalPages = Math.ceil(filteredPosts.length / PER_PAGE);

      pagination.innerHTML = '';
      
      if (filteredPosts.length === 0) {
        pageInfo.textContent = '';
        return;
      }

      pageInfo.textContent = `Showing page ${currentPage} of ${totalPages} (${filteredPosts.length} total posts)`;

      if (totalPages <= 1) return;

      // Previous button
      const prevBtn = document.createElement('button');
      prevBtn.className = 'page-btn';
      prevBtn.textContent = '←';
      prevBtn.disabled = currentPage === 1;
      prevBtn.onclick = () => renderPage(currentPage - 1);
      pagination.appendChild(prevBtn);

      // Page numbers
      let startPage = Math.max(1, currentPage - 2);
      let endPage = Math.min(totalPages, startPage + 4);
      if (endPage === totalPages) startPage = Math.max(1, endPage - 4);

      for (let i = startPage; i <= endPage; i++) {
        const btn = document.createElement('button');
        btn.className = `page-btn ${i === currentPage ? 'active' : ''}`;
        btn.textContent = i;
        btn.onclick = () => renderPage(i);
        pagination.appendChild(btn);
      }

      // Next button
      const nextBtn = document.createElement('button');
      nextBtn.className = 'page-btn';
      nextBtn.textContent = '→';
      nextBtn.disabled = currentPage === totalPages;
      nextBtn.onclick = () => renderPage(currentPage + 1);
      pagination.appendChild(nextBtn);
    }

    function filterPosts(type) {
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-type') === type);
      });
      filteredPosts = type === 'All' ? allPosts : allPosts.filter(p => (p.type || 'Blog') === type);
      renderPage(1);
    }

    // ── modal ──
    function openModal(slugOrId) {
      const post = allPosts.find(p => p.slug === slugOrId || generateSlug(p.title) === slugOrId || p.id === slugOrId);
      if (!post) return;
      const type = post.type || 'Blog';

      document.getElementById('modalTitle').textContent = post.title || '';
      document.getElementById('modalContent').innerHTML = post.content || '';
      document.getElementById('modalAuthor').textContent = post.author || 'EIEI Staff';
      document.getElementById('modalDate').textContent = formatDate(getDate(post));

      // Update views count locally and in Firestore
      post.views = (post.views || 0) + 1;
      document.getElementById('modalViewsCount').textContent = post.views;

      // Update the views count on the card in the list immediately
      const eyeIconSvg = `<svg class="view-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--blog-blue); display: inline-block; vertical-align: middle;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`;
      const cardViewsEl = document.getElementById(`card-views-${post.id}`);
      if (cardViewsEl) {
        cardViewsEl.innerHTML = `${eyeIconSvg} <span>${post.views}</span>`;
      }
      const featViewsEl = document.getElementById(`feat-views-${post.id}`);
      if (featViewsEl) {
        featViewsEl.innerHTML = `${eyeIconSvg} <span>${post.views}</span> views`;
      }

      if (window.firebaseDB && post.id) {
        window.firebaseDB.collection('posts').doc(post.id).update({
          views: firebase.firestore.FieldValue.increment(1)
        }).catch(err => console.error("Error incrementing views:", err));
      }

      const badge = document.getElementById('modalBadge');
      badge.textContent = type;
      badge.className = 'post-type-badge ' + badgeClass(type);

      const img = document.getElementById('modalImg');
      const placeholder = document.getElementById('modalImgPlaceholder');
      if (post.imageUrl) {
        img.src = post.imageUrl;
        img.style.display = 'block';
        if (placeholder) placeholder.style.display = 'none';
      } else {
        img.style.display = 'none';
        if (placeholder) {
          placeholder.style.display = 'flex';
          placeholder.textContent = type === 'Event' ? '🎉' : type === 'News' ? '📰' : '✏️';
        }
      }

      document.getElementById('postModalOverlay').classList.add('active');
      document.body.style.overflow = 'hidden';

      const postSlug = post.slug || generateSlug(post.title) || post.id;
      const url = new URL(window.location);
      url.searchParams.set('post', postSlug);
      window.history.pushState({}, '', url);
    }

    function closeModal() {
      document.getElementById('postModalOverlay').classList.remove('active');
      document.body.style.overflow = '';
      const url = new URL(window.location);
      url.searchParams.delete('post');
      window.history.pushState({}, '', url);
    }

    function sharePost() {
      navigator.clipboard.writeText(window.location.href).then(() => {
        const btn = document.getElementById('shareBtn');
        const orig = btn.innerHTML;
        btn.innerHTML = '✓ Copied!';
        setTimeout(() => btn.innerHTML = orig, 2000);
      });
    }

    // ── load ──
    async function loadPosts() {
      try {
        // Fetch all — don't orderBy on publishDate (old docs may not have it)
        const snap = await window.firebaseDB.collection('posts').get();
        let posts = snap.docs.map(d => ({ id: d.id, ...d.data() }));
        // Sort client-side: newest first, using publishDate then createdAt
        posts.sort((a, b) => toMillis(getDate(b)) - toMillis(getDate(a)));
        allPosts = posts;
        filteredPosts = posts;
        renderPage(1);

        const postId = new URLSearchParams(window.location.search).get('post');
        if (postId) openModal(postId);
      } catch (e) {
        console.error('Blog load error:', e);
        document.getElementById('postGrid').innerHTML =
          '<div class="blog-empty">Unable to load posts. Please try again later.</div>';
      }
    }

    function waitForFirebase() {
      if (window.firebaseDB && typeof window.firebaseDB.collection === 'function') {
        loadPosts();
      } else {
        setTimeout(waitForFirebase, 100);
      }
    }

    document.addEventListener('DOMContentLoaded', waitForFirebase);

    document.getElementById('postModalOverlay').addEventListener('click', e => {
      if (e.target === e.currentTarget) closeModal();
    });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
  </script>
</Layout>
