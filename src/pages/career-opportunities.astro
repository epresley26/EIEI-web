---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Career Opportunities - EIEI">
  <style is:global>
    /* --- Premium Modern Styling for Careers --- */

    /* HERO SECTION */
    .career-hero {
      position: relative;
      width: 100%;
      min-height: 45vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 10rem 2rem 5rem;
      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
      color: white;
      text-align: center;
      overflow: hidden;
    }

    .career-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      opacity: 0.5;
      z-index: 1;
    }

    .career-hero-content {
      position: relative;
      z-index: 2;
      max-width: 800px;
      margin: 0 auto;
    }

    .career-hero h1 {
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 900;
      line-height: 1.1;
      margin-bottom: 1.5rem;
      letter-spacing: -1px;
    }

    .career-hero p {
      font-size: 1.25rem;
      font-weight: 400;
      opacity: 0.9;
      line-height: 1.6;
    }

    /* SECTION BASICS */
    .section-wrap {
      padding: 6rem 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 2.8rem;
      font-weight: 900;
      color: #0f172a;
      text-align: center;
      margin-bottom: 1.5rem;
      letter-spacing: -1px;
    }

    .section-subtitle {
      text-align: center;
      font-size: 1.15rem;
      color: #64748b;
      max-width: 700px;
      margin: 0 auto 4rem;
      line-height: 1.7;
    }

    /* MISSION GRID (Why EIEI) */
    .mission-container {
      background: #f8fafc;
      padding: 6rem 0;
    }

    .mission-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2.5rem;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .mission-card {
      background: white;
      border-radius: 20px;
      padding: 2.5rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.04);
      border: 1px solid #e2e8f0;
      transition: all 0.4s ease;
      position: relative;
      overflow: hidden;
    }

    .mission-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, #2563eb, #3b82f6);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
    }

    .mission-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 40px rgba(37, 99, 235, 0.1);
    }

    .mission-card:hover::before {
      transform: scaleX(1);
    }

    .icon-wrap {
      width: 60px;
      height: 60px;
      background: #eff6ff;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      color: #2563eb;
      margin-bottom: 1.5rem;
    }

    .mission-card h3 {
      font-size: 1.4rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 1rem;
    }

    .mission-card p {
      color: #475569;
      line-height: 1.7;
      font-size: 1rem;
    }

    /* BENEFITS GRID */
    .benefits-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 2rem;
    }

    .benefit-item {
      background: white;
      padding: 2rem;
      border-radius: 16px;
      border: 1px solid #e2e8f0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      transition: all 0.3s ease;
    }

    .benefit-item:hover {
      border-color: #2563eb;
      background: #f8fafc;
    }

    .benefit-item strong {
      font-size: 1.1rem;
      color: #0f172a;
      font-weight: 800;
    }

    .benefit-item p {
      color: #64748b;
      font-size: 0.95rem;
      line-height: 1.5;
    }

    /* JOB LISTINGS */
    .jobs-container {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      max-width: 900px;
      margin: 0 auto;
    }

    .job-card {
      background: white;
      border-radius: 20px;
      padding: 2.5rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      border: 1px solid #e2e8f0;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .job-card:hover {
      box-shadow: 0 20px 40px rgba(37, 99, 235, 0.1);
      border-color: #cbd5e1;
    }

    .job-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
    }

    .job-title-area h3 {
      font-size: 1.6rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 0.5rem;
    }

    .job-meta {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .job-badge {
      background: #eff6ff;
      color: #2563eb;
      padding: 0.4rem 1rem;
      border-radius: 50px;
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .job-badge.location {
      background: #f1f5f9;
      color: #475569;
    }
    
    .job-badge.salary {
      background: #ecfdf5;
      color: #059669;
    }

    .job-desc {
      color: #475569;
      line-height: 1.7;
      font-size: 1.05rem;
    }

    .job-reqs {
      padding-left: 1.5rem;
      color: #475569;
      line-height: 1.7;
      border-top: 1px dashed #e2e8f0;
      padding-top: 1.5rem;
    }
    
    .job-reqs li {
      margin-bottom: 0.5rem;
    }

    .apply-btn-wrapper {
      margin-left: auto;
      flex-shrink: 0;
    }

    .empty-jobs {
      text-align: center;
      padding: 4rem;
      background: white;
      border-radius: 20px;
      border: 1px dashed #cbd5e1;
      color: #64748b;
      font-size: 1.1rem;
    }

    /* APPLICATION MODAL Overlay */
    .app-modal {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      opacity: 0;
      visibility: hidden;
      transition: all 0.4s ease;
      padding: 2rem;
    }

    .app-modal.active {
      opacity: 1;
      visibility: visible;
    }

    .app-modal-content {
      background: white;
      border-radius: 24px;
      width: 100%;
      max-width: 1100px;
      max-height: 85vh;
      display: grid;
      grid-template-columns: 4fr 6fr;
      box-shadow: 0 30px 60px rgba(0,0,0,0.3);
      transform: translateY(20px) scale(0.98);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
    }

    .app-modal.active .app-modal-content {
      transform: translateY(0) scale(1);
    }

    .app-modal-left {
      background: #f8fafc;
      padding: 3rem;
      border-right: 1px solid #e2e8f0;
      overflow-y: auto;
    }

    .app-modal-right {
      padding: 3rem;
      overflow-y: auto;
      background: white;
      position: relative;
    }

    .close-modal {
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      background: #f1f5f9;
      color: #0f172a;
      border: none;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      font-size: 1.5rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }

    .close-modal:hover {
      background: #e2e8f0;
      transform: scale(1.05);
    }

    /* MODAL FORM STYLING */
    .form-group {
      margin-bottom: 1.5rem;
    }
    .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 600;
      color: #334155;
      font-size: 0.95rem;
    }
    .form-group input, .form-group textarea {
      width: 100%;
      padding: 0.8rem 1.2rem;
      border: 1px solid #cbd5e1;
      border-radius: 12px;
      font-family: inherit;
      font-size: 1rem;
      transition: all 0.3s;
      background: #f8fafc;
    }
    .form-group input:focus, .form-group textarea:focus {
      outline: none;
      border-color: #2563eb;
      background: white;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }
    .form-group input[type="file"] {
      padding: 0.5rem;
      background: white;
      border: 1px dashed #cbd5e1;
    }
    
    @media (max-width: 900px) {
      .job-header {
        flex-direction: column;
        align-items: flex-start;
      }
      .apply-btn-wrapper {
        margin-left: 0;
        margin-top: 1rem;
        width: 100%;
      }
      .apply-now-btn {
        width: 100%;
      }
      .app-modal-content {
        grid-template-columns: 1fr;
        height: 90vh;
      }
      .app-modal-left {
        border-right: none;
        border-bottom: 1px solid #e2e8f0;
        max-height: 30vh;
        padding: 2rem;
      }
      .app-modal-right {
        padding: 2rem;
      }
      .app-modal { padding: 1rem; }
    }
  </style>

  <!-- HERO SECTION -->
  <section class="career-hero">
    <div class="career-hero-content">
      <h1>Join Our Dream Team</h1>
      <p>Are you ready to wake up every day knowing you're making a real difference in young children's lives? Join EIEI and be part of a mission that truly matters.</p>
    </div>
  </section>

  <!-- MISSION/CULTURE OVERVIEW -->
  <section class="mission-container">
    <div class="section-wrap" style="padding: 0;">
      <h2 class="section-title">Why Work at EIEI?</h2>
      <p class="section-subtitle">We believe that happy, supported educators and professionals are the cornerstone of a thriving early intervention environment.</p>
      
      <div class="mission-grid">
        <div class="mission-card">
          <div class="icon-wrap">❤️</div>
          <h3>Heartfelt Mission</h3>
          <p>Joining EIEI is not just about a job – it's about embracing a mission close to your heart. Help shape young children's lives and give them a fighting chance to succeed.</p>
        </div>
        <div class="mission-card">
          <div class="icon-wrap">🌱</div>
          <h3>Nurturing Minds</h3>
          <p>We see future artists, scientists, teachers, and leaders. The laughter, breakthrough moments, and small victories are all part of a beautiful journey, and you're never on it alone.</p>
        </div>
        <div class="mission-card">
          <div class="icon-wrap">🤝</div>
          <h3>Together We Thrive</h3>
          <p>Our EIEI family thrives on teamwork, mutual respect, and shared passion. We constantly learn from one another, update our methods, and innovate together.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WORK LIFE BALANCE / PERKS -->
  <section class="section-wrap">
    <h2 class="section-title">Exceptional Work-Life Balance</h2>
    <p class="section-subtitle">We provide the flexibility, downtime, and rewards you need to bring your best self to work.</p>
    
    <div class="benefits-grid">
      <div class="benefit-item">
        <strong>🌴 33 Days Off Annually</strong>
        <p>9 deep clean days, 3 weeks of vacation, and fully paid professional development time.</p>
      </div>
      <div class="benefit-item">
        <strong>⏰ Flexible Scheduling</strong>
        <p>Morning, afternoon, evening, and weekend shifts available. Full-time and part-time structural options.</p>
      </div>
      <div class="benefit-item">
        <strong>💵 $500 Signing Bonus</strong>
        <p>New employees receive a guaranteed $500 bonus upon completing their first 100 school days of employment.</p>
      </div>
      <div class="benefit-item">
        <strong>📈 Professional Growth</strong>
        <p>Continuous training, structured supervision, and clearly defined upward career development pathways.</p>
      </div>
    </div>
  </section>

  <!-- CURRENT OPENINGS -->
  <section class="mission-container">
    <div class="section-wrap" style="padding: 0;">
      <h2 class="section-title">Current Openings</h2>
      <p class="section-subtitle">Find the perfect role to showcase your skills and start making an impact.</p>
      <div id="jobs-container" class="jobs-container">
        <div class="empty-jobs">Loading available positions...</div>
      </div>
    </div>
  </section>

  <!-- COMPREHENSIVE BENEFITS -->
  <section class="section-wrap">
    <div style="background: white; border-radius: 24px; padding: 4rem; box-shadow: 0 15px 40px rgba(0,0,0,0.05); border: 1px solid #e2e8f0;">
      <h2 class="section-title">Comprehensive Benefits Package</h2>
      <div class="benefits-grid" style="margin-top: 3rem;">
        <div class="benefit-item" style="border: none; background: #f8fafc;">
          <strong>Medical & Dental</strong>
          <p>Comprehensive health coverage and full dental for you and your family.</p>
        </div>
        <div class="benefit-item" style="border: none; background: #f8fafc;">
          <strong>403(b) Retirement Plan</strong>
          <p>Secure your future with an automatic 3% company contribution.</p>
        </div>
        <div class="benefit-item" style="border: none; background: #f8fafc;">
          <strong>Loan Forgiveness</strong>
          <p>Assistance qualifying for the Public Service Loan Forgiveness Program.</p>
        </div>
        <div class="benefit-item" style="border: none; background: #f8fafc;">
          <strong>529 Education Plans</strong>
          <p>Tax-advantaged savings plans for your children's future education.</p>
        </div>
        <div class="benefit-item" style="border: none; background: #f8fafc;">
          <strong>Assistance Program (EAP)</strong>
          <p>Confidential mental health and wellness support services.</p>
        </div>
        <div class="benefit-item" style="border: none; background: #f8fafc;">
          <strong>Productivity Awards</strong>
          <p>Earn up to $300 per quarter rewarding dedicated performance.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- APPLICATION MODAL -->
  <div id="applicationModal" class="app-modal">
    <div class="app-modal-content">
      <div class="app-modal-left">
        <h3 id="modalJobTitle" style="color: #0f172a; font-size: 1.8rem; font-weight: 800; margin-bottom: 1.5rem; line-height: 1.2;"></h3>
        
        <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
          <div>
            <div style="font-size: 0.85rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Type</div>
            <div id="modalJobType" style="font-size: 1.1rem; color: #2563eb; font-weight: 600;">-</div>
          </div>
          <div>
            <div style="font-size: 0.85rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Location</div>
            <div id="modalJobLocation" style="font-size: 1.1rem; font-weight: 500;">-</div>
          </div>
          <div>
            <div style="font-size: 0.85rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Salary</div>
            <div id="modalJobSalary" style="font-size: 1.1rem; color: #059669; font-weight: 500;">-</div>
          </div>
          <div>
            <div style="font-size: 0.85rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Schedule</div>
            <div id="modalJobEmploymentType" style="font-size: 1.1rem; font-weight: 500;">-</div>
          </div>
        </div>

        <h4 style="font-size: 1.2rem; font-weight: 800; color: #0f172a; margin-bottom: 1rem;">Description</h4>
        <p id="modalJobDescription" style="line-height: 1.7; color: #475569;"></p>
      </div>
      
      <div class="app-modal-right">
        <button class="close-modal" onclick="closeApplicationModal()">✕</button>
        <h3 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 2rem; color: #0f172a;">Submit Application</h3>
        
        <form id="applicationForm" onsubmit="submitJobApplication(event)">
          <div class="form-group">
            <label for="appName">Full Name *</label>
            <input type="text" id="appName" required>
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label for="appEmail">Email Address *</label>
              <input type="email" id="appEmail" required>
            </div>
            <div class="form-group">
              <label for="appPhone">Phone Number *</label>
              <input type="tel" id="appPhone" required>
            </div>
          </div>
          <div class="form-group">
            <label for="appExperience">Years of Experience *</label>
            <input type="number" id="appExperience" min="0" required>
          </div>
          <div class="form-group">
            <label for="appResume">Resume/CV (URL)</label>
            <input type="text" id="appResume" placeholder="e.g. LinkedIn profile or portfolio link">
          </div>
          <div class="form-group">
            <label for="appResumeFile">Or Upload Resume File (PDF/DOC)</label>
            <input type="file" id="appResumeFile" accept=".pdf,.doc,.docx" />
          </div>
          <div class="form-group">
            <label for="appCoverLetter">Cover Letter / Note</label>
            <textarea id="appCoverLetter" rows="4" placeholder="Tell us why you are a great fit..."></textarea>
          </div>
          <button type="submit" class="primary-btn" style="width: 100%;">Submit Application</button>
        </form>
      </div>
    </div>
  </div>

  <!-- JAVASCRIPT LOGIC -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      waitForFirebaseJobs();
    });

    function waitForFirebaseJobs() {
      if (window.firebaseDB && typeof window.firebaseDB.collection === 'function') {
        loadJobOpenings();
      } else { 
        setTimeout(waitForFirebaseJobs, 100); 
      }
    }

    async function loadJobOpenings() {
      try {
        const jobsSnapshot = await window.firebaseDB.collection('jobs').orderBy('postedAt', 'desc').get();
        const jobsContainer = document.getElementById('jobs-container');
        
        if (!jobsSnapshot || jobsSnapshot.empty) {
          jobsContainer.innerHTML = '<div class="empty-jobs">No job openings available at this time. Please check back soon!</div>';
          return;
        }

        jobsContainer.innerHTML = '';
        jobsSnapshot.forEach(doc => {
          const job = doc.data();
          const jobId = doc.id;
          
          let requirementsHTML = '';
          if (job.requirements) {
            const requirementsList = Array.isArray(job.requirements) ? job.requirements.join('\n') : job.requirements;
            requirementsHTML = requirementsList.split('\n')
              .filter(item => item.trim())
              .map(item => `<li>${item.trim()}</li>`)
              .join('');
          }

          const jobCard = document.createElement('div');
          jobCard.className = 'job-card';
          jobCard.innerHTML = `
            <div class="job-header">
              <div class="job-title-area">
                <h3>${job.title || 'Untitled Position'}</h3>
                <div class="job-meta">
                  ${job.type ? `<span class="job-badge">${job.type}</span>` : ''}
                  ${job.location ? `<span class="job-badge location">${job.location}</span>` : ''}
                  ${job.salary ? `<span class="job-badge salary">${job.salary}</span>` : ''}
                </div>
              </div>
              <div class="apply-btn-wrapper">
                <button class="primary-btn apply-now-btn">Apply Now</button>
              </div>
            </div>
            
            <div class="job-desc">${job.description || ''}</div>
            ${requirementsHTML ? `<ul class="job-reqs">${requirementsHTML}</ul>` : ''}
          `;
          
          // Wire up Apply logic preserving JSON object
          const applyBtn = jobCard.querySelector('.apply-now-btn');
          applyBtn.dataset.jobData = JSON.stringify(job);
          applyBtn.addEventListener('click', function(e) {
            e.preventDefault();
            openApplicationModal(jobId, job.title, JSON.parse(this.dataset.jobData));
          });
          
          jobsContainer.appendChild(jobCard);
        });
      } catch (error) {
        console.error('Error loading jobs:', error);
        document.getElementById('jobs-container').innerHTML = '<div class="empty-jobs" style="color:#ef4444;">Error loading job openings. Please try again later.</div>';
      }
    }

    let currentJobId = null;

    function openApplicationModal(jobId, jobTitle, jobData) {
      currentJobId = jobId;
      document.getElementById('modalJobTitle').textContent = jobTitle || 'Application';
      document.getElementById('modalJobType').textContent = jobData.type || '-';
      document.getElementById('modalJobLocation').textContent = jobData.location || '-';
      document.getElementById('modalJobSalary').textContent = jobData.salary || '-';
      document.getElementById('modalJobEmploymentType').textContent = jobData.employmentType || 'Full-time';
      document.getElementById('modalJobDescription').textContent = jobData.description || 'No description available';
      
      const modal = document.getElementById('applicationModal');
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeApplicationModal() {
      const modal = document.getElementById('applicationModal');
      modal.classList.remove('active');
      document.getElementById('applicationForm').reset();
      currentJobId = null;
      document.body.style.overflow = 'auto';
    }

    async function submitJobApplication(event) {
      event.preventDefault();
      
      if (!currentJobId) {
        alert('Error: Job ID not found.');
        return;
      }

      const name = document.getElementById('appName').value.trim();
      const email = document.getElementById('appEmail').value.trim();
      const phone = document.getElementById('appPhone').value.trim();
      const experience = document.getElementById('appExperience').value;
      const resumeUrl = document.getElementById('appResume').value.trim();
      const resumeFile = document.getElementById('appResumeFile').files[0];
      const coverLetter = document.getElementById('appCoverLetter').value.trim();

      if (!name || !email || !phone || !experience || (!resumeUrl && !resumeFile)) {
        alert('Please fill in all required fields and provide either a resume URL or upload a resume file.');
        return;
      }

      const submitBtn = event.target.querySelector('button[type="submit"]');
      const originalText = submitBtn.textContent;
      submitBtn.textContent = 'Submitting...';
      submitBtn.disabled = true;

      try {
        let applicationData = {
          jobId: currentJobId,
          name: name,
          email: email,
          phone: phone,
          experience: parseInt(experience),
          coverLetter: coverLetter,
          appliedAt: firebase.firestore.FieldValue.serverTimestamp(),
          status: 'pending'
        };

        if (resumeFile) {
          const maxSize = 10 * 1024 * 1024;
          if (resumeFile.size > maxSize) {
            alert("Resume file is too large. Maximum size is 10MB.");
            submitBtn.textContent = originalText;
            submitBtn.disabled = false;
            return;
          }

          const allowedTypes = ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
          if (!allowedTypes.includes(resumeFile.type)) {
            alert("Please upload a PDF or Word document (.pdf, .doc, .docx)");
            submitBtn.textContent = originalText;
            submitBtn.disabled = false;
            return;
          }

          const reader = new FileReader();
          const resumeBase64 = await new Promise((resolve, reject) => {
            reader.onload = () => resolve(reader.result);
            reader.onerror = () => reject(reader.error);
            reader.readAsDataURL(resumeFile);
          });

          applicationData.resumeFileName = resumeFile.name;
          applicationData.resumeSize = resumeFile.size;
          applicationData.resumeMimeType = resumeFile.type;
          applicationData.resumeData = resumeBase64;
        } else if (resumeUrl) {
          applicationData.resumeUrl = resumeUrl;
        }

        await window.firebaseDB.collection('job_applications').add(applicationData);

        alert('Application submitted successfully! We will review it and contact you soon.');
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
        closeApplicationModal();
      } catch (error) {
        console.error('Error submitting application:', error);
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
        alert(`Error submitting application: ${error.message}`);
      }
    }

    // Modal background click and Escape key support
    document.getElementById('applicationModal').addEventListener('click', function(e) {
      if (e.target === this) closeApplicationModal();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && document.getElementById('applicationModal').classList.contains('active')) {
        closeApplicationModal();
      }
    });
  </script>
</Layout>
