---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Donate - EIEI">
<style is:global>

    .page-shell {
      max-width: 1000px;
      margin: 0 auto;
      padding: 3rem 1.5rem 4rem;
    }

    .page-breadcrumb {
      font-size: 0.85rem;
      color: #6b7280;
      margin-bottom: 1rem;
    }

    .page-breadcrumb a {
      color: #2a4175;
      text-decoration: none;
    }

    .page-breadcrumb a:hover {
      color: #fca311;
    }

    .donate-hero-card {
      background: #ffffff;
      border-radius: 16px;
      padding: 2.5rem 2.25rem;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      border: 1px solid rgba(226, 232, 240, 0.9);
      margin-bottom: 2.5rem;
      text-align: left;
    }

    .donate-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #2a4175;
      background: rgba(37, 99, 235, 0.08);
      padding: 0.35rem 0.7rem;
      border-radius: 999px;
      margin-bottom: 0.9rem;
    }

    .donate-title {
      color: #2a4175;
      font-size: 2.1rem;
      letter-spacing: -0.04em;
      margin-bottom: 0.8rem;
      font-weight: 700;
    }

    .donate-subtitle {
      font-size: 1.02rem;
      color: #4b5563;
      line-height: 1.8;
      margin-bottom: 1rem;
    }

    .donate-hero-highlight {
      font-size: 0.95rem;
      color: #111827;
      font-weight: 600;
    }

    .donate-section {
      background: #ffffff;
      border-radius: 14px;
      padding: 2rem 2rem 2.2rem;
      box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
      border: 1px solid rgba(226, 232, 240, 0.85);
      margin-bottom: 2rem;
    }

    .donate-section-title {
      color: #2a4175;
      font-size: 1.4rem;
      margin-bottom: 1.2rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      border-bottom: 3px solid #fca311;
      padding-bottom: 0.5rem;
      display: inline-block;
    }

    .donate-section p {
      font-size: 0.97rem;
      color: #111827;
      line-height: 1.7;
      margin-bottom: 1rem;
    }

    .donate-list {
      list-style: none;
      margin: 0 0 1.2rem 0;
      padding: 0;
    }

    .donate-list li {
      position: relative;
      padding-left: 1.4rem;
      margin-bottom: 0.45rem;
      font-size: 0.95rem;
      color: #111827;
      line-height: 1.6;
    }

    .donate-list li::before {
      content: "✓";
      position: absolute;
      left: 0;
      top: 0;
      color: #fca311;
      font-weight: 700;
    }

    .donate-amount-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1rem;
      margin-top: 1rem;
    }

    .donate-amount-card {
      border-radius: 999px;
      padding: 0.85rem 1rem;
      text-align: center;
      border: 1px solid rgba(209, 213, 219, 0.95);
      cursor: default;
      background: #f9fafb;
      font-size: 0.95rem;
      color: #111827;
      font-weight: 500;
    }

    .donate-amount-card span {
      display: block;
      font-size: 0.8rem;
      color: #6b7280;
      font-weight: 400;
    }

    .donate-cta-inline {
      margin-top: 1.2rem;
    }

    .donate-button {
      display: inline-block;
      background: #fca311;
      color: #2a4175;
      padding: 0.8rem 2rem;
      border-radius: 999px;
      font-weight: 600;
      text-decoration: none;
      font-size: 0.95rem;
      transition: background-color 0.2s ease, transform 0.2s ease;
    }

    .donate-button:hover {
      background: #ff9500;
      transform: translateY(-2px);
    }

    .donate-quote {
      background: #f8fafc;
      border-radius: 10px;
      border-left: 4px solid #fca311;
      padding: 1.3rem 1.4rem;
      margin: 1.5rem 0 0.5rem;
      font-size: 0.96rem;
      color: #374151;
      font-style: italic;
    }

    .donate-quote-author {
      font-size: 0.9rem;
      font-weight: 600;
      color: #2a4175;
      text-align: right;
    }

    .marketplace-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 1.2rem;
      margin-top: 1.2rem;
    }

    .marketplace-card {
      background: #f9fafb;
      border-radius: 12px;
      padding: 1.2rem 1.1rem;
      border: 1px solid rgba(209, 213, 219, 0.9);
    }

    .marketplace-card-title {
      font-size: 1rem;
      font-weight: 600;
      color: #111827;
      margin-bottom: 0.3rem;
    }

    .marketplace-card-desc {
      font-size: 0.9rem;
      color: #6b7280;
      margin-bottom: 0.4rem;
    }

    .marketplace-card-tag {
      font-size: 0.8rem;
      font-weight: 500;
      color: #2a4175;
    }

    .donor-info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 1.3rem;
      margin-top: 1rem;
    }

    .donor-box {
      background: #f9fafb;
      border-radius: 10px;
      padding: 1.1rem 1.1rem;
      border: 1px dashed rgba(209, 213, 219, 0.9);
      font-size: 0.9rem;
      color: #111827;
    }

    .donor-box strong {
      display: block;
      margin-bottom: 0.35rem;
      color: #2a4175;
      font-size: 0.9rem;
    }

    .donate-final-cta {
      background: linear-gradient(135deg, #2a4175 0%, #4a6fa5 100%);
      color: #ffffff;
      border-radius: 16px;
      padding: 2.3rem 2rem;
      text-align: center;
      margin-top: 2rem;
    }

    .donate-final-cta h2 {
      font-size: 1.6rem;
      margin-bottom: 0.8rem;
      letter-spacing: -0.02em;
    }

    .donate-final-cta p {
      font-size: 0.98rem;
      opacity: 0.96;
      max-width: 520px;
      margin: 0 auto 1.4rem;
    }

    @media (max-width: 640px) {
      .donate-hero-card,
      .donate-section,
      .donate-final-cta {
        padding: 1.6rem 1.4rem 1.7rem;
      }

      .donate-title {
        font-size: 1.8rem;
      }
    }

    /* Reuse services hero carousel styles if not already global */
    .services-carousel {
      width: 100%;
      max-width: none;
      margin: 0;
      height: 50vh;
      position: relative;
      overflow: hidden;
      border-radius: 0;
    }

    .carousel {
      position: relative;
      width: 100%;
      height: 100%;
    }

    .slide {
      position: absolute;
      width: 100%;
      height: 100%;
      opacity: 0;
      transition: opacity 0.8s ease-in-out;
      background-size: cover;
      background-position: center;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .slide.active {
      opacity: 1;
    }

    .slide-content {
      text-align: center;
      color: white;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
      max-width: 600px;
      padding: 2rem;
    }

    .slide-content h1 {
      font-size: 2.2rem;
      margin-bottom: 1rem;
      font-weight: 700;
    }

    .slide-content p {
      font-size: 1.1rem;
      opacity: 0.95;
    }

    .carousel-controls {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 10px;
      z-index: 10;
    }

    .carousel-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.5);
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .carousel-dot.active {
      background: white;
      transform: scale(1.2);
    }
    .marketplace-filters {
  max-width: 1200px;
  margin: 1.5rem 0;
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  align-items: center;
}

.marketplace-filters input {
  padding: 0.7rem 1rem;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 1rem;
  background: var(--card-bg);
  color: var(--text);
  flex: 1;
  min-width: 250px;
}

.marketplace-filters input::placeholder {
  color: var(--text-muted);
}

.marketplace-items {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 2rem;
}

.marketplace-item {
  background: var(--card-bg);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 6px 24px rgba(0,0,0,0.08);
  border: 1px solid var(--border);
  transition: all 0.3s ease;
  cursor: pointer;
}

.marketplace-item:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 32px rgba(0,0,0,0.12);
}

.marketplace-item-image {
  width: 100%;
  height: 220px;
  background: linear-gradient(135deg, var(--brand-blue), var(--brand-orange));
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 3rem;
  overflow: hidden;
}

.marketplace-item-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.marketplace-item-content {
  padding: 1.5rem;
}

.marketplace-item-category {
  color: var(--brand-orange);
  font-size: 0.85rem;
  font-weight: 600;
  text-transform: uppercase;
  margin-bottom: 0.5rem;
}

.marketplace-item-title {
  color: var(--brand-blue);
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.marketplace-item-description {
  color: var(--text);
  font-size: 0.95rem;
  margin-bottom: 1rem;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.marketplace-item-price {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}

.price-tag {
  color: var(--brand-orange);
  font-size: 1.3rem;
  font-weight: 700;
}

.marketplace-item-footer {
  display: flex;
  gap: 0.5rem;
}

.marketplace-item-footer button {
  flex: 1;
  padding: 0.6rem 1rem;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.3s ease;
  font-size: 0.95rem;
}

.btn-view {
  background: var(--brand-blue);
  color: white;
}

.btn-view:hover {
  opacity: 0.9;
}

.btn-contact {
  background: var(--brand-orange);
  color: white;
}

.btn-contact:hover {
  opacity: 0.9;
}

/* Modal styles reused */
.modal {
  display: none;
  position: fixed;
  z-index: 1000;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.4);
  animation: fadeIn 0.3s ease;
}

.modal.active {
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: var(--card-bg);
  padding: 2rem;
  border-radius: 16px;
  width: 90%;
  max-width: 600px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 20px 60px rgba(0,0,0,0.3);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
}

.modal-header h2 {
  color: var(--brand-blue);
  margin: 0;
}

.close-btn {
  background: none;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  color: var(--text-muted);
}

.close-btn:hover {
  color: var(--text);
}

@media (max-width: 768px) {
  .marketplace-items {
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .marketplace-filters {
    flex-direction: column;
  }

  .marketplace-filters input {
    min-width: auto;
  }

  .modal-content {
    width: 95%;
    padding: 1.5rem;
  }
}

  
</style>

  <!-- HEADER -->
  

