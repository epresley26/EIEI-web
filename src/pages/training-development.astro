---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Training & Professional Development - EIEI">
  <style is:global>
    /* PREMIUM MODERN STYLES */
    .service-hero {
      position: relative;
      width: 100%;
      min-height: 45vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 10rem 2rem 5rem;
      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
      color: white;
      text-align: center;
      overflow: hidden;
    }

    .service-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      opacity: 0.5;
      z-index: 1;
    }

    .service-hero-content {
      position: relative;
      z-index: 2;
      max-width: 800px;
      margin: 0 auto;
    }

    .service-hero h1 {
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      font-weight: 900;
      line-height: 1.1;
      margin-bottom: 1.5rem;
      letter-spacing: -1px;
    }

    .service-hero p {
      font-size: 1.25rem;
      font-weight: 400;
      opacity: 0.9;
      line-height: 1.6;
    }

    .main-content {
      background: #f8fafc;
      padding: 5rem 2rem;
      min-height: 50vh;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .breadcrumb {
      margin-bottom: 3rem;
      font-size: 0.95rem;
      color: #64748b;
      font-weight: 500;
    }

    .breadcrumb a {
      color: #2563eb;
      text-decoration: none;
      transition: color 0.3s;
    }

    .breadcrumb a:hover {
      color: #f97316;
    }

    .section-header {
      text-align: center;
      margin-bottom: 4rem;
      margin-top: 4rem;
    }

    .section-header h2 {
      font-size: 2.5rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 1rem;
    }

    .certification-banner {
      background: linear-gradient(90deg, #f97316, #dc2626);
      border-radius: 12px;
      padding: 1.5rem 2rem;
      color: white;
      text-align: center;
      font-weight: 800;
      font-size: 1.2rem;
      box-shadow: 0 10px 30px rgba(249, 115, 22, 0.2);
      margin-bottom: 4rem;
    }

    .knowledge-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      margin: 4rem 0;
    }

    .knowledge-card {
      background: white;
      border-radius: 20px;
      padding: 3rem 2.5rem;
      border: 1px solid #e2e8f0;
      transition: all 0.3s ease;
      position: relative;
    }

    .knowledge-card:hover {
      box-shadow: 0 20px 40px rgba(0,0,0,0.06);
      transform: translateY(-8px);
      border-color: #cbd5e1;
    }

    .knowledge-card h3 {
      font-size: 1.6rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 1.5rem;
      border-bottom: 2px solid #f97316;
      padding-bottom: 1rem;
      display: inline-block;
    }

    .knowledge-prop {
      margin-bottom: 1.2rem;
      font-size: 0.95rem;
      color: #334155;
      line-height: 1.6;
      display: flex;
      flex-direction: column;
    }

    .knowledge-prop strong {
      color: #1e293b;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 0.2rem;
      color: #2563eb;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 2rem;
      margin-bottom: 5rem;
    }

    .service-box {
      background: white;
      border-radius: 16px;
      padding: 2.5rem 2rem;
      box-shadow: 0 4px 20px rgba(0,0,0,0.03);
      border: 1px solid #e2e8f0;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .service-box::before {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 4px; height: 100%;
      background: #2563eb;
      transform: scaleY(0);
      transition: transform 0.3s ease;
      transform-origin: bottom;
    }

    .service-box:hover {
      box-shadow: 0 15px 30px rgba(0,0,0,0.08);
      transform: translateX(5px);
    }

    .service-box:hover::before {
      transform: scaleY(1);
    }

    .service-box h4 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 1rem;
    }

    .service-box p {
      color: #64748b;
      line-height: 1.6;
      font-size: 0.95rem;
      margin: 0;
    }

    .photo-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
      margin: 4rem 0;
    }

    .photo-grid img {
      width: 100%;
      height: 250px;
      object-fit: cover;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      transition: transform 0.3s ease;
    }

    .photo-grid img:hover {
      transform: scale(1.05);
      z-index: 5;
    }

    .cta-banner {
      background: linear-gradient(135deg, #2563eb 0%, #1e3a8a 100%);
      border-radius: 20px;
      padding: 4rem;
      text-align: center;
      color: white;
      margin-top: 5rem;
    }

    .cta-banner h2 {
      font-size: 2.5rem;
      font-weight: 800;
      margin-bottom: 1rem;
    }

    .cta-button {
      display: inline-block;
      background: #f97316;
      color: white;
      padding: 1.2rem 3rem;
      border-radius: 50px;
      font-size: 1.1rem;
      font-weight: 800;
      text-decoration: none;
      margin-top: 2rem;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .cta-button:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(249, 115, 22, 0.3);
      background: #ea580c;
    }

    @media (max-width: 1100px) {
      .knowledge-grid { grid-template-columns: 1fr; }
      .photo-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 768px) {
      .service-hero { padding-top: 8rem; min-height: 40vh; }
      .cta-banner { padding: 3rem 1.5rem; }
      .photo-grid { grid-template-columns: 1fr; }
      .services-grid { grid-template-columns: 1fr; }
    }
  </style>

  <section class="service-hero">
    <div class="service-hero-content">
      <h1>Training & Professional Development</h1>
      <p>Aggressively empowering brilliant educators and leaders to expand their specialized knowledge pipelines.</p>
    </div>
  </section>

  <main class="main-content">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a> / <a href="/services">Services</a> / Professional Development
      </div>

      <div class="certification-banner">
        ✓ Officially PQAS and ACT 48 Approved for Professional Development Certification
      </div>

      <div class="section-header">
        <h2>The 3 Pillars of EIEI Empowerment</h2>
        <p style="color: #64748b; font-size: 1.1rem; max-width: 600px; margin: 0 auto;">Establishing comprehensive frameworks to ensure no operational gaps remain unaddressed.</p>
      </div>

      <div class="knowledge-grid">
        <div class="knowledge-card">
          <h3>1. Training Base</h3>
          <div class="knowledge-prop"><strong>Purpose</strong> Structured fundamentals teaching explicit, required skills instantly.</div>
          <div class="knowledge-prop"><strong>Scope</strong> Accelerated, short-term task-orientation for boarding personnel.</div>
          <div class="knowledge-prop"><strong>Method</strong> Dynamic workshop drills, interactive classes, precise online modules.</div>
          <div class="knowledge-prop"><strong>Why It Matters</strong> Eradicates struggle with core responsibilities permanently and secures zero-failure compliance standards.</div>
        </div>

        <div class="knowledge-card">
          <h3>2. VIP Coaching</h3>
          <div class="knowledge-prop"><strong>Purpose</strong> Intense one-on-one personal advancement through direct, surgical feedback.</div>
          <div class="knowledge-prop"><strong>Scope</strong> Customized behavioral trajectory tracking applied directly to your specific mentality.</div>
          <div class="knowledge-prop"><strong>Method</strong> Live situational guidance and meticulous goal-setting interrogations.</div>
          <div class="knowledge-prop"><strong>Why It Matters</strong> Obliterates cognitive barriers, forcing confidence, extreme communication, and classroom culture modifications rapidly.</div>
        </div>

        <div class="knowledge-card">
          <h3>3. Deep Professional</h3>
          <div class="knowledge-prop"><strong>Purpose</strong> Broad-spectrum, future-proofed institutional advancement strategies.</div>
          <div class="knowledge-prop"><strong>Scope</strong> Massive long-term visionary upscaling for organizational continuity logic.</div>
          <div class="knowledge-prop"><strong>Method</strong> Huge seminars, regional summits, and prolonged high-tier mentorship.</div>
          <div class="knowledge-prop"><strong>Why It Matters</strong> Transforms organizations into elite bastions of forward-thinking early learning innovation ecosystems effortlessly.</div>
        </div>
      </div>

      <div class="section-header">
        <h2>Active Specialized Syllabus</h2>
        <p style="color: #64748b; font-size: 1.1rem; max-width: 600px; margin: 0 auto;">Select from our elite portfolio of advanced tactical learning engagements.</p>
      </div>

      <div class="services-grid">
        <div class="service-box">
          <h4>Problem-Solving Early Intervention Needs</h4>
          <p>Scientific evidence-based strategic deployment matrices designed precisely for dismantling extreme challenges rapidly in special education settings.</p>
        </div>
        <div class="service-box">
          <h4>Early Ed Curriculum Design</h4>
          <p>Holistic structural blueprinting that ensures chronological developmental milestones are seamlessly achieved through play geometry.</p>
        </div>
        <div class="service-box">
          <h4>Definitive K-12 Transmutation</h4>
          <p>Advanced navigational techniques ensuring special-needs toddlers transition with unshakeable confidence smoothly into kindergarten parameters.</p>
        </div>
        <div class="service-box">
          <h4>Aggressive De-escalation Protocol</h4>
          <p>Hard tactical psychological anchoring techniques formulated strictly to calmly isolate and manage heavily volatile early childhood behaviors.</p>
        </div>
        <div class="service-box">
          <h4>Generational Health & Trust Planning</h4>
          <p>A crucial financial intelligence breakdown explaining the vital frameworks protecting special-need family asset security across lifetimes.</p>
        </div>
        <div class="service-box">
          <h4>Inclusive Action Best Practices</h4>
          <p>A high-velocity masterclass summarizing the absolute most optimal modern interventions deployed successfully within neurodivergent environments.</p>
        </div>
      </div>

      <div class="section-header" style="margin-top: 8rem;">
        <h2>The Laboratory of Innovation</h2>
        <p style="color: #64748b; font-size: 1.1rem; max-width: 600px; margin: 0 auto;">Our elite educator squads engaging heavily in continuous action-learning combat.</p>
      </div>

      <div class="photo-grid">
        <img src="/images/training-gallery-1.jpg" alt="Educators analyzing structural intervention tactics" />
        <img src="/images/training-gallery-2.jpg" alt="Team mapping holistic child outcomes" />
        <img src="/images/training-gallery-3.jpg" alt="Live instructional behavioral modifications" />
        <img src="/images/training-gallery-4.jpg" alt="Active professional development graduation" />
      </div>

      <div class="cta-banner">
        <h2>Arm Your Teachers Today</h2>
        <p style="font-size: 1.2rem; opacity: 0.9; max-width: 650px; margin: 0 auto;">Do not let your workforce decay. Demand the ultimate professional development structural training deployed immediately inside your organization.</p>
        <a href="tel:484-501-9101" class="cta-button">Engage Logistics: 484-501-9101</a>
      </div>

    </div>
  </main>
</Layout>
