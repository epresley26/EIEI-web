  <!-- FIREBASE AND JS LOGIC -->
  <script is:inline>
    // FAQ Toggle Logic
    document.querySelectorAll(".faq-question").forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = btn.closest(".faq-item");
        const isActive = item.classList.contains("active");
        // close all
        document.querySelectorAll(".faq-item").forEach((el) => {
          el.classList.remove("active");
        });
        // toggle clicked
        if (!isActive) {
          item.classList.add("active");
        }
      });
    });

    // Enquiry Handler
    async function handleEnquiry(event) {
      event.preventDefault();
      const form = event.target;
      const data = {
        name: document.getElementById("enqName").value.trim(),
        email: document.getElementById("enqEmail").value.trim().toLowerCase(),
        phone: document.getElementById("enqPhone").value.trim(),
        address: document.getElementById("enqAddress").value.trim(),
        childAge: Number(document.getElementById("enqChildAge").value.trim()),
        message: document.getElementById("enqMessage").value.trim(),
        createdAt: new Date().toISOString(),
        source: "index-hero-enquiry",
      };

      if (
        window.firebaseDB &&
        typeof window.firebaseDB.collection === "function"
      ) {
        try {
          const ts =
            window.firebase && window.firebase.firestore
              ? window.firebase.firestore.FieldValue.serverTimestamp()
              : new Date();
          await window.firebaseDB
            .collection("enquiries")
            .add({ ...data, createdAt: ts });
          form.reset();
          alert("Thank you! We'll be in touch soon.");
          return;
        } catch (e) {}
      }

      try {
        const PROJECT_ID = "eiei-e1a76";
        const body = {
          fields: {
            name: { stringValue: data.name },
            email: { stringValue: data.email },
            phone: { stringValue: data.phone },
            address: { stringValue: data.address },
            childAge: { integerValue: String(data.childAge) },
            message: { stringValue: data.message },
            createdAt: { timestampValue: data.createdAt },
            source: { stringValue: data.source },
          },
        };
        const res = await fetch(
          `https://firestore.googleapis.com/v1/projects/${PROJECT_ID}/databases/(default)/documents/enquiries`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          },
        );
        if (!res.ok) throw new Error("REST write failed");
        form.reset();
        alert("Thank you! We'll be in touch soon.");
      } catch (err) {
        alert("Unable to submit enquiry right now. Please try again later.");
      }
    }
  </script>
