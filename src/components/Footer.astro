---
// src/components/Footer.astro
---

<footer>
  <div class="footer-content">
    <!-- Footer Main Content -->
    <div class="footer-main">
      <div class="footer-column">
        <h3>About EIEI</h3>
        <p class="footer-tagline">
          The Education Institute for Early Intervention – Nurturing young minds
          with excellence.
        </p>
        <div class="footer-stats">
          <div class="stat">
            <div class="stat-number">3000+</div>
            <div class="stat-label">Children Served</div>
          </div>
          <div class="stat">
            <div class="stat-number">20+</div>
            <div class="stat-label">Expert Educators</div>
          </div>
          <div class="stat">
            <div class="stat-number">270+</div>
            <div class="stat-label">Programs</div>
          </div>
        </div>
      </div>

      <div class="footer-column">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/#about">About Us</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/nafei">NAFEI</a></li>
          <li><a href="/career-opportunities">Careers</a></li>
          <li><a href="/contact-us">Contact</a></li>
        </ul>
      </div>

      <div class="footer-column">
        <h3>Programs</h3>
        <ul>
          <li><a href="/early-intervention">Early Intervention</a></li>
          <li><a href="/special-education">Special Education</a></li>
          <li><a href="/parent-training">Parent Training</a></li>
          <li><a href="/classroom-support">Classroom Support</a></li>
          <li><a href="/cacfp">CACFP Initiative</a></li>
          <li><a href="/professional-development">Professional Development</a></li>
          <li><a href="/community-outreach">Community Outreach</a></li>
        </ul>
      </div>

      <div class="footer-column newsletter-column" id="newsletterColumn">
        <div id="newsletterInitial">
          <h3>📧 Subscribe for Updates</h3>
          <p class="newsletter-tagline">
            Get the latest news and updates from EIEI!
          </p>
          <form class="newsletter-form" onsubmit="handleLocalNewsletterSignup(event)">
            <div class="newsletter-input-wrapper">
              <input
                type="email"
                placeholder="Your email address"
                required
                class="newsletter-input"
              />
              <button type="submit" class="newsletter-btn">✨ Subscribe</button>
            </div>
            <p class="newsletter-note">We respect your privacy. No spam!</p>
          </form>
        </div>

        <div id="newsletterSuccess" style="display: none;" class="success-state">
          <div class="success-icon">✓</div>
          <h3>You're All Set!</h3>
          <p>Thank you for subscribing to our newsletter. Welcome to the EIEI community!</p>
        </div>
      </div>
    </div>

    <!-- Footer Social & Admin -->
    <div class="footer-bottom">
      <div class="footer-left">
        <p class="policy-stmt">
          Non-Discrimination Policy Admissions, the provisions of services, and 
          referrals of clients shall be made without regard to race, color, 
          religious creed, disability, ancestry, national origin, age, or sex.
        </p>
        <p class="copyright">&copy; 2025 EIEI Services. All rights reserved.</p>
        <div class="footer-links">
          <a href="#" title="Privacy Policy">Privacy Policy</a> |
          <a href="#" title="Terms of Service">Terms of Service</a> |
          <a href="/admin-programs" title="Admin Portal" class="admin-link">Admin Portal</a>
        </div>
      </div>
      <div class="footer-social">
        <h4>Follow Us</h4>
        <div class="social-icons">
          <a
            href="https://www.facebook.com/TheEducationInstituteforEarlyIntervention/"
            title="Facebook"
            class="social-icon"
          >
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
              <path d="M9.101 24v-11.01h-3.688V8.71h3.688V6.141c0-3.652 2.231-5.64 5.484-5.64 1.558 0 2.903.116 3.292.168v3.815h-2.257c-1.774 0-2.117.842-2.117 2.08v2.722h4.221l-.55 4.28H13.62V24H9.101z"/>
            </svg>
          </a>
          <a
            href="https://www.instagram.com/eieiorg/"
            title="Instagram"
            class="social-icon"
          >
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.332 3.608 1.308.975.975 1.245 2.242 1.308 3.607.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.063 1.366-.333 2.633-1.308 3.608-.975.975-2.242 1.245-3.608 1.308-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.366-.063-2.633-.333-3.608-1.308-.975-.975-1.245-2.242-1.308-3.608-.058-1.266-.07-1.646-.07-4.85s.012-3.584.07-4.85c.062-1.366.332-2.633 1.308-3.608.975-.975 2.242-1.245 3.607-1.308 1.266-.058 1.646-.07 4.85-.07zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948s.014 3.667.072 4.947c.2 4.337 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072s3.667-.014 4.947-.072c4.358-.2 6.78-2.618 6.98-6.98.058-1.28.072-1.689.072-4.948s-.014-3.667-.072-4.947c-.2-4.337-2.618-6.78-6.98-6.98-1.28-.058-1.689-.072-4.948-.072zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/company/the-education-institute-for-early-intervention/posts/?feedView=all"
            title="LinkedIn"
            class="social-icon"
          >
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
              <path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.989v-10.141c0-7.88-8.922-7.593-11.02-3.711v-2.148z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    background: radial-gradient(circle at top right, rgba(30, 41, 59, 1) 0%, rgba(15, 23, 42, 1) 100%);
    color: #f8fafc;
    padding: 10rem 2rem 4rem;
    font-family: 'Inter', system-ui, sans-serif;
    position: relative;
    overflow: hidden;
  }

  /* Premium Top Accent */
  footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 6px;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899, #f97316);
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.3);
  }

  .footer-content {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 5;
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 0.8fr 1.4fr;
    gap: 5rem;
    margin-bottom: 8rem;
  }

  .footer-column h3 {
    color: #ffffff;
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 2.5rem;
    letter-spacing: -0.02em;
    position: relative;
  }

  .footer-tagline {
    color: #94a3b8;
    line-height: 1.8;
    margin-bottom: 3rem;
    font-size: 1.1rem;
    max-width: 400px;
  }

  .footer-stats {
    display: flex;
    gap: 3rem;
  }

  .stat-number {
    font-size: 1.75rem;
    font-weight: 900;
    background: linear-gradient(135deg, #60a5fa 0%, #2563eb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.75rem;
    color: #64748b;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .footer-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-column ul li {
    margin-bottom: 1.25rem;
  }

  .footer-column ul li a {
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    font-size: 1.05rem;
    display: inline-flex;
    align-items: center;
    gap: 0;
  }

  .footer-column ul li a:hover {
    color: #ffffff;
    transform: translateX(10px);
    gap: 8px;
  }

  .footer-column ul li a:hover::before {
    content: '→';
    font-weight: 900;
    color: #3b82f6;
  }

  .newsletter-column {
    background: rgba(255, 255, 255, 0.04);
    padding: 3rem;
    border-radius: 32px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    position: relative;
    min-height: 350px; /* Maintain height during transition */
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .success-state {
    text-align: center;
    animation: fadeInScale 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes fadeInScale {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: scale(1); }
  }

  .success-icon {
    width: 60px;
    height: 60px;
    background: #10b981;
    color: white;
    font-size: 2rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.4);
  }

  .success-state h3 {
    color: white;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .success-state p {
    color: #94a3b8;
    line-height: 1.6;
  }

  .newsletter-column::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 32px;
    padding: 1px;
    background: linear-gradient(135deg, rgba(255,255,255,0.1), transparent);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .newsletter-tagline {
    color: #cbd5e1;
    margin-bottom: 2.5rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .newsletter-input-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .newsletter-input {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    padding: 1.2rem 1.5rem;
    color: white;
    font-size: 1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .newsletter-input:focus {
    outline: none;
    background: rgba(15, 23, 42, 1);
    border-color: #3b82f6;
    box-shadow: 0 0 0 5px rgba(59, 130, 246, 0.2);
  }

  .newsletter-btn {
    background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
    color: white;
    border: none;
    border-radius: 16px;
    padding: 1.2rem;
    font-weight: 800;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 10px 20px rgba(37, 99, 235, 0.3);
  }

  .newsletter-btn:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 20px 40px rgba(37, 99, 235, 0.5);
    filter: brightness(1.1);
  }

  .newsletter-note {
    font-size: 0.85rem;
    color: #64748b;
    text-align: center;
    font-weight: 500;
  }

  .footer-bottom {
    padding-top: 5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 6rem;
  }

  .policy-stmt {
    font-size: 0.9rem;
    color: #64748b;
    line-height: 1.8;
    margin-bottom: 2.5rem;
    font-weight: 400;
  }

  .copyright {
    color: #94a3b8;
    font-size: 1rem;
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .footer-links {
    display: flex;
    gap: 2rem;
  }

  .footer-links a {
    color: #64748b;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .footer-links a:hover {
    color: #ffffff;
    text-shadow: 0 0 10px rgba(255,255,255,0.3);
  }

  .admin-link {
    color: #f59e0b !important;
    font-weight: 800 !important;
  }

  .footer-social h4 {
    margin-bottom: 2rem;
    font-size: 1.25rem;
    font-weight: 900;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .social-icons {
    display: flex;
    gap: 1.25rem;
    justify-content: flex-end;
  }

  .social-icon {
    width: 56px;
    height: 56px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0;
  }

  .social-icon svg {
    transition: transform 0.4s ease;
  }

  /* Brand Specific Hovers */
  .social-icon[title="Facebook"]:hover {
    background: #1877F2;
    color: white;
    box-shadow: 0 10px 25px rgba(24, 119, 242, 0.5);
  }
  .social-icon[title="Instagram"]:hover {
    background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    color: white;
    box-shadow: 0 10px 25px rgba(220, 39, 67, 0.5);
  }
  .social-icon[title="LinkedIn"]:hover {
    background: #0077b5;
    color: white;
    box-shadow: 0 10px 25px rgba(0, 119, 181, 0.5);
  }

  .social-icon:hover {
    transform: translateY(-8px) rotate(5deg);
    border-color: transparent;
  }

  @media (max-width: 1400px) {
    .footer-main {
      gap: 3rem;
    }
  }

  @media (max-width: 1100px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  @media (max-width: 768px) {
    footer {
      padding: 6rem 1.5rem 4rem;
    }
    .footer-main {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
    .newsletter-column {
      padding: 2rem;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 4rem;
    }
    .social-icons {
      justify-content: flex-start;
    }
    .footer-social {
      text-align: left;
    }
  }
</style>

<script is:inline>
  async function handleLocalNewsletterSignup(event) {
    event.preventDefault();
    const form = event.target;
    const emailInput = form.querySelector(".newsletter-input");
    const email = emailInput.value.trim();
    const initialView = document.getElementById("newsletterInitial");
    const successView = document.getElementById("newsletterSuccess");

    if (!email) return;

    // Use global Firebase or fallback
    const db = window.firebaseDB;
    const emailNorm = email.toLowerCase();

    try {
      if (db && typeof db.collection === "function") {
        await db.collection("newsletter").doc(emailNorm).set({
          email: emailNorm,
          createdAt: window.firebase?.firestore?.FieldValue?.serverTimestamp() || new Date(),
          source: window.location.pathname
        });
      }

      // Transform UI
      if (initialView && successView) {
        initialView.style.display = "none";
        successView.style.display = "block";
      }
    } catch (err) {
      console.error("Newsletter error:", err);
      alert("Something went wrong. Please try again.");
    }
  }
</script>
